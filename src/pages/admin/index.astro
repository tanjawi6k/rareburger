---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const user = Astro.locals.user;
if (!user?.roles.includes('admin')) return Astro.redirect('/login');

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
---

<AdminLayout title="Dashboard">

  <!-- En-tête -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold">Dashboard</h1>
    <p class="text-base-content/60">Bonjour {user.name} — vue d'ensemble de votre activité</p>
  </div>

  <!-- Loader -->
  <div id="loader" class="flex justify-center items-center py-20">
    <span class="loading loading-spinner loading-lg text-primary"></span>
  </div>

  <!-- Contenu -->
  <div id="dashboardContent" class="hidden">

    <!-- Stats -->
    <div class="stats stats-vertical lg:stats-horizontal shadow w-full mb-6">
      <div class="stat">
        <div class="stat-title">Commandes aujourd'hui</div>
        <div class="stat-value text-primary" id="todayOrders">—</div>
        <div class="stat-desc">Commandes reçues ce jour</div>
      </div>
      <div class="stat">
        <div class="stat-title">En attente</div>
        <div class="stat-value text-warning" id="pendingOrders">—</div>
        <div class="stat-desc">À préparer ou en cours</div>
      </div>
      <div class="stat">
        <div class="stat-title">CA aujourd'hui</div>
        <div class="stat-value text-success" id="todayRevenue">—</div>
        <div class="stat-desc">Chiffre d'affaires du jour</div>
      </div>
      <div class="stat">
        <div class="stat-title">Panier moyen</div>
        <div class="stat-value" id="averageOrder">—</div>
        <div class="stat-desc">Moyenne par commande</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Commandes récentes -->
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body">
          <h2 class="card-title">Commandes récentes</h2>
          <div class="overflow-x-auto">
            <table class="table table-zebra table-sm">
              <thead>
                <tr>
                  <th>Numéro</th>
                  <th>Client</th>
                  <th>Montant</th>
                  <th>Statut</th>
                </tr>
              </thead>
              <tbody id="recentOrdersTable">
                <tr><td colspan="4" class="text-center py-4">
                  <span class="loading loading-spinner loading-sm"></span>
                </td></tr>
              </tbody>
            </table>
          </div>
          <div class="card-actions justify-end mt-2">
            <a href="/admin/commandes" class="btn btn-primary btn-sm">Voir toutes</a>
          </div>
        </div>
      </div>

      <!-- Top produits -->
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body">
          <h2 class="card-title">Top produits</h2>
          <div id="topProductsList" class="space-y-3">
            <div class="flex justify-center py-8">
              <span class="loading loading-spinner loading-md"></span>
            </div>
          </div>
          <div class="card-actions justify-end mt-2">
            <a href="/admin/menu" class="btn btn-primary btn-sm">Gérer le menu</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Actions rapides -->
    <div class="mt-6">
      <h2 class="text-xl font-bold mb-4">Actions rapides</h2>
      <div class="join join-vertical lg:join-horizontal w-full">
        <a href="/admin/commandes" class="btn btn-outline join-item flex-1">Commandes</a>
        <a href="/admin/menu"      class="btn btn-outline join-item flex-1">Menu</a>
        <a href="/admin/config"    class="btn btn-outline join-item flex-1">Configuration</a>
      </div>
    </div>

  </div>

  <!-- Erreur -->
  <div id="errorContent" class="hidden">
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span id="errorMsg">Erreur de chargement</span>
      <button class="btn btn-sm btn-ghost ml-auto" onclick="loadDashboard()">Réessayer</button>
    </div>
  </div>

  <meta name="api-url" content={apiBaseUrl} />

</AdminLayout>

<script>
  // ── Types ─────────────────────────────────────
  interface Stats {
    today_orders:  number;
    pending_orders: number;
    today_revenue: number;
    average_order: number;
    // Nouveau backend : tableau d'objets {nom, quantite}
    top_products: Array<{ nom: string; quantite: number }>;
  }

  interface Commande {
    id: string; numero: string;
    client?: { nom?: string };
    prix_total: number;
    statut: string;
    date_creation: string;
  }

  // ── Helpers ───────────────────────────────────
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(n);

  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }

  function getApiBase(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }

  function getToken(): string {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }

  function authHeaders(): HeadersInit {
    const t = getToken();
    return t ? { 'Authorization': `Bearer ${t}`, 'Content-Type': 'application/json' } : {};
  }

  const STATUS_BADGE: Record<string, string> = {
    nouvelle:       'badge-warning',
    en_preparation: 'badge-info',
    prete:          'badge-success',
    en_livraison:   'badge-primary',
    livree:         'badge-success',
    terminee:       'badge-ghost',
    annulee:        'badge-error',
  };

  const STATUS_LABEL: Record<string, string> = {
    nouvelle:       'Nouvelle',
    en_preparation: 'En préparation',
    prete:          'Prête',
    en_livraison:   'En livraison',
    livree:         'Livrée',
    terminee:       'Terminée',
    annulee:        'Annulée',
  };

  // ── Rendu ─────────────────────────────────────
  function renderStats(stats: Stats) {
    document.getElementById('todayOrders')!.textContent  = String(stats.today_orders  ?? 0);
    document.getElementById('pendingOrders')!.textContent = String(stats.pending_orders ?? 0);
    document.getElementById('todayRevenue')!.textContent  = fmt(stats.today_revenue  ?? 0);
    document.getElementById('averageOrder')!.textContent  = fmt(stats.average_order  ?? 0);
  }

  function renderRecentOrders(commandes: Commande[]) {
    const tbody = document.getElementById('recentOrdersTable')!;
    tbody.innerHTML = '';

    if (!commandes.length) {
      const tr = document.createElement('tr');
      tr.innerHTML = '<td colspan="4" class="text-center text-base-content/50 py-4">Aucune commande récente</td>';
      tbody.appendChild(tr);
      return;
    }

    commandes.forEach(c => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><a href="/admin/commandes?id=${esc(c.id)}" class="link link-primary font-mono text-sm">${esc(c.numero)}</a></td>
        <td class="text-sm">${esc(c.client?.nom ?? 'N/A')}</td>
        <td class="tabular-nums text-sm">${fmt(c.prix_total)}</td>
        <td><span class="badge ${STATUS_BADGE[c.statut] ?? 'badge-ghost'} badge-sm">${esc(STATUS_LABEL[c.statut] ?? c.statut)}</span></td>
      `;
      tbody.appendChild(tr);
    });
  }

  function renderTopProducts(products: Array<{ nom: string; quantite: number }>) {
    const el = document.getElementById('topProductsList')!;
    el.innerHTML = '';

    if (!products.length) {
      el.innerHTML = '<p class="text-center text-base-content/50 py-8">Aucune vente enregistrée</p>';
      return;
    }

    products.forEach((p, i) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-3';
      row.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="badge badge-primary badge-lg font-bold">${i + 1}</div>
          <span class="font-medium text-sm">${esc(p.nom)}</span>
        </div>
        <span class="badge badge-ghost text-sm">${esc(p.quantite)} vendus</span>
      `;
      el.appendChild(row);
    });
  }

  // ── Chargement ────────────────────────────────
  async function loadDashboard() {
    const loader  = document.getElementById('loader')!;
    const content = document.getElementById('dashboardContent')!;
    const errEl   = document.getElementById('errorContent')!;

    loader.classList.remove('hidden');
    content.classList.add('hidden');
    errEl.classList.add('hidden');

    try {
      const API = getApiBase();
      const headers = authHeaders();

      const [statsRes, commandesRes] = await Promise.all([
        fetch(`${API}/stats`,           { headers }),
        fetch(`${API}/commandes?per_page=10`, { headers }),
      ]);

      // Gestion 401 → session expirée
      if (statsRes.status === 401 || commandesRes.status === 401) {
        window.location.href = '/login?expired=1';
        return;
      }

      if (!statsRes.ok)     throw new Error(`Stats: ${statsRes.status}`);
      if (!commandesRes.ok) throw new Error(`Commandes: ${commandesRes.status}`);

      const stats: Stats                      = await statsRes.json();
      const commandesData: { commandes: Commande[] } = await commandesRes.json();

      renderStats(stats);

      // 5 commandes les plus récentes
      const recent = [...(commandesData.commandes ?? [])]
        .sort((a, b) => new Date(b.date_creation).getTime() - new Date(a.date_creation).getTime())
        .slice(0, 5);

      renderRecentOrders(recent);
      renderTopProducts(stats.top_products ?? []);

      loader.classList.add('hidden');
      content.classList.remove('hidden');

    } catch (err: unknown) {
      loader.classList.add('hidden');
      const msg = err instanceof Error ? err.message : 'Erreur inconnue';
      document.getElementById('errorMsg')!.textContent = `Erreur de chargement : ${msg}`;
      errEl.classList.remove('hidden');
    }
  }

  // Exposer pour le bouton "Réessayer"
  (window as any).loadDashboard = loadDashboard;

  // ── Init ──────────────────────────────────────
  document.addEventListener('astro:page-load', () => {
    void loadDashboard();
    // Auto-refresh toutes les 30s
    setInterval(() => void loadDashboard(), 30_000);
  });

  void loadDashboard();
</script>