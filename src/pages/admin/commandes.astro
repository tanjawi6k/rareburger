---
// src/pages/admin/commandes.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const user = Astro.locals.user;
if (!user?.roles.includes('admin')) return Astro.redirect('/login');

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
---

<AdminLayout title="Commandes">

  <div class="mb-6 flex justify-between items-start flex-wrap gap-3">
    <div>
      <h1 class="text-3xl font-bold">Commandes</h1>
      <p class="text-base-content/60">Consultez et gérez toutes vos commandes</p>
    </div>
    <div class="flex items-center gap-2">
      <span id="refreshIndicator" class="text-xs text-base-content/50 hidden">Actualisation…</span>
      <button id="toggleAutoRefresh" class="btn btn-sm btn-ghost gap-1">
        <span id="arIcon">🔄</span>
        <span id="arText" class="text-xs">Auto ON</span>
      </button>
    </div>
  </div>

  <!-- Filtres -->
  <div class="card bg-base-100 shadow-lg mb-5">
    <div class="card-body py-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Statut</span></label>
          <select class="select select-bordered select-sm" id="filterStatus">
            <option value="">Tous</option>
            <option value="nouvelle">Nouvelle</option>
            <option value="en_preparation">En préparation</option>
            <option value="prete">Prête</option>
            <option value="en_livraison">En livraison</option>
            <option value="livree">Livrée</option>
            <option value="terminee">Terminée</option>
            <option value="annulee">Annulée</option>
          </select>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Période</span></label>
          <select class="select select-bordered select-sm" id="filterPeriod">
            <option value="all">Toutes</option>
            <option value="today">Aujourd'hui</option>
            <option value="week">Cette semaine</option>
            <option value="month">Ce mois</option>
          </select>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Paiement</span></label>
          <select class="select select-bordered select-sm" id="filterPayment">
            <option value="">Tous</option>
            <option value="en_ligne">En ligne</option>
            <option value="comptoir">Au comptoir</option>
            <option value="reception">À la réception</option>
          </select>
        </div>
        <div class="form-control">
          <label class="label py-1"><span class="label-text text-xs">Tri</span></label>
          <select class="select select-bordered select-sm" id="filterSort">
            <option value="recent">Plus récent</option>
            <option value="oldest">Plus ancien</option>
          </select>
        </div>
      </div>
      <div class="flex justify-between items-center mt-3">
        <p class="text-xs text-base-content/50"><span id="totalCount">0</span> commande(s)</p>
        <button class="btn btn-ghost btn-xs" id="resetFilters">Réinitialiser</button>
      </div>
    </div>
  </div>

  <!-- Actions groupées -->
  <div id="bulkActions" class="card bg-base-100 shadow-lg mb-5 hidden">
    <div class="card-body py-3">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm font-bold"><span id="selectedCount">0</span> sélectionnée(s)</span>
        <div class="divider divider-horizontal mx-0"></div>
        <button class="btn btn-sm btn-outline gap-1" id="exportCSV">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          CSV
        </button>
        <button class="btn btn-sm btn-error gap-1" id="deleteSelected">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Supprimer
        </button>
      </div>
    </div>
  </div>

  <!-- Loader -->
  <div id="loader" class="flex justify-center py-20">
    <span class="loading loading-spinner loading-lg text-primary"></span>
  </div>

  <!-- Tableau -->
  <div id="tableContainer" class="card bg-base-100 shadow-lg hidden">
    <div class="card-body p-0 overflow-x-auto">
      <table class="table table-zebra table-sm">
        <thead>
          <tr>
            <th><input type="checkbox" class="checkbox checkbox-sm" id="selectAll" /></th>
            <th>Numéro</th>
            <th>Date</th>
            <th>Client</th>
            <th>Type</th>
            <th>Montant</th>
            <th>Paiement</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="commandesTable"></tbody>
      </table>
    </div>
  </div>

  <!-- Vide -->
  <div id="emptyState" class="hidden text-center py-20">
    <span class="text-6xl" aria-hidden="true">📦</span>
    <h3 class="text-xl font-bold mt-3 mb-1">Aucune commande</h3>
    <p class="text-base-content/60 text-sm">Aucune commande ne correspond aux filtres</p>
  </div>

  <!-- Toast -->
  <div id="toast-container" class="toast toast-top toast-end z-50" aria-live="polite"></div>

  <!-- Modal confirmation suppression -->
  <dialog id="confirmDeleteModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <h3 class="font-bold text-lg">Confirmer la suppression</h3>
      <p class="py-3 text-sm text-base-content/70" id="confirmDeleteMsg"></p>
      <div class="modal-action">
        <form method="dialog"><button class="btn btn-ghost btn-sm">Annuler</button></form>
        <button id="confirmDeleteYes" class="btn btn-error btn-sm">Supprimer</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <meta name="api-url" content={apiBaseUrl} />
</AdminLayout>

<script>
  // ── Types ─────────────────────────────────────
  interface Commande {
    id: string; numero: string; date_creation: string;
    statut: string; type?: string; prix_total: number;
    client?: { nom?: string; prenom?: string };
    paiement?: { mode?: string };
  }

  // ── État ──────────────────────────────────────
  let allCommandes: Commande[] = [];
  let filtered: Commande[]    = [];
  let selectedIds              = new Set<string>();
  let autoRefreshEnabled       = true;
  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let pendingDeleteIds: string[] = [];

  // ── Helpers ───────────────────────────────────
  function getApiBase(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }

  function getToken(): string {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }

  function authHeaders(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}`, 'Content-Type': 'application/json' };
  }

  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }

  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(n);

  function fmtDate(s: string): string {
    try {
      return new Intl.DateTimeFormat('fr-BE', {
        day:'2-digit', month:'2-digit', year:'numeric',
        hour:'2-digit', minute:'2-digit',
      }).format(new Date(s));
    } catch { return s; }
  }

  function showToast(msg: string, type: 'success'|'error'|'info'|'warning' = 'info') {
    const c = document.getElementById('toast-container')!;
    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow-md text-sm py-2 px-4 rounded-xl`;
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  const STATUS_BADGE: Record<string,string> = {
    nouvelle:'badge-warning', en_preparation:'badge-info', prete:'badge-success',
    en_livraison:'badge-primary', livree:'badge-success', terminee:'badge-ghost', annulee:'badge-error',
  };
  const STATUS_LABEL: Record<string,string> = {
    nouvelle:'Nouvelle', en_preparation:'En préparation', prete:'Prête',
    en_livraison:'En livraison', livree:'Livrée', terminee:'Terminée', annulee:'Annulée',
  };

  // ── Chargement ────────────────────────────────
  async function loadCommandes(silent = false) {
    if (!silent) {
      document.getElementById('loader')!.classList.remove('hidden');
      document.getElementById('tableContainer')!.classList.add('hidden');
      document.getElementById('emptyState')!.classList.add('hidden');
    }

    try {
      const res = await fetch(`${getApiBase()}/commandes?per_page=200`, { headers: authHeaders() });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json() as { commandes: Commande[] };
      allCommandes = data.commandes ?? [];
      applyFilters();
    } catch (err: unknown) {
      if (!silent) {
        document.getElementById('loader')!.innerHTML = `
          <div class="alert alert-error max-w-md">
            <span>Erreur : ${esc(err instanceof Error ? err.message : String(err))}</span>
            <button class="btn btn-sm btn-ghost ml-2" onclick="loadCommandes()">Réessayer</button>
          </div>`;
      }
    }
  }

  (window as any).loadCommandes = loadCommandes;

  // ── Filtrage ──────────────────────────────────
  function applyFilters() {
    const status  = (document.getElementById('filterStatus')  as HTMLSelectElement).value;
    const period  = (document.getElementById('filterPeriod')  as HTMLSelectElement).value;
    const payment = (document.getElementById('filterPayment') as HTMLSelectElement).value;
    const sort    = (document.getElementById('filterSort')    as HTMLSelectElement).value;

    const now = new Date();

    filtered = allCommandes.filter(c => {
      if (status  && c.statut          !== status)  return false;
      if (payment && c.paiement?.mode  !== payment) return false;
      if (period !== 'all') {
        const d = new Date(c.date_creation);
        if (period === 'today' && d.toDateString() !== now.toDateString()) return false;
        if (period === 'week'  && d < new Date(now.getTime() - 7*86400000)) return false;
        if (period === 'month' && (d.getMonth() !== now.getMonth() || d.getFullYear() !== now.getFullYear())) return false;
      }
      return true;
    });

    filtered.sort((a, b) => {
      const diff = new Date(b.date_creation).getTime() - new Date(a.date_creation).getTime();
      return sort === 'oldest' ? -diff : diff;
    });

    renderTable();
  }

  // ── Rendu tableau ─────────────────────────────
  function renderTable() {
    const tbody         = document.getElementById('commandesTable')!;
    const loader        = document.getElementById('loader')!;
    const tableEl       = document.getElementById('tableContainer')!;
    const emptyEl       = document.getElementById('emptyState')!;

    document.getElementById('totalCount')!.textContent = String(filtered.length);
    loader.classList.add('hidden');

    if (!filtered.length) {
      tableEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    tableEl.classList.remove('hidden');
    tbody.innerHTML = '';

    filtered.forEach(cmd => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input type="checkbox" class="checkbox checkbox-sm cmd-cb" data-id="${esc(cmd.id)}"
          ${selectedIds.has(cmd.id) ? 'checked' : ''} /></td>
        <td><span class="font-mono font-bold text-sm">${esc(cmd.numero)}</span></td>
        <td class="text-xs text-base-content/70">${fmtDate(cmd.date_creation)}</td>
        <td class="text-sm">${esc(cmd.client?.prenom ?? '')} ${esc(cmd.client?.nom ?? 'N/A')}</td>
        <td><span class="badge badge-ghost badge-sm">${esc(cmd.type ?? '?')}</span></td>
        <td class="font-bold tabular-nums text-sm">${fmt(cmd.prix_total)}</td>
        <td class="text-xs text-base-content/60">${esc(cmd.paiement?.mode ?? '—')}</td>
        <td><span class="badge ${STATUS_BADGE[cmd.statut] ?? 'badge-ghost'} badge-sm">
          ${esc(STATUS_LABEL[cmd.statut] ?? cmd.statut)}</span></td>
        <td>
          <div class="flex gap-1">
            <button class="btn btn-xs btn-ghost edit-btn" data-id="${esc(cmd.id)}" aria-label="Modifier">✏️</button>
            <button class="btn btn-xs btn-ghost text-error del-btn" data-id="${esc(cmd.id)}"
              data-num="${esc(cmd.numero)}" aria-label="Supprimer">🗑️</button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Checkboxes
    tbody.querySelectorAll<HTMLInputElement>('.cmd-cb').forEach(cb => {
      cb.addEventListener('change', () => {
        cb.checked ? selectedIds.add(cb.dataset.id!) : selectedIds.delete(cb.dataset.id!);
        updateBulk();
      });
    });

    // Edit → page détail
    tbody.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        window.location.href = `/admin/commandes/edit?id=${encodeURIComponent(btn.dataset.id!)}`;
      });
    });

    // Delete → modal de confirmation
    tbody.querySelectorAll<HTMLButtonElement>('.del-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        pendingDeleteIds = [btn.dataset.id!];
        document.getElementById('confirmDeleteMsg')!.textContent =
          `Supprimer la commande ${btn.dataset.num} ?`;
        (document.getElementById('confirmDeleteModal') as HTMLDialogElement).showModal();
      });
    });
  }

  // ── Select all ────────────────────────────────
  document.getElementById('selectAll')?.addEventListener('change', (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    document.querySelectorAll<HTMLInputElement>('.cmd-cb').forEach(cb => {
      cb.checked = checked;
      checked ? selectedIds.add(cb.dataset.id!) : selectedIds.delete(cb.dataset.id!);
    });
    updateBulk();
  });

  function updateBulk() {
    document.getElementById('selectedCount')!.textContent = String(selectedIds.size);
    document.getElementById('bulkActions')!.classList.toggle('hidden', selectedIds.size === 0);
  }

  // ── Suppression ───────────────────────────────
  document.getElementById('confirmDeleteYes')?.addEventListener('click', async () => {
    (document.getElementById('confirmDeleteModal') as HTMLDialogElement).close();
    for (const id of pendingDeleteIds) await doDelete(id);
    pendingDeleteIds = [];
    selectedIds.clear();
    updateBulk();
    await loadCommandes(true);
  });

  async function doDelete(id: string) {
    try {
      const res = await fetch(`${getApiBase()}/commandes/${encodeURIComponent(id)}`, {
        method: 'DELETE', headers: authHeaders(),
      });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      showToast('Commande supprimée', 'success');
    } catch (err: unknown) {
      showToast(`Erreur suppression : ${err instanceof Error ? err.message : ''}`, 'error');
    }
  }

  // ── Suppression groupée ───────────────────────
  document.getElementById('deleteSelected')?.addEventListener('click', () => {
    if (!selectedIds.size) return;
    pendingDeleteIds = [...selectedIds];
    document.getElementById('confirmDeleteMsg')!.textContent =
      `Supprimer ${selectedIds.size} commande(s) ?`;
    (document.getElementById('confirmDeleteModal') as HTMLDialogElement).showModal();
  });

  // ── Export CSV ────────────────────────────────
  document.getElementById('exportCSV')?.addEventListener('click', () => {
    const rows = filtered.filter(c => selectedIds.has(c.id));
    if (!rows.length) { showToast('Aucune commande sélectionnée', 'warning'); return; }

    const headers = ['Numéro','Date','Client','Type','Montant','Statut','Paiement'];
    const lines   = rows.map(c => [
      c.numero,
      c.date_creation,
      `${c.client?.prenom ?? ''} ${c.client?.nom ?? ''}`.trim(),
      c.type ?? '',
      c.prix_total,
      c.statut,
      c.paiement?.mode ?? '',
    ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(','));

    const csv  = [headers.join(','), ...lines].join('\n');
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = `commandes_${Date.now()}.csv`;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
  });

  // ── Filtres ───────────────────────────────────
  ['filterStatus','filterPeriod','filterPayment','filterSort'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });

  document.getElementById('resetFilters')?.addEventListener('click', () => {
    (document.getElementById('filterStatus')  as HTMLSelectElement).value = '';
    (document.getElementById('filterPeriod')  as HTMLSelectElement).value = 'all';
    (document.getElementById('filterPayment') as HTMLSelectElement).value = '';
    (document.getElementById('filterSort')    as HTMLSelectElement).value = 'recent';
    applyFilters();
  });

  // ── Auto-refresh ──────────────────────────────
  function startPoll() {
    stopPoll();
    pollTimer = setInterval(async () => {
      const ind = document.getElementById('refreshIndicator')!;
      ind.classList.remove('hidden');
      await loadCommandes(true);
      setTimeout(() => ind.classList.add('hidden'), 800);
    }, 10_000);
  }

  function stopPoll() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  }

  document.getElementById('toggleAutoRefresh')?.addEventListener('click', () => {
    autoRefreshEnabled = !autoRefreshEnabled;
    const icon = document.getElementById('arIcon')!;
    const text = document.getElementById('arText')!;
    const btn  = document.getElementById('toggleAutoRefresh')!;
    if (autoRefreshEnabled) {
      startPoll();
      icon.textContent = '🔄'; text.textContent = 'Auto ON';
      btn.classList.replace('btn-error', 'btn-ghost');
    } else {
      stopPoll();
      icon.textContent = '⏸️'; text.textContent = 'Auto OFF';
      btn.classList.replace('btn-ghost', 'btn-error');
    }
  });

  // ── Init ──────────────────────────────────────
  function init() {
    stopPoll();
    void loadCommandes();
    if (autoRefreshEnabled) startPoll();
  }

  document.addEventListener('astro:page-load', init);
  window.addEventListener('beforeunload', stopPoll);
  init();
</script>