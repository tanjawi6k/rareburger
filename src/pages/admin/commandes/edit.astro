---
// src/pages/admin/commandes/edit.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
export const prerender = false;

const user = Astro.locals.user;
if (!user?.roles.includes('admin')) return Astro.redirect('/login');

const commandeId = Astro.url.searchParams.get('id');
if (!commandeId) return Astro.redirect('/admin/commandes');

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'https://api.rareburger.be/api';
---

<AdminLayout title="Modifier commande">

  <div class="mb-6 flex items-center gap-4">
    <a href="/admin/commandes" class="btn btn-ghost btn-sm gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Retour
    </a>
    <div>
      <h1 class="text-2xl font-bold">Modifier la commande</h1>
      <p class="text-base-content/60 text-sm font-mono" id="commandeNumero">…</p>
    </div>
  </div>

  <!-- Loader -->
  <div id="loader" class="flex justify-center py-20">
    <span class="loading loading-spinner loading-lg text-primary"></span>
  </div>

  <!-- Erreur -->
  <div id="errorState" class="hidden">
    <div class="alert alert-error">
      <span>Commande introuvable ou erreur de chargement.</span>
      <a href="/admin/commandes" class="btn btn-sm btn-ghost ml-auto">Retour</a>
    </div>
  </div>

  <!-- Formulaire -->
  <div id="editForm" class="hidden">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

      <!-- Colonne principale -->
      <div class="lg:col-span-2 space-y-5">

        <!-- Client -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <h2 class="card-title text-base">Client</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label" for="clientNom"><span class="label-text">Nom</span></label>
                <input id="clientNom" type="text" class="input input-bordered" autocomplete="off" />
              </div>
              <div class="form-control">
                <label class="label" for="clientPrenom"><span class="label-text">Prénom</span></label>
                <input id="clientPrenom" type="text" class="input input-bordered" autocomplete="off" />
              </div>
              <div class="form-control">
                <label class="label" for="clientEmail"><span class="label-text">Email</span></label>
                <input id="clientEmail" type="email" class="input input-bordered" autocomplete="off" />
              </div>
              <div class="form-control">
                <label class="label" for="clientTel"><span class="label-text">Téléphone</span></label>
                <input id="clientTel" type="tel" class="input input-bordered" autocomplete="off" />
              </div>
            </div>

            <!-- Adresse livraison -->
            <div id="adresseSection" class="hidden mt-2">
              <div class="divider text-xs">Adresse de livraison</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-control sm:col-span-2">
                  <label class="label" for="aRue"><span class="label-text">Rue</span></label>
                  <input id="aRue" type="text" class="input input-bordered" />
                </div>
                <div class="form-control">
                  <label class="label" for="aNum"><span class="label-text">Numéro</span></label>
                  <input id="aNum" type="text" class="input input-bordered" />
                </div>
                <div class="form-control">
                  <label class="label" for="aCp"><span class="label-text">Code postal</span></label>
                  <input id="aCp" type="text" class="input input-bordered" />
                </div>
                <div class="form-control sm:col-span-2">
                  <label class="label" for="aVille"><span class="label-text">Ville</span></label>
                  <input id="aVille" type="text" class="input input-bordered" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Articles -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <h2 class="card-title text-base">Articles</h2>
            <div class="overflow-x-auto">
              <table class="table table-sm table-zebra">
                <thead>
                  <tr>
                    <th>Produit</th>
                    <th class="text-center">Qté</th>
                    <th class="text-right">Unitaire</th>
                    <th class="text-right">Total</th>
                  </tr>
                </thead>
                <tbody id="articlesTable"></tbody>
              </table>
            </div>
            <div class="flex justify-end mt-3">
              <div class="space-y-1 text-sm text-right">
                <div class="flex justify-between gap-6">
                  <span class="text-base-content/60">Sous-total</span>
                  <span class="font-semibold" id="sousTotal">—</span>
                </div>
                <div id="fraisRow" class="hidden flex justify-between gap-6">
                  <span class="text-base-content/60">Livraison</span>
                  <span class="font-semibold" id="fraisLivraison">—</span>
                </div>
                <div class="flex justify-between gap-6 text-base font-bold border-t border-base-300 pt-1 mt-1">
                  <span>Total</span>
                  <span class="text-primary" id="prixTotal">—</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Notes -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <h2 class="card-title text-base">Notes</h2>
            <textarea id="notes" class="textarea textarea-bordered h-20"
              placeholder="Instructions spéciales…"></textarea>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-5">

        <!-- Statut + infos -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body gap-3">
            <h2 class="card-title text-base">Statut</h2>
            <select id="statut" class="select select-bordered">
              <option value="nouvelle">Nouvelle</option>
              <option value="en_preparation">En préparation</option>
              <option value="prete">Prête</option>
              <option value="en_livraison">En livraison</option>
              <option value="livree">Livrée</option>
              <option value="terminee">Terminée</option>
              <option value="annulee">Annulée</option>
            </select>
            <div class="divider my-0"></div>
            <dl class="space-y-1 text-sm">
              <div class="flex justify-between">
                <dt class="text-base-content/60">Numéro</dt>
                <dd class="font-mono font-bold" id="numeroCommande">—</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-base-content/60">Type</dt>
                <dd class="font-semibold" id="typeCommande">—</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-base-content/60">Date</dt>
                <dd class="font-semibold" id="dateCreation">—</dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Paiement -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body gap-3">
            <h2 class="card-title text-base">Paiement</h2>
            <div class="form-control">
              <label class="label" for="paiementMode"><span class="label-text text-xs">Mode</span></label>
              <select id="paiementMode" class="select select-bordered select-sm">
                <option value="reception">À la réception</option>
                <option value="comptoir">Au comptoir</option>
                <option value="en_ligne">En ligne</option>
              </select>
            </div>
            <div class="form-control">
              <label class="label" for="paiementStatut"><span class="label-text text-xs">Statut</span></label>
              <select id="paiementStatut" class="select select-bordered select-sm">
                <option value="a_reception">À la réception</option>
                <option value="en_attente">En attente</option>
                <option value="en_attente_paiement">En attente paiement</option>
                <option value="paye">Payé</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body gap-2">
            <button class="btn btn-primary btn-block" id="saveBtn">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span id="saveBtnText">Enregistrer</span>
              <span id="saveBtnLoader" class="loading loading-spinner loading-sm hidden"></span>
            </button>
            <button class="btn btn-ghost btn-block" id="printBtn">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
              </svg>
              Imprimer le ticket
            </button>
            <div class="divider my-0"></div>
            <button class="btn btn-error btn-outline btn-block btn-sm" id="deleteBtn">
              Supprimer la commande
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast-container" class="toast toast-top toast-end z-50" aria-live="polite"></div>

  <!-- Modal confirmation suppression -->
  <dialog id="confirmDelModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <h3 class="font-bold text-lg">Supprimer la commande ?</h3>
      <p class="py-3 text-sm text-base-content/70">Cette action est irréversible.</p>
      <div class="modal-action">
        <form method="dialog"><button class="btn btn-ghost btn-sm">Annuler</button></form>
        <button class="btn btn-error btn-sm" id="confirmDelYes">Supprimer</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <meta name="api-url" content={apiBaseUrl} />
  <meta name="commande-id" content={commandeId} />
</AdminLayout>

<script>
  // ── Types ─────────────────────────────────────
  interface Article {
    nom: string; prix: number; quantite: number;
    supplements?: { name: string }[];
    removed_ingredients?: string[];
    choices_selected?: { option_name: string }[];
  }
  interface Commande {
    id: string; numero: string; statut: string; type: string;
    date_creation: string; notes?: string; sous_total: number;
    prix_total: number; frais_livraison?: number;
    client?: {
      nom?: string; prenom?: string; email?: string; telephone?: string;
      adresse?: { rue?: string; numero?: string; code_postal?: string; ville?: string; };
    };
    articles: Article[];
    paiement?: { mode?: string; statut?: string; };
  }

  // ── Helpers ───────────────────────────────────
  function getApiBase() {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'https://api.rareburger.be/api';
  }
  function getCommandeId() {
    return document.querySelector<HTMLMetaElement>('meta[name="commande-id"]')?.content ?? '';
  }
  function getToken() {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }
  function authH(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}`, 'Content-Type': 'application/json' };
  }
  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style:'currency', currency:'EUR' }).format(n);
  function fmtDate(s: string) {
    try {
      return new Intl.DateTimeFormat('fr-BE', {
        day:'2-digit', month:'2-digit', year:'numeric',
        hour:'2-digit', minute:'2-digit',
      }).format(new Date(s));
    } catch { return s; }
  }
  function showToast(msg: string, type: 'success'|'error'|'info'|'warning' = 'info') {
    const c = document.getElementById('toast-container')!;
    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow-md text-sm py-2 px-4 rounded-xl`;
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }
  function q<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }

  // ── État ──────────────────────────────────────
  let commande: Commande | null = null;

  // ── Chargement ────────────────────────────────
  async function loadCommande() {
    const id = getCommandeId();
    try {
      const res = await fetch(`${getApiBase()}/commandes/${encodeURIComponent(id)}`, {
        headers: authH(),
      });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      commande = await res.json() as Commande;
      populateForm();
      q('loader').classList.add('hidden');
      q('editForm').classList.remove('hidden');
    } catch {
      q('loader').classList.add('hidden');
      q('errorState').classList.remove('hidden');
    }
  }

  // ── Remplissage formulaire ─────────────────────
  function populateForm() {
    if (!commande) return;
    const c = commande;

    q('commandeNumero').textContent = `Commande ${c.numero}`;
    q('numeroCommande').textContent  = c.numero;
    q('dateCreation').textContent    = fmtDate(c.date_creation);
    q('typeCommande').textContent    = c.type ?? '—';

    (q<HTMLInputElement>('clientNom')).value     = c.client?.nom      ?? '';
    (q<HTMLInputElement>('clientPrenom')).value  = c.client?.prenom   ?? '';
    (q<HTMLInputElement>('clientEmail')).value   = c.client?.email    ?? '';
    (q<HTMLInputElement>('clientTel')).value     = c.client?.telephone ?? '';

    if (c.type === 'livraison' && c.client?.adresse) {
      q('adresseSection').classList.remove('hidden');
      (q<HTMLInputElement>('aRue')).value   = c.client.adresse.rue          ?? '';
      (q<HTMLInputElement>('aNum')).value   = c.client.adresse.numero       ?? '';
      (q<HTMLInputElement>('aCp')).value    = c.client.adresse.code_postal  ?? '';
      (q<HTMLInputElement>('aVille')).value = c.client.adresse.ville        ?? '';
    }

    // Articles — DOM propre
    const tbody = q('articlesTable');
    tbody.innerHTML = '';
    c.articles.forEach(art => {
      const tr = document.createElement('tr');

      const details: string[] = [];
      art.choices_selected?.forEach(ch => details.push(`• ${ch.option_name}`));
      art.supplements?.forEach(s  => details.push(`+ ${s.name}`));
      if (art.removed_ingredients?.length) {
        details.push(`Sans : ${art.removed_ingredients.join(', ')}`);
      }

      tr.innerHTML = `
        <td>
          <p class="font-semibold text-sm">${esc(art.nom)}</p>
          ${details.length ? `<p class="text-xs text-base-content/50">${details.map(esc).join(' ')}</p>` : ''}
        </td>
        <td class="text-center tabular-nums">${art.quantite}</td>
        <td class="text-right tabular-nums">${fmt(art.prix)}</td>
        <td class="text-right tabular-nums font-semibold">${fmt(art.prix * art.quantite)}</td>
      `;
      tbody.appendChild(tr);
    });

    q('sousTotal').textContent   = fmt(c.sous_total ?? 0);
    q('prixTotal').textContent   = fmt(c.prix_total ?? 0);

    if (c.frais_livraison && c.frais_livraison > 0) {
      q('fraisRow').classList.remove('hidden');
      q('fraisLivraison').textContent = fmt(c.frais_livraison);
    }

    (q<HTMLSelectElement>('statut')).value         = c.statut;
    (q<HTMLTextAreaElement>('notes')).value        = c.notes ?? '';
    (q<HTMLSelectElement>('paiementMode')).value   = c.paiement?.mode   ?? 'reception';
    (q<HTMLSelectElement>('paiementStatut')).value = c.paiement?.statut ?? 'a_reception';
  }

  // ── Sauvegarde ────────────────────────────────
  async function saveCommande() {
    if (!commande) return;
    const id  = getCommandeId();
    const btn = q<HTMLButtonElement>('saveBtn');
    btn.disabled = true;
    q('saveBtnText').classList.add('hidden');
    q('saveBtnLoader').classList.remove('hidden');

    const updated: Commande = {
      ...commande,
      statut: (q<HTMLSelectElement>('statut')).value,
      notes:  (q<HTMLTextAreaElement>('notes')).value,
      paiement: {
        mode:   (q<HTMLSelectElement>('paiementMode')).value,
        statut: (q<HTMLSelectElement>('paiementStatut')).value,
      },
      client: {
        ...commande.client,
        nom:       (q<HTMLInputElement>('clientNom')).value,
        prenom:    (q<HTMLInputElement>('clientPrenom')).value,
        email:     (q<HTMLInputElement>('clientEmail')).value,
        telephone: (q<HTMLInputElement>('clientTel')).value,
      },
    };

    if (commande.type === 'livraison') {
      updated.client = {
        ...updated.client,
        adresse: {
          rue:         (q<HTMLInputElement>('aRue')).value,
          numero:      (q<HTMLInputElement>('aNum')).value,
          code_postal: (q<HTMLInputElement>('aCp')).value,
          ville:       (q<HTMLInputElement>('aVille')).value,
        },
      };
    }

    try {
      const res = await fetch(`${getApiBase()}/commandes/${encodeURIComponent(id)}`, {
        method: 'PUT',
        headers: authH(),
        body: JSON.stringify(updated),
      });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) {
        const b = await res.json().catch(() => ({}));
        throw new Error((b as any).error ?? `HTTP ${res.status}`);
      }
      showToast('Commande mise à jour', 'success');
      setTimeout(() => { window.location.href = '/admin/commandes'; }, 1000);
    } catch (err: unknown) {
      showToast(`Erreur : ${err instanceof Error ? err.message : String(err)}`, 'error');
    } finally {
      btn.disabled = false;
      q('saveBtnText').classList.remove('hidden');
      q('saveBtnLoader').classList.add('hidden');
    }
  }

  // ── Suppression ───────────────────────────────
  q('deleteBtn').addEventListener('click', () => {
    (q('confirmDelModal') as HTMLDialogElement).showModal();
  });

  q('confirmDelYes').addEventListener('click', async () => {
    (q('confirmDelModal') as HTMLDialogElement).close();
    const id = getCommandeId();
    try {
      const res = await fetch(`${getApiBase()}/commandes/${encodeURIComponent(id)}`, {
        method: 'DELETE', headers: authH(),
      });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      showToast('Commande supprimée', 'success');
      setTimeout(() => { window.location.href = '/admin/commandes'; }, 1000);
    } catch (err: unknown) {
      showToast(`Erreur suppression : ${err instanceof Error ? err.message : String(err)}`, 'error');
    }
  });

  // ── Impression ────────────────────────────────
  q('printBtn').addEventListener('click', async () => {
    const btn = q<HTMLButtonElement>('printBtn');
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.textContent = 'Impression…';

    try {
      const id = getCommandeId();
      const res = await fetch(`${getApiBase()}/print-ticket`, {
        method: 'POST',
        headers: authH(),
        body: JSON.stringify({ commande_id: id }),
      });
      if (res.status === 401) { window.location.href = '/login?expired=1'; return; }
      if (!res.ok) {
        const b = await res.json().catch(() => ({}));
        throw new Error((b as any).error ?? `HTTP ${res.status}`);
      }
      showToast('Ticket envoyé à l\'imprimante', 'success');
    } catch (err: unknown) {
      showToast(`Impression impossible : ${err instanceof Error ? err.message : String(err)}`, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  });

  // ── Save ──────────────────────────────────────
  q('saveBtn').addEventListener('click', () => void saveCommande());

  // ── Init ──────────────────────────────────────
  document.addEventListener('astro:page-load', () => void loadCommande());
  void loadCommande();
</script>