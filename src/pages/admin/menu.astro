---
// src/pages/admin/menu.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const user = Astro.locals.user;
if (!user?.roles.includes('admin')) return Astro.redirect('/login');

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
---

<AdminLayout title="Menu">

  <!-- En-tête -->
  <div class="mb-6 flex justify-between items-start flex-wrap gap-3">
    <div>
      <h1 class="text-3xl font-bold">Menu</h1>
      <p class="text-base-content/60">Produits, catégories et suppléments</p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <button class="btn btn-ghost btn-sm" id="btnManageCats">Catégories</button>
      <button class="btn btn-ghost btn-sm" id="btnManageSupps">Suppléments</button>
      <button class="btn btn-primary btn-sm" id="btnAddProduct">+ Produit</button>
    </div>
  </div>

  <!-- Loader -->
  <div id="loader" class="flex justify-center py-20">
    <span class="loading loading-spinner loading-lg text-primary"></span>
  </div>

  <!-- Filtres catégories -->
  <div id="catFiltersWrap" class="flex gap-2 mb-5 overflow-x-auto pb-1 hidden">
    <button class="btn btn-sm btn-primary" data-cat="" id="filterAll">Tous</button>
    <div id="catFilterBtns" class="flex gap-2"></div>
  </div>

  <!-- Grille produits -->
  <div id="produitsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>

  <!-- Vide -->
  <div id="emptyProducts" class="hidden text-center py-16">
    <span class="text-6xl" aria-hidden="true">🍽️</span>
    <h3 class="text-xl font-bold mt-3 mb-1">Aucun produit</h3>
    <p class="text-base-content/60 text-sm">Ajoutez votre premier produit</p>
  </div>

  <!-- Toast -->
  <div id="toast-container" class="toast toast-top toast-end z-50" aria-live="polite"></div>

  <!-- ── Modal Produit ─────────────────────────── -->
  <dialog id="productModal" class="modal">
    <div class="modal-box max-w-3xl">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fermer">✕</button>
      </form>
      <h3 class="font-bold text-lg mb-5" id="productModalTitle">Ajouter un produit</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-control md:col-span-2">
          <label class="label" for="prodNom"><span class="label-text">Nom *</span></label>
          <input id="prodNom" type="text" class="input input-bordered" required />
        </div>
        <div class="form-control md:col-span-2">
          <label class="label" for="prodDesc"><span class="label-text">Description</span></label>
          <textarea id="prodDesc" class="textarea textarea-bordered h-20"></textarea>
        </div>
        <div class="form-control">
          <label class="label" for="prodPrix"><span class="label-text">Prix (€) *</span></label>
          <input id="prodPrix" type="number" step="0.01" min="0" class="input input-bordered" />
        </div>
        <div class="form-control">
          <label class="label" for="prodCat"><span class="label-text">Catégorie</span></label>
          <select id="prodCat" class="select select-bordered"></select>
        </div>
        <div class="form-control md:col-span-2">
          <label class="label" for="prodImages"><span class="label-text">Images</span></label>
          <input id="prodImages" type="file" class="file-input file-input-bordered" accept="image/*" multiple />
          <div id="imagePreview" class="flex gap-2 mt-2 flex-wrap"></div>
        </div>
        <div class="form-control md:col-span-2">
          <label class="label"><span class="label-text">Suppléments</span></label>
          <div id="suppCheckboxes" class="flex flex-wrap gap-2"></div>
        </div>
        <div class="form-control md:col-span-2">
          <label class="label" for="prodRemovable"><span class="label-text">Ingrédients retirables (virgule)</span></label>
          <input id="prodRemovable" type="text" class="input input-bordered" placeholder="salade, tomate, oignon" />
        </div>
        <div class="form-control md:col-span-2">
          <label class="label" for="prodAllergenes"><span class="label-text">Allergènes (virgule)</span></label>
          <input id="prodAllergenes" type="text" class="input input-bordered" placeholder="gluten, lactose" />
        </div>
        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Produit populaire ★</span>
            <input id="prodPopular" type="checkbox" class="checkbox" />
          </label>
        </div>
        <div class="form-control">
          <label class="label cursor-pointer">
            <span class="label-text">Disponible</span>
            <input id="prodDisponible" type="checkbox" class="checkbox" checked />
          </label>
        </div>
      </div>
      <div class="modal-action">
        <button class="btn btn-ghost" id="cancelProductBtn">Annuler</button>
        <button class="btn btn-primary" id="saveProductBtn">Enregistrer</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <!-- ── Modal Catégories ──────────────────────── -->
  <dialog id="catsModal" class="modal">
    <div class="modal-box max-w-lg">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fermer">✕</button>
      </form>
      <h3 class="font-bold text-lg mb-4">Catégories</h3>
      <div class="card bg-base-200 p-4 mb-4">
        <p class="text-sm font-semibold mb-2">Ajouter</p>
        <div class="flex gap-2">
          <input id="newCatName" type="text" class="input input-sm input-bordered flex-1" placeholder="Nom" />
          <input id="newCatIcon" type="text" class="input input-sm input-bordered w-16 text-center" placeholder="🍔" />
          <button class="btn btn-sm btn-primary" id="addCatBtn">Ajouter</button>
        </div>
      </div>
      <div id="catsManageList" class="space-y-2"></div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <!-- ── Modal Suppléments ─────────────────────── -->
  <dialog id="suppsModal" class="modal">
    <div class="modal-box max-w-lg">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fermer">✕</button>
      </form>
      <h3 class="font-bold text-lg mb-4">Suppléments</h3>
      <div class="card bg-base-200 p-4 mb-4">
        <p class="text-sm font-semibold mb-2">Ajouter</p>
        <div class="flex gap-2">
          <input id="newSuppName"  type="text"   class="input input-sm input-bordered flex-1" placeholder="Nom" />
          <input id="newSuppPrice" type="number" step="0.01" min="0" class="input input-sm input-bordered w-28" placeholder="Prix €" />
          <button class="btn btn-sm btn-primary" id="addSuppBtn">Ajouter</button>
        </div>
      </div>
      <div id="suppsManageList" class="space-y-2"></div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <!-- ── Modal confirmation suppression ───────── -->
  <dialog id="confirmDelModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <h3 class="font-bold text-lg">Confirmer la suppression</h3>
      <p class="py-3 text-sm text-base-content/70" id="confirmDelMsg"></p>
      <div class="modal-action">
        <form method="dialog"><button class="btn btn-ghost btn-sm">Annuler</button></form>
        <button class="btn btn-error btn-sm" id="confirmDelYes">Supprimer</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <meta name="api-url" content={apiBaseUrl} />
</AdminLayout>

<script>
  // ── Types ─────────────────────────────────────
  interface Category    { id: string; name: string; icon: string; }
  interface Supplement  { id: string; name: string; price: number; }
  interface Produit {
    id: string; nom: string; description?: string; prix: number;
    category?: string; images?: string[]; supplements?: string[];
    removable_ingredients?: string[]; allergenes?: string[];
    popular?: boolean; disponible: boolean;
  }
  interface MenuData {
    categories: Category[]; supplements: Supplement[]; produits: Produit[];
  }

  // ── État ──────────────────────────────────────
  let menu: MenuData = { categories: [], supplements: [], produits: [] };
  let currentCat  = '';
  let editId: string | null = null;
  let pendingDelFn: (() => Promise<void>) | null = null;

  // ── Helpers ───────────────────────────────────
  function getApiBase() {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }
  function getToken() {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }
  function authH(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}`, 'Content-Type': 'application/json' };
  }
  function authHNoJson(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}` };
  }
  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style:'currency', currency:'EUR' }).format(n);

  function showToast(msg: string, type: 'success'|'error'|'info'|'warning' = 'info') {
    const c = document.getElementById('toast-container')!;
    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow-md text-sm py-2 px-4 rounded-xl`;
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  function q<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }

  function confirmDel(msg: string, fn: () => Promise<void>) {
    pendingDelFn = fn;
    q('confirmDelMsg').textContent = msg;
    (q('confirmDelModal') as HTMLDialogElement).showModal();
  }

  q('confirmDelYes').addEventListener('click', async () => {
    (q('confirmDelModal') as HTMLDialogElement).close();
    if (pendingDelFn) { await pendingDelFn(); pendingDelFn = null; }
  });

  // ── Fetch helpers ─────────────────────────────
  async function apiFetch<T>(path: string, opts: RequestInit = {}): Promise<T> {
    const res = await fetch(`${getApiBase()}${path}`, opts);
    if (res.status === 401) { window.location.href = '/login?expired=1'; throw new Error('401'); }
    if (!res.ok) {
      const b = await res.json().catch(() => ({}));
      throw new Error((b as any).error ?? `HTTP ${res.status}`);
    }
    return res.json() as Promise<T>;
  }

  // ── Chargement ────────────────────────────────
  async function loadMenu() {
    try {
      const raw = await apiFetch<any>('/menu', { headers: authH() });
      // Support deux formats selon ce que retourne le backend :
      // 1. Plat  : { categories, supplements, produits }
      // 2. Imbriqué : { menu: { categories, supplements, produits } }
      const data = (raw.menu && typeof raw.menu === 'object') ? raw.menu : raw;
      menu = {
        categories:  Array.isArray(data.categories)  ? data.categories  : [],
        supplements: Array.isArray(data.supplements) ? data.supplements : [],
        produits:    Array.isArray(data.produits)    ? data.produits    : [],
      };
      renderCatFilters();
      renderProduits();
      populateCatSelect();
      renderSuppCheckboxes();
      q('loader').classList.add('hidden');
      q('catFiltersWrap').classList.remove('hidden');
    } catch (err: unknown) {
      q('loader').innerHTML = `<div class="alert alert-error"><span>${esc(err instanceof Error ? err.message : String(err))}</span></div>`;
    }
  }

  // ── Filtres catégories ─────────────────────────
  function renderCatFilters() {
    const wrap = q('catFilterBtns');
    wrap.innerHTML = '';
    menu.categories.forEach(cat => {
      const btn = document.createElement('button');
      btn.className = 'btn btn-sm btn-ghost';
      btn.dataset.cat = cat.id;
      btn.textContent = `${cat.icon} ${cat.name}`;
      btn.addEventListener('click', () => setCatFilter(cat.id));
      wrap.appendChild(btn);
    });
  }

  function setCatFilter(catId: string) {
    currentCat = catId;
    document.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach(b => {
      b.classList.toggle('btn-primary', b.dataset.cat === catId);
      b.classList.toggle('btn-ghost',   b.dataset.cat !== catId);
    });
    renderProduits();
  }

  q('filterAll').addEventListener('click', () => setCatFilter(''));

  // ── Grille produits ───────────────────────────
  function renderProduits() {
    const grid  = q('produitsGrid');
    const empty = q('emptyProducts');
    const list  = currentCat
      ? menu.produits.filter(p => p.category === currentCat)
      : menu.produits;

    grid.innerHTML = '';
    if (!list.length) { empty.classList.remove('hidden'); return; }
    empty.classList.add('hidden');

    list.forEach(p => {
      const imgUrl = p.images?.[0]
        ? `${getApiBase()}/images/${p.images[0]}`
        : '/placeholder.jpg';

      const card = document.createElement('div');
      card.className = `card bg-base-100 shadow-lg transition-opacity ${p.disponible ? '' : 'opacity-60'}`;
      card.innerHTML = `
        <figure class="relative h-44 bg-base-200 overflow-hidden">
          <img src="${esc(imgUrl)}" alt="${esc(p.nom)}" class="w-full h-full object-cover"
            onerror="this.src='/placeholder.jpg'" loading="lazy" />
          ${p.popular ? '<span class="absolute top-2 left-2 badge badge-primary badge-sm">★ Populaire</span>' : ''}
        </figure>
        <div class="card-body p-4 gap-1">
          <h3 class="font-bold text-base leading-snug">${esc(p.nom)}</h3>
          ${p.description ? `<p class="text-xs text-base-content/60 line-clamp-2">${esc(p.description)}</p>` : ''}
          <div class="flex justify-between items-center mt-2">
            <span class="font-bold text-primary tabular-nums">${fmt(p.prix)}</span>
            <span class="badge badge-sm ${p.disponible ? 'badge-success' : 'badge-error'}">
              ${p.disponible ? 'Dispo' : 'Épuisé'}
            </span>
          </div>
          <div class="flex gap-1 justify-end mt-2">
            <button class="btn btn-xs btn-ghost toggle-btn" data-id="${esc(p.id)}"
              data-dispo="${p.disponible}" aria-label="Toggle disponibilité">
              ${p.disponible ? '✓' : '✗'}
            </button>
            <button class="btn btn-xs btn-ghost edit-btn" data-id="${esc(p.id)}" aria-label="Modifier">✏️</button>
            <button class="btn btn-xs btn-ghost text-error del-btn" data-id="${esc(p.id)}"
              data-nom="${esc(p.nom)}" aria-label="Supprimer">🗑️</button>
          </div>
        </div>
      `;
      grid.appendChild(card);
    });

    // Listeners
    grid.querySelectorAll<HTMLButtonElement>('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const dispo = btn.dataset.dispo === 'true';
        await updateProduct(btn.dataset.id!, { disponible: !dispo });
      });
    });
    grid.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => openEditProduct(btn.dataset.id!));
    });
    grid.querySelectorAll<HTMLButtonElement>('.del-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        confirmDel(`Supprimer « ${btn.dataset.nom} » ?`, async () => {
          await deleteProduct(btn.dataset.id!);
        });
      });
    });
  }

  // ── Modal produit ─────────────────────────────
  function populateCatSelect() {
    const sel = q<HTMLSelectElement>('prodCat');
    sel.innerHTML = menu.categories.map(c =>
      `<option value="${esc(c.id)}">${esc(c.icon)} ${esc(c.name)}</option>`
    ).join('');
  }

  function renderSuppCheckboxes(checked: string[] = []) {
    const wrap = q('suppCheckboxes');
    wrap.innerHTML = '';
    menu.supplements.forEach(s => {
      const lbl = document.createElement('label');
      lbl.className = 'flex items-center gap-1.5 border border-base-300 rounded-lg px-3 py-1.5 cursor-pointer text-sm';
      const cb = document.createElement('input');
      cb.type      = 'checkbox';
      cb.name      = 'supplement';
      cb.value     = s.id;
      cb.className = 'checkbox checkbox-sm';
      cb.checked   = checked.includes(s.id);
      const span = document.createElement('span');
      span.textContent = `${s.name} (+${fmt(s.price)})`;
      lbl.appendChild(cb);
      lbl.appendChild(span);
      wrap.appendChild(lbl);
    });
  }

  function resetProductModal() {
    editId = null;
    q('productModalTitle').textContent = 'Ajouter un produit';
    (q<HTMLInputElement>('prodNom')).value        = '';
    (q<HTMLTextAreaElement>('prodDesc')).value    = '';
    (q<HTMLInputElement>('prodPrix')).value       = '';
    (q<HTMLInputElement>('prodRemovable')).value  = '';
    (q<HTMLInputElement>('prodAllergenes')).value = '';
    (q<HTMLInputElement>('prodPopular')).checked  = false;
    (q<HTMLInputElement>('prodDisponible')).checked = true;
    (q<HTMLInputElement>('prodImages')).value     = '';
    q('imagePreview').innerHTML                   = '';
    renderSuppCheckboxes();
  }

  function openEditProduct(id: string) {
    const p = menu.produits.find(x => x.id === id);
    if (!p) return;
    editId = id;
    q('productModalTitle').textContent = 'Modifier le produit';
    (q<HTMLInputElement>('prodNom')).value        = p.nom;
    (q<HTMLTextAreaElement>('prodDesc')).value    = p.description ?? '';
    (q<HTMLInputElement>('prodPrix')).value       = String(p.prix);
    (q<HTMLSelectElement>('prodCat')).value       = p.category ?? '';
    (q<HTMLInputElement>('prodRemovable')).value  = (p.removable_ingredients ?? []).join(', ');
    (q<HTMLInputElement>('prodAllergenes')).value = (p.allergenes ?? []).join(', ');
    (q<HTMLInputElement>('prodPopular')).checked  = p.popular ?? false;
    (q<HTMLInputElement>('prodDisponible')).checked = p.disponible;

    // Images existantes
    const preview = q('imagePreview');
    preview.innerHTML = '';
    (p.images ?? []).forEach(src => {
      const img = document.createElement('img');
      img.src       = `${getApiBase()}/images/${src}`;
      img.className = 'w-16 h-16 object-cover rounded-lg border border-base-300';
      img.alt       = p.nom;
      preview.appendChild(img);
    });

    renderSuppCheckboxes(p.supplements ?? []);
    (q('productModal') as HTMLDialogElement).showModal();
  }

  // Preview nouvelles images
  q<HTMLInputElement>('prodImages').addEventListener('change', (e) => {
    const preview = q('imagePreview');
    preview.innerHTML = '';
    const files = (e.target as HTMLInputElement).files ?? [];
    Array.from(files).forEach(f => {
      const reader = new FileReader();
      reader.onload = ev => {
        const img = document.createElement('img');
        img.src       = ev.target?.result as string;
        img.className = 'w-16 h-16 object-cover rounded-lg border border-base-300';
        preview.appendChild(img);
      };
      reader.readAsDataURL(f);
    });
  });

  async function saveProduct() {
    const nom = (q<HTMLInputElement>('prodNom')).value.trim();
    const prix = parseFloat((q<HTMLInputElement>('prodPrix')).value);
    if (!nom) { showToast('Le nom est obligatoire', 'error'); return; }
    if (isNaN(prix) || prix < 0) { showToast('Prix invalide', 'error'); return; }

    const btn = q<HTMLButtonElement>('saveProductBtn');
    btn.disabled = true;
    btn.textContent = 'Enregistrement…';

    try {
      // Upload nouvelles images
      const fileInput = q<HTMLInputElement>('prodImages');
      const newImages: string[] = [];
      for (const file of Array.from(fileInput.files ?? [])) {
        const fd = new FormData();
        fd.append('image', file);
        const res = await fetch(`${getApiBase()}/upload-image`, {
          method: 'POST', headers: authHNoJson(), body: fd,
        });
        if (res.ok) {
          const data = await res.json() as { filename: string };
          newImages.push(data.filename);
        }
      }

      const existing = editId ? (menu.produits.find(p => p.id === editId)?.images ?? []) : [];
      const supplements = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="supplement"]:checked')
      ).map(cb => cb.value);

      const payload: Partial<Produit> = {
        nom,
        description: (q<HTMLTextAreaElement>('prodDesc')).value,
        prix,
        category:   (q<HTMLSelectElement>('prodCat')).value,
        images:     newImages.length ? newImages : existing,
        supplements,
        removable_ingredients: (q<HTMLInputElement>('prodRemovable')).value
          .split(',').map(s => s.trim()).filter(Boolean),
        allergenes: (q<HTMLInputElement>('prodAllergenes')).value
          .split(',').map(s => s.trim()).filter(Boolean),
        popular:    (q<HTMLInputElement>('prodPopular')).checked,
        disponible: (q<HTMLInputElement>('prodDisponible')).checked,
      };

      if (editId) {
        await apiFetch(`/menu/${encodeURIComponent(editId)}`, {
          method: 'PUT', headers: authH(), body: JSON.stringify(payload),
        });
        showToast('Produit mis à jour', 'success');
      } else {
        await apiFetch('/menu', {
          method: 'POST', headers: authH(), body: JSON.stringify(payload),
        });
        showToast('Produit ajouté', 'success');
      }

      (q('productModal') as HTMLDialogElement).close();
      resetProductModal();
      await loadMenu();
    } catch (err: unknown) {
      showToast(`Erreur : ${err instanceof Error ? err.message : String(err)}`, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enregistrer';
    }
  }

  async function updateProduct(id: string, data: Partial<Produit>) {
    try {
      await apiFetch(`/menu/${encodeURIComponent(id)}`, {
        method: 'PUT', headers: authH(), body: JSON.stringify(data),
      });
      await loadMenu();
    } catch (err: unknown) {
      showToast(`Erreur : ${err instanceof Error ? err.message : String(err)}`, 'error');
    }
  }

  async function deleteProduct(id: string) {
    try {
      await apiFetch(`/menu/${encodeURIComponent(id)}`, {
        method: 'DELETE', headers: authH(),
      });
      showToast('Produit supprimé', 'success');
      await loadMenu();
    } catch (err: unknown) {
      showToast(`Erreur : ${err instanceof Error ? err.message : String(err)}`, 'error');
    }
  }

  // ── Catégories ────────────────────────────────
  function renderCatsManage() {
    const wrap = q('catsManageList');
    wrap.innerHTML = '';
    menu.categories.forEach(cat => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 p-2 bg-base-100 rounded-xl border border-base-300';

      const iconInp = document.createElement('input');
      iconInp.type      = 'text';
      iconInp.value     = cat.icon;
      iconInp.className = 'input input-sm w-14 text-center';
      iconInp.addEventListener('change', () => updateCat(cat.id, 'icon', iconInp.value));

      const nameInp = document.createElement('input');
      nameInp.type      = 'text';
      nameInp.value     = cat.name;
      nameInp.className = 'input input-sm flex-1';
      nameInp.addEventListener('change', () => updateCat(cat.id, 'name', nameInp.value));

      const delBtn = document.createElement('button');
      delBtn.className   = 'btn btn-xs btn-ghost text-error';
      delBtn.textContent = '🗑️';
      delBtn.addEventListener('click', () => {
        confirmDel(`Supprimer la catégorie « ${cat.name } » ?`, async () => {
          menu.categories = menu.categories.filter(c => c.id !== cat.id);
          await saveMenuMeta();
          renderCatsManage();
          renderCatFilters();
          populateCatSelect();
          renderProduits();
        });
      });

      row.appendChild(iconInp);
      row.appendChild(nameInp);
      row.appendChild(delBtn);
      wrap.appendChild(row);
    });
  }

  async function updateCat(id: string, field: 'icon'|'name', value: string) {
    const cat = menu.categories.find(c => c.id === id);
    if (!cat) return;
    cat[field] = value;
    await saveMenuMeta();
    renderCatFilters();
    populateCatSelect();
  }

  q('addCatBtn').addEventListener('click', async () => {
    const name = (q<HTMLInputElement>('newCatName')).value.trim();
    const icon = (q<HTMLInputElement>('newCatIcon')).value.trim();
    if (!name || !icon) { showToast('Nom et icône obligatoires', 'error'); return; }
    menu.categories.push({ id: name.toLowerCase().replace(/\s+/g, '_'), name, icon });
    await saveMenuMeta();
    (q<HTMLInputElement>('newCatName')).value = '';
    (q<HTMLInputElement>('newCatIcon')).value = '';
    renderCatsManage();
    renderCatFilters();
    populateCatSelect();
    showToast('Catégorie ajoutée', 'success');
  });

  // ── Suppléments ───────────────────────────────
  function renderSuppsManage() {
    const wrap = q('suppsManageList');
    wrap.innerHTML = '';
    menu.supplements.forEach(s => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 p-2 bg-base-100 rounded-xl border border-base-300';

      const nameInp = document.createElement('input');
      nameInp.type      = 'text';
      nameInp.value     = s.name;
      nameInp.className = 'input input-sm flex-1';
      nameInp.addEventListener('change', () => updateSupp(s.id, 'name', nameInp.value));

      const priceInp = document.createElement('input');
      priceInp.type      = 'number';
      priceInp.step      = '0.01';
      priceInp.value     = String(s.price);
      priceInp.className = 'input input-sm w-28';
      priceInp.addEventListener('change', () => updateSupp(s.id, 'price', parseFloat(priceInp.value)));

      const delBtn = document.createElement('button');
      delBtn.className   = 'btn btn-xs btn-ghost text-error';
      delBtn.textContent = '🗑️';
      delBtn.addEventListener('click', () => {
        confirmDel(`Supprimer le supplément « ${s.name} » ?`, async () => {
          menu.supplements = menu.supplements.filter(x => x.id !== s.id);
          await saveMenuMeta();
          renderSuppsManage();
          renderSuppCheckboxes();
        });
      });

      row.appendChild(nameInp);
      row.appendChild(priceInp);
      row.appendChild(delBtn);
      wrap.appendChild(row);
    });
  }

  async function updateSupp(id: string, field: 'name'|'price', value: string|number) {
    const s = menu.supplements.find(x => x.id === id);
    if (!s) return;
    (s as any)[field] = value;
    await saveMenuMeta();
    renderSuppCheckboxes();
  }

  q('addSuppBtn').addEventListener('click', async () => {
    const name  = (q<HTMLInputElement>('newSuppName')).value.trim();
    const price = parseFloat((q<HTMLInputElement>('newSuppPrice')).value);
    if (!name || isNaN(price)) { showToast('Nom et prix obligatoires', 'error'); return; }
    menu.supplements.push({ id: name.toLowerCase().replace(/\s+/g,'_'), name, price });
    await saveMenuMeta();
    (q<HTMLInputElement>('newSuppName')).value  = '';
    (q<HTMLInputElement>('newSuppPrice')).value = '';
    renderSuppsManage();
    renderSuppCheckboxes();
    showToast('Supplément ajouté', 'success');
  });

  // Sauvegarde catégories + suppléments via endpoint config
  async function saveMenuMeta() {
    // Le backend stocke categories et supplements dans MENU_FILE (menu.json)
    // via PUT /api/menu — on envoie la structure complète pour ne pas écraser les produits
    try {
      await apiFetch('/menu', {
        method: 'PUT',
        headers: authH(),
        body: JSON.stringify({
          categories:  menu.categories,
          supplements: menu.supplements,
          produits:    menu.produits,
        }),
      });
    } catch (err: unknown) {
      showToast(`Erreur sauvegarde : ${err instanceof Error ? err.message : String(err)}`, 'error');
    }
  }

  // ── Boutons header ────────────────────────────
  q('btnAddProduct').addEventListener('click', () => {
    resetProductModal();
    (q('productModal') as HTMLDialogElement).showModal();
  });

  q('btnManageCats').addEventListener('click', () => {
    renderCatsManage();
    (q('catsModal') as HTMLDialogElement).showModal();
  });

  q('btnManageSupps').addEventListener('click', () => {
    renderSuppsManage();
    (q('suppsModal') as HTMLDialogElement).showModal();
  });

  // Boutons modal produit
  q('saveProductBtn').addEventListener('click', () => void saveProduct());
  q('cancelProductBtn').addEventListener('click', () => {
    (q('productModal') as HTMLDialogElement).close();
  });

  // Reset form à la fermeture
  (q('productModal') as HTMLDialogElement).addEventListener('close', resetProductModal);

  // ── Init ──────────────────────────────────────
  document.addEventListener('astro:page-load', () => void loadMenu());
  void loadMenu();
</script>