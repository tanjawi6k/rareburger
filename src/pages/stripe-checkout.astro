---
// src/pages/stripe-checkout.astro
export const prerender = false;

import Navbar from '../components/Navbar.astro';
import api from '../lib/api';
import '../assets/app.css';

// Redirect immédiat si pas d'orderId
const orderId = Astro.url.searchParams.get('order');
if (!orderId) return Astro.redirect('/cart');

// ─────────────────────────────────────────
// Thème SSR
// ─────────────────────────────────────────
const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];
const cookieTheme = Astro.cookies.get('theme')?.value;

let theme          = 'light';
let logoUrl        = '/favicon.ico';
let restaurantName = 'CMDOLA';

try {
  const configData = await api.config.get() as Record<string, any>;
  const configTheme = (configData.theme as Record<string,string>|undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme
    : (configTheme && VALID_THEMES.includes(configTheme) ? configTheme : 'light');
  const logoFile = (configData.theme as Record<string,string>|undefined)?.logo;
  logoUrl        = logoFile ? api.images.getUrl(logoFile) : '/favicon.ico';
  restaurantName = (configData.nom as string|undefined) ?? 'CMDOLA';
} catch { /* thème par défaut */ }

// Pré-charger la commande SSR pour afficher le résumé sans flash
let initialOrder: Record<string, any> | null = null;
try {
  initialOrder = await api.commandes.getPublic(orderId) as Record<string, any>;
} catch { /* géré côté client */ }

const initialOrderJson = initialOrder ? JSON.stringify(initialOrder) : 'null';
const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="api-url" content={apiBaseUrl} />
  <meta name="order-id" content={orderId} />
  <title>Paiement sécurisé — {restaurantName}</title>
  <link rel="icon" type="image/png" href={logoUrl} />

  <!-- Anti-FOUC thème -->
  <script is:inline>
    (function(){
      var v=['light','dark','cupcake','bumblebee','emerald','corporate',
        'synthwave','retro','cyberpunk','valentine','halloween','garden','forest',
        'aqua','lofi','pastel','fantasy','wireframe','black','luxury','dracula',
        'cmyk','autumn','business','acid','lemonade','night','coffee','winter',
        'dim','nord','sunset'];
      var c=document.cookie.split(';').find(function(x){return x.trim().startsWith('theme=');});
      var t=c?decodeURIComponent(c.split('=')[1].trim()):null;
      if(t&&v.indexOf(t)!==-1) document.documentElement.setAttribute('data-theme',t);
    }());
  </script>

  <!-- Commande pré-chargée SSR -->
  <script id="initial-order" type="application/json" set:html={initialOrderJson} />
</head>

<body class="bg-base-200" style="min-height:100dvh;min-height:100vh;">

  <header class="sticky top-0 z-40">
    <Navbar restaurantName={restaurantName} logoUrl={logoUrl} activePage="" />
  </header>

  <main class="container mx-auto px-4 py-8 max-w-xl">

    <!-- État chargement (affiché par défaut) -->
    <div id="loading-section" class="flex flex-col items-center justify-center py-20 text-center">
      <span class="loading loading-spinner loading-lg text-primary mb-4"></span>
      <h2 class="text-xl font-bold text-base-content" id="loading-title">Préparation du paiement…</h2>
      <p class="text-base-content/50 text-sm mt-1">Vous allez être redirigé vers la page de paiement sécurisée</p>
      <div class="flex items-center gap-2 mt-4 text-xs text-base-content/40">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Paiement sécurisé par Stripe
      </div>
    </div>

    <!-- Résumé commande (affiché pendant le chargement) -->
    <div id="summary-section" class="mb-6 hidden">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h3 class="font-bold text-base">Récapitulatif</h3>
          <div class="divider my-0"></div>
          <div id="order-items" class="space-y-2"></div>
          <div class="divider my-0"></div>
          <div class="flex justify-between">
            <span class="font-bold">Total à payer</span>
            <span id="order-total" class="font-bold text-primary text-lg tabular-nums"></span>
          </div>
        </div>
      </div>

      <div class="alert alert-info text-xs rounded-xl mt-3 py-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <p>Vos informations de paiement sont chiffrées et protégées par Stripe. Nous ne stockons aucune donnée bancaire.</p>
      </div>
    </div>

    <!-- Section erreur (cachée par défaut) -->
    <div id="error-section" class="hidden">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body items-center text-center gap-4">
          <span class="text-5xl" aria-hidden="true">⚠️</span>
          <div>
            <h2 class="text-xl font-bold">Impossible de lancer le paiement</h2>
            <p id="error-message" class="text-base-content/60 text-sm mt-2"></p>
          </div>
          <div class="flex flex-wrap gap-3 justify-center mt-2">
            <button id="retry-btn" class="btn btn-primary gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Réessayer
            </button>
            <a href="/cart" class="btn btn-outline gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
              Retour au panier
            </a>
          </div>
        </div>
      </div>
    </div>

  </main>

</body>
</html>

<style>
  @media (pointer: coarse) { button, a { min-height: 44px; } }
</style>

<script>
  // ════════════════════════════════════════════
  //  stripe-checkout.astro
  //  1. Affiche le résumé commande (SSR pré-chargé)
  //  2. Crée la session Stripe via fetch
  //  3. Redirige vers Stripe
  // ════════════════════════════════════════════

  interface OrderItem {
    nom: string; prix: number; quantite: number;
    supplements?: { name: string }[];
  }
  interface Order {
    id: string; numero: string;
    articles: OrderItem[];
    sous_total: number; frais_livraison: number; prix_total: number;
  }

  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(n);

  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }

  function getApiBase(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }

  function getOrderId(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="order-id"]')?.content
      ?? new URLSearchParams(window.location.search).get('order')
      ?? '';
  }

  // ── États UI ──────────────────────────────────
  function showLoading(msg?: string) {
    document.getElementById('loading-section')!.classList.remove('hidden');
    document.getElementById('error-section')!.classList.add('hidden');
    if (msg) document.getElementById('loading-title')!.textContent = msg;
  }

  function showError(msg: string) {
    document.getElementById('loading-section')!.classList.add('hidden');
    document.getElementById('error-section')!.classList.remove('hidden');
    document.getElementById('error-message')!.textContent = msg;
  }

  // ── Résumé commande ────────────────────────────
  function renderSummary(order: Order) {
    const itemsEl = document.getElementById('order-items')!;
    itemsEl.innerHTML = '';

    order.articles.forEach(item => {
      const row = document.createElement('div');
      row.className = 'flex justify-between gap-2 text-sm';

      const left = document.createElement('div');
      left.className = 'flex-1 min-w-0';
      left.innerHTML = `<span class="font-medium">${item.quantite}× ${esc(item.nom)}</span>`;

      if (item.supplements?.length) {
        const sup = document.createElement('p');
        sup.className = 'text-xs text-base-content/50 mt-0.5';
        sup.textContent = `+ ${item.supplements.map(s => s.name).join(', ')}`;
        left.appendChild(sup);
      }

      const right = document.createElement('span');
      right.className = 'font-semibold tabular-nums shrink-0';
      right.textContent = fmt(item.prix * item.quantite);

      row.appendChild(left);
      row.appendChild(right);
      itemsEl.appendChild(row);
    });

    if (order.frais_livraison > 0) {
      const row = document.createElement('div');
      row.className = 'flex justify-between text-sm text-base-content/60';
      row.innerHTML = `<span>Livraison</span><span class="tabular-nums">${fmt(order.frais_livraison)}</span>`;
      itemsEl.appendChild(row);
    }

    document.getElementById('order-total')!.textContent = fmt(order.prix_total);
    document.getElementById('summary-section')!.classList.remove('hidden');
  }

  // ── Création session Stripe ───────────────────
  let isRedirecting = false;

  async function startCheckout() {
    const orderId = getOrderId();
    if (!orderId) { showError('Aucune commande spécifiée.'); return; }

    showLoading('Préparation du paiement…');

    try {
      // 1. Afficher le résumé si pas encore chargé SSR
      const preloadEl = document.getElementById('initial-order');
      let order: Order | null = null;
      try {
        const raw = preloadEl?.textContent?.trim();
        if (raw && raw !== 'null') order = JSON.parse(raw) as Order;
      } catch { /* fetch fallback */ }

      if (!order) {
        try {
          const res = await fetch(`${getApiBase()}/commandes/public/${encodeURIComponent(orderId)}`);
          if (res.ok) order = await res.json() as Order;
        } catch { /* résumé non critique */ }
      }

      if (order) renderSummary(order);

      // 2. Créer la session Stripe
      const res = await fetch(`${getApiBase()}/stripe/create-checkout-session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_id: orderId }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        throw new Error((body as any).error ?? `Erreur ${res.status}`);
      }

      const session = await res.json() as { url?: string; session_id?: string };

      if (!session.url) throw new Error('URL de paiement manquante dans la réponse Stripe.');

      // 3. Rediriger
      isRedirecting = true;
      showLoading('Redirection vers le paiement…');
      window.location.href = session.url;

    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Erreur inconnue';
      showError(msg);
    }
  }

  // ── Bouton réessayer ──────────────────────────
  document.getElementById('retry-btn')?.addEventListener('click', () => {
    void startCheckout();
  });

  // ── Avertissement si navigation pendant le paiement ─
  window.addEventListener('beforeunload', (e) => {
    const loading = document.getElementById('loading-section');
    if (!isRedirecting && !loading?.classList.contains('hidden')) {
      e.preventDefault();
      // Modern browsers ignorer le message custom mais affichent une dialog native
      e.returnValue = '';
    }
  });

  // ── Init ──────────────────────────────────────
  document.addEventListener('astro:page-load', () => void startCheckout());
  void startCheckout();
</script>