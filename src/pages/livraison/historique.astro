---
// src/pages/livraison/historique.astro
export const prerender = false;

import '../../assets/app.css';
import api from '../../lib/api';

const user = Astro.locals.user;
if (!user?.roles.some(r => ['livreur','admin'].includes(r))) {
  return Astro.redirect('/livraison/login');
}

const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];
const cookieTheme = Astro.cookies.get('theme')?.value;
let theme = 'light';
let logoUrl = '/favicon.ico';
let restaurantName = 'CMDOLA';

try {
  const cfg = await api.config.get() as Record<string, any>;
  const t = (cfg.theme as Record<string,string>|undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme : (t && VALID_THEMES.includes(t) ? t : 'light');
  const logoFile = (cfg.theme as Record<string,string>|undefined)?.logo;
  logoUrl = logoFile ? api.images.getUrl(logoFile) : '/favicon.ico';
  restaurantName = (cfg.nom as string|undefined) ?? 'CMDOLA';
} catch {}

const livreurName = user.name ?? user.username ?? 'Livreur';
const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'https://api.rareburger.be/api';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="api-url" content={apiBaseUrl} />
  <title>Historique — {restaurantName}</title>
  <link rel="icon" href={logoUrl} />
  <script is:inline>
    (function(){
      var v=['light','dark','cupcake','bumblebee','emerald','corporate','synthwave','retro',
        'cyberpunk','valentine','halloween','garden','forest','aqua','lofi','pastel','fantasy',
        'wireframe','black','luxury','dracula','cmyk','autumn','business','acid','lemonade',
        'night','coffee','winter','dim','nord','sunset'];
      var c=document.cookie.split(';').find(function(x){return x.trim().startsWith('theme=');});
      var t=c?decodeURIComponent(c.split('=')[1].trim()):null;
      if(t&&v.indexOf(t)!==-1) document.documentElement.setAttribute('data-theme',t);
    }());
  </script>
  <script id="livreur-info" type="application/json" set:html={JSON.stringify({ username: user.username })} />
</head>

<body class="bg-base-200" style="min-height:100dvh;padding-bottom:72px;">

  <!-- Navbar -->
  <nav class="navbar bg-base-100 shadow-md sticky top-0 z-50 px-3">
    <div class="flex-1 flex items-center gap-2">
      <a href="/livraison" class="btn btn-ghost btn-sm btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
      <div>
        <p class="font-bold text-sm">Mon historique</p>
        <p class="text-xs text-base-content/50">{livreurName}</p>
      </div>
    </div>
  </nav>

  <!-- Stats -->
  <div class="stats stats-horizontal shadow w-full bg-base-100 text-sm border-b border-base-200">
    <div class="stat p-3">
      <div class="stat-title text-xs">Aujourd'hui</div>
      <div class="stat-value text-success text-2xl" id="cntToday">—</div>
    </div>
    <div class="stat p-3">
      <div class="stat-title text-xs">Cette semaine</div>
      <div class="stat-value text-info text-2xl" id="cntWeek">—</div>
    </div>
    <div class="stat p-3">
      <div class="stat-title text-xs">Total</div>
      <div class="stat-value text-primary text-2xl" id="cntTotal">—</div>
    </div>
  </div>

  <!-- Filtres -->
  <div class="p-3 bg-base-100 border-b border-base-200 space-y-2">
    <input id="searchInput" type="search" placeholder="Rechercher numéro, client…"
      class="input input-bordered input-sm w-full" />
    <div class="flex gap-2">
      <select id="filterPeriode" class="select select-bordered select-sm flex-1">
        <option value="today">Aujourd'hui</option>
        <option value="week">Cette semaine</option>
        <option value="month">Ce mois</option>
        <option value="all">Tout</option>
      </select>
      <select id="filterTri" class="select select-bordered select-sm flex-1">
        <option value="recent">Plus récentes</option>
        <option value="oldest">Plus anciennes</option>
      </select>
    </div>
    <div class="flex justify-between items-center text-xs text-base-content/50">
      <span><span id="displayCount">0</span> résultat(s)</span>
      <button id="resetBtn" class="btn btn-ghost btn-xs">Réinitialiser</button>
    </div>
  </div>

  <!-- Contenu -->
  <div class="p-3 space-y-3">
    <div id="loader" class="flex justify-center py-16">
      <span class="loading loading-spinner loading-lg text-primary"></span>
    </div>
    <div id="histList" class="hidden space-y-3"></div>
    <div id="emptyState" class="hidden text-center py-16">
      <p class="text-5xl mb-3">📦</p>
      <h3 class="font-bold text-lg">Aucune livraison</h3>
      <p class="text-base-content/60 text-sm mt-1">Aucune livraison dans cette période</p>
    </div>
  </div>

  <!-- Bottom nav -->
  <nav class="fixed bottom-0 left-0 right-0 bg-base-100 border-t border-base-200 z-50"
    style="padding-bottom:env(safe-area-inset-bottom,0);">
    <div class="flex">
      <a href="/livraison" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="text-xs">Accueil</span>
      </a>
      <a href="/livraison/historique" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-xs font-medium">Historique</span>
      </a>
      <a href="/logout" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span class="text-xs">Déconnexion</span>
      </a>
    </div>
  </nav>

  <!-- Modal détail -->
  <dialog id="detailModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-lg space-y-3">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
      </form>
      <div class="flex justify-between items-start">
        <div>
          <h3 class="font-mono font-black text-2xl" id="mNumero">—</h3>
          <p class="text-base-content/60 text-sm" id="mDate">—</p>
        </div>
        <span class="badge badge-success badge-lg">Livrée</span>
      </div>
      <div class="card bg-base-200 card-compact">
        <div class="card-body gap-1">
          <p class="font-bold" id="mClient">—</p>
          <p class="text-sm text-base-content/60" id="mTel">—</p>
          <p class="text-sm text-base-content/60" id="mAdresse">—</p>
        </div>
      </div>
      <div id="mArticles" class="space-y-1 max-h-40 overflow-y-auto text-sm"></div>
      <div class="flex justify-between font-bold border-t border-base-200 pt-2">
        <span>Total</span>
        <span class="text-primary tabular-nums" id="mTotal">—</span>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

</body>
</html>

<script>
  interface Article { nom: string; prix: number; quantite: number; }
  interface Commande {
    id: string; numero: string; statut: string; date_creation: string;
    prix_total: number; client?: Record<string,any>; articles: Article[];
    livreur_id?: string;
  }

  function getApiBase() {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'https://api.rareburger.be/api';
  }
  function getToken() {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }
  function authH(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}`, 'Content-Type': 'application/json' };
  }
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style:'currency', currency:'EUR' }).format(n);
  function esc(v: unknown) {
    const d = document.createElement('div'); d.textContent = String(v ?? ''); return d.innerHTML;
  }
  function fmtDate(s: string) {
    try { return new Intl.DateTimeFormat('fr-BE', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' }).format(new Date(s)); }
    catch { return s; }
  }
  function q<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }

  let livreurUsername = '';
  let allCommandes: Commande[] = [];
  let filtered: Commande[]     = [];
  let filterPeriode = 'today';
  let filterSort    = 'recent';

  function initInfo() {
    try {
      const raw = document.getElementById('livreur-info')?.textContent?.trim();
      if (raw) livreurUsername = (JSON.parse(raw) as any).username ?? '';
    } catch {}
  }

  async function load() {
    try {
      const res = await fetch(`${getApiBase()}/commandes/archives?period=all&statut=all`, {
        headers: authH(),
      });
      if (res.status === 401) { window.location.href = '/livraison/login'; return; }
      const data = await res.json() as { commandes: Commande[] };
      allCommandes = (data.commandes ?? []).filter(c =>
        c.type === 'livraison' && c.statut === 'livree' && c.livreur_id === livreurUsername
      );
      updateStats();
      applyFilters();
    } catch {
      q('loader').innerHTML = '<p class="text-error text-sm text-center">Erreur de chargement</p>';
    } finally {
      q('loader').classList.add('hidden');
    }
  }

  function updateStats() {
    const now    = new Date();
    const today  = new Date(now); today.setHours(0,0,0,0);
    const week   = new Date(now.getTime() - 7*24*60*60*1000);
    q('cntToday').textContent = String(allCommandes.filter(c => new Date(c.date_creation) >= today).length);
    q('cntWeek').textContent  = String(allCommandes.filter(c => new Date(c.date_creation) >= week).length);
    q('cntTotal').textContent = String(allCommandes.length);
  }

  function applyFilters() {
    const search = (q<HTMLInputElement>('searchInput')).value.toLowerCase();
    const now    = new Date();

    filtered = allCommandes.filter(c => {
      if (search) {
        const ok = c.numero.toLowerCase().includes(search)
          || (c.client?.nom  ?? '').toLowerCase().includes(search)
          || (c.client?.prenom ?? '').toLowerCase().includes(search);
        if (!ok) return false;
      }
      const d = new Date(c.date_creation);
      if (filterPeriode === 'today') {
        const t = new Date(now); t.setHours(0,0,0,0);
        if (d < t) return false;
      } else if (filterPeriode === 'week') {
        if (d < new Date(now.getTime() - 7*24*60*60*1000)) return false;
      } else if (filterPeriode === 'month') {
        if (d < new Date(now.getTime() - 30*24*60*60*1000)) return false;
      }
      return true;
    });

    filtered.sort((a, b) => {
      const diff = new Date(a.date_creation).getTime() - new Date(b.date_creation).getTime();
      return filterSort === 'recent' ? -diff : diff;
    });

    render();
  }

  function render() {
    const list  = q('histList');
    const empty = q('emptyState');
    q('displayCount').textContent = String(filtered.length);
    list.innerHTML = '';

    if (!filtered.length) {
      list.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');
    list.classList.remove('hidden');

    filtered.forEach(cmd => {
      const card = document.createElement('div');
      card.className = 'card bg-base-100 shadow cursor-pointer active:scale-[0.98] transition-transform';
      const count = cmd.articles.reduce((s, a) => s + a.quantite, 0);
      card.innerHTML = `
        <div class="card-body p-4 gap-1.5">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="font-mono font-black text-lg">#${esc(cmd.numero)}</h3>
              <p class="text-sm text-base-content/60">${esc(cmd.client?.prenom ?? '')} ${esc(cmd.client?.nom ?? '')}</p>
              <p class="text-xs text-base-content/40">${fmtDate(cmd.date_creation)}</p>
            </div>
            <div class="text-right">
              <span class="badge badge-success badge-sm mb-1 block">Livrée</span>
              <p class="font-bold tabular-nums">${fmt(cmd.prix_total)}</p>
              <p class="text-xs text-base-content/50">${count} article${count > 1 ? 's' : ''}</p>
            </div>
          </div>
        </div>
      `;
      card.addEventListener('click', () => openModal(cmd));
      list.appendChild(card);
    });
  }

  function openModal(cmd: Commande) {
    const addr = cmd.client?.adresse as Record<string,string>|undefined;
    q('mNumero').textContent = `#${cmd.numero}`;
    q('mDate').textContent   = fmtDate(cmd.date_creation);
    q('mClient').textContent = `${cmd.client?.prenom ?? ''} ${cmd.client?.nom ?? ''}`.trim();
    q('mTel').textContent    = cmd.client?.telephone ?? '';
    q('mAdresse').textContent = addr
      ? `${addr.rue} ${addr.numero}, ${addr.code_postal} ${addr.ville}` : '—';
    q('mTotal').textContent  = fmt(cmd.prix_total);

    const artEl = q('mArticles');
    artEl.innerHTML = '';
    cmd.articles.forEach(a => {
      const row = document.createElement('div');
      row.className = 'flex justify-between gap-2';
      row.innerHTML = `
        <span>${a.quantite}× ${esc(a.nom)}</span>
        <span class="font-semibold tabular-nums shrink-0">${fmt(a.prix * a.quantite)}</span>
      `;
      artEl.appendChild(row);
    });

    (q('detailModal') as HTMLDialogElement).showModal();
  }

  q<HTMLInputElement>('searchInput').addEventListener('input', applyFilters);
  q<HTMLSelectElement>('filterPeriode').addEventListener('change', e => {
    filterPeriode = (e.target as HTMLSelectElement).value; applyFilters();
  });
  q<HTMLSelectElement>('filterTri').addEventListener('change', e => {
    filterSort = (e.target as HTMLSelectElement).value; applyFilters();
  });
  q('resetBtn').addEventListener('click', () => {
    (q<HTMLInputElement>('searchInput')).value = '';
    (q<HTMLSelectElement>('filterPeriode')).value = 'today';
    (q<HTMLSelectElement>('filterTri')).value = 'recent';
    filterPeriode = 'today'; filterSort = 'recent'; applyFilters();
  });

  function init() { initInfo(); void load(); }
  document.addEventListener('astro:page-load', init);
  init();
</script>