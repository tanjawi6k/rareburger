---
// src/pages/livraison/index.astro
export const prerender = false;

import '../../assets/app.css';
import api from '../../lib/api';

const user = Astro.locals.user;
if (!user?.roles.some(r => ['livreur','admin'].includes(r))) {
  return Astro.redirect('/login');
}

const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];
const cookieTheme = Astro.cookies.get('theme')?.value;
let theme = 'light';
let logoUrl = '/favicon.ico';
let restaurantName = 'CMDOLA';

try {
  const cfg = await api.config.get() as Record<string, any>;
  const t = (cfg.theme as Record<string,string>|undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme : (t && VALID_THEMES.includes(t) ? t : 'light');
  const logoFile = (cfg.theme as Record<string,string>|undefined)?.logo;
  logoUrl = logoFile ? api.images.getUrl(logoFile) : '/favicon.ico';
  restaurantName = (cfg.nom as string|undefined) ?? 'CMDOLA';
} catch {}

const livreurName = user.name ?? user.username ?? 'Livreur';
const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'https://api.rareburger.be/api';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="api-url" content={apiBaseUrl} />
  <title>Livraisons — {restaurantName}</title>
  <link rel="icon" href={logoUrl} />
  <script is:inline>
    (function(){
      var v=['light','dark','cupcake','bumblebee','emerald','corporate','synthwave','retro',
        'cyberpunk','valentine','halloween','garden','forest','aqua','lofi','pastel','fantasy',
        'wireframe','black','luxury','dracula','cmyk','autumn','business','acid','lemonade',
        'night','coffee','winter','dim','nord','sunset'];
      var c=document.cookie.split(';').find(function(x){return x.trim().startsWith('theme=');});
      var t=c?decodeURIComponent(c.split('=')[1].trim()):null;
      if(t&&v.indexOf(t)!==-1) document.documentElement.setAttribute('data-theme',t);
    }());
  </script>
  <script id="livreur-info" type="application/json" set:html={JSON.stringify({ name: livreurName, username: user.username })} />
</head>

<body class="bg-base-200" style="min-height:100dvh;padding-bottom:72px;">

  <!-- Navbar -->
  <nav class="navbar bg-base-100 shadow-md sticky top-0 z-50 px-3">
    <div class="flex-1 flex items-center gap-2 min-w-0">
      <img src={logoUrl} alt="Logo" class="w-9 h-9 rounded-lg object-contain shrink-0"
        onerror="this.src='/favicon.ico'" />
      <div class="min-w-0">
        <p class="font-bold text-sm leading-none truncate">{restaurantName}</p>
        <p class="text-xs text-base-content/50 truncate">{livreurName}</p>
      </div>
    </div>
    <div class="flex-none flex items-center gap-2">
      <span id="newBadge" class="badge badge-warning badge-lg font-bold hidden"></span>
      <span id="refreshSpinner" class="loading loading-spinner loading-sm text-primary hidden"></span>
    </div>
  </nav>

  <!-- Stats -->
  <div class="stats stats-horizontal shadow w-full bg-base-100 text-sm border-b border-base-200">
    <div class="stat p-3">
      <div class="stat-title text-xs">Disponibles</div>
      <div class="stat-value text-warning text-2xl" id="cntDispo">—</div>
    </div>
    <div class="stat p-3">
      <div class="stat-title text-xs">Mes livraisons</div>
      <div class="stat-value text-info text-2xl" id="cntMines">—</div>
    </div>
    <div class="stat p-3">
      <div class="stat-title text-xs">Livrées aujourd'hui</div>
      <div class="stat-value text-success text-2xl" id="cntToday">—</div>
    </div>
  </div>

  <!-- Filtres -->
  <div class="px-3 py-2 bg-base-100 border-b border-base-200 flex gap-2">
    <select id="filterAffichage" class="select select-bordered select-sm flex-1">
      <option value="all">Toutes</option>
      <option value="mine">Mes livraisons</option>
      <option value="available">Disponibles</option>
    </select>
    <select id="filterTri" class="select select-bordered select-sm flex-1">
      <option value="oldest">Plus anciennes</option>
      <option value="recent">Plus récentes</option>
    </select>
  </div>

  <!-- Contenu -->
  <div class="p-3 space-y-3">
    <div id="loader" class="flex justify-center py-16">
      <span class="loading loading-spinner loading-lg text-primary"></span>
    </div>
    <div id="livraisonsList" class="hidden space-y-3"></div>
    <div id="emptyState" class="hidden text-center py-16">
      <p class="text-5xl mb-3">🚚</p>
      <h3 class="font-bold text-lg">Aucune livraison</h3>
      <p class="text-base-content/60 text-sm mt-1">Aucune commande à livrer pour le moment</p>
    </div>
  </div>

  <!-- Bottom nav -->
  <nav class="fixed bottom-0 left-0 right-0 bg-base-100 border-t border-base-200 z-50"
    style="padding-bottom:env(safe-area-inset-bottom,0);">
    <div class="flex">
      <a href="/livraison" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="text-xs font-medium">Accueil</span>
      </a>
      <a href="/livraison/historique" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-xs">Historique</span>
      </a>
      <a href="/logout" class="flex-1 flex flex-col items-center py-2 gap-0.5 text-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span class="text-xs">Déconnexion</span>
      </a>
    </div>
  </nav>

  <!-- Toast -->
  <div id="toasts" class="toast toast-top toast-end z-[9999] pointer-events-none" aria-live="polite"></div>

  <!-- Modal détail commande -->
  <dialog id="detailModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-lg p-0 overflow-hidden">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 z-10">✕</button>
      </form>

      <div class="p-5 space-y-4">
        <!-- En-tête -->
        <div class="flex justify-between items-start">
          <div>
            <h3 class="font-mono font-black text-2xl" id="mNumero">—</h3>
            <p class="text-base-content/60 text-sm" id="mDate">—</p>
          </div>
          <span class="badge badge-lg" id="mStatut">—</span>
        </div>

        <!-- Client -->
        <div class="card bg-base-200 card-compact">
          <div class="card-body gap-1">
            <p class="font-bold" id="mClient">—</p>
            <a id="mTelLink" href="#" class="link link-primary text-sm" id="mTel">—</a>
          </div>
        </div>

        <!-- Assigné à (si pas moi) -->
        <div id="mAssignedRow" class="alert alert-info text-sm py-2 hidden">
          Assignée à : <strong id="mAssignedTo">—</strong>
        </div>

        <!-- Adresse (visible si c'est ma livraison) -->
        <div id="mAdresseSection" class="hidden space-y-2">
          <div class="divider text-xs my-0">Adresse de livraison</div>
          <div class="card bg-success/10 card-compact">
            <div class="card-body gap-1">
              <p class="font-semibold text-sm" id="mAdresse">—</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button id="btnGPS" class="btn btn-success gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
              GPS
            </button>
            <button id="btnCopy" class="btn btn-outline gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copier
            </button>
          </div>
          <a id="btnCall" href="#" class="btn btn-info btn-block gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Appeler le client
          </a>
        </div>

        <!-- Articles -->
        <div id="mArticles" class="space-y-1 max-h-40 overflow-y-auto text-sm"></div>

        <div class="flex justify-between font-bold border-t border-base-200 pt-2">
          <span>Total</span>
          <span class="text-primary tabular-nums" id="mTotal">—</span>
        </div>

        <!-- Actions -->
        <div class="space-y-2 pt-1">
          <button id="btnAssigner" class="btn btn-primary btn-block hidden gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            M'assigner cette livraison
          </button>
          <button id="btnDesassigner" class="btn btn-warning btn-block hidden gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Me désassigner
          </button>
          <button id="btnLivree" class="btn btn-success btn-block hidden gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Marquer comme livrée ✓
          </button>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

  <!-- Modal confirmation -->
  <dialog id="confirmModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box">
      <h3 class="font-bold text-lg" id="confirmTitle">Confirmer</h3>
      <p class="py-2 text-sm text-base-content/70" id="confirmMsg">Êtes-vous sûr ?</p>
      <div class="modal-action">
        <form method="dialog"><button class="btn btn-ghost btn-sm">Annuler</button></form>
        <button class="btn btn-primary btn-sm" id="confirmYes">Confirmer</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>fermer</button></form>
  </dialog>

</body>
</html>

<style is:global>
  @media (pointer: coarse) { button, a { min-height: 44px; } }
</style>

<script>
  // ── Types ─────────────────────────────────────
  interface Article { nom: string; prix: number; quantite: number; supplements?: {name:string}[]; }
  interface Commande {
    id: string; numero: string; statut: string; type: string;
    date_creation: string; prix_total: number; notes?: string;
    client?: Record<string,any>; articles: Article[];
    livreur_id?: string; livreur_nom?: string;
  }

  // ── Helpers ───────────────────────────────────
  function getApiBase() {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'https://api.rareburger.be/api';
  }
  function getToken() {
    const c = document.cookie.split(';').find(x => x.trim().startsWith('admin_token='));
    return c ? decodeURIComponent(c.split('=')[1].trim()) : '';
  }
  function authH(): Record<string,string> {
    return { 'Authorization': `Bearer ${getToken()}`, 'Content-Type': 'application/json' };
  }
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style:'currency', currency:'EUR' }).format(n);
  function esc(v: unknown) {
    const d = document.createElement('div'); d.textContent = String(v ?? ''); return d.innerHTML;
  }
  function fmtDate(s: string) {
    try { return new Intl.DateTimeFormat('fr-BE', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' }).format(new Date(s)); }
    catch { return s; }
  }
  function q<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }
  function dialog(id: string) { return q<HTMLDialogElement>(id); }

  function showToast(msg: string, type: 'success'|'error'|'info'|'warning' = 'info') {
    const c = q('toasts');
    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow text-sm py-2 px-4 rounded-xl pointer-events-auto max-w-xs`;
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  async function apiFetch<T>(path: string, opts: RequestInit = {}): Promise<T> {
    const res = await fetch(`${getApiBase()}${path}`, opts);
    if (res.status === 401) { window.location.href = '/login'; throw new Error('401'); }
    if (!res.ok) { const b = await res.json().catch(() => ({})); throw new Error((b as any).error ?? `HTTP ${res.status}`); }
    return res.json() as Promise<T>;
  }

  function elapsed(s: string) {
    const diff = Math.floor((Date.now() - new Date(s).getTime()) / 60000);
    if (diff < 1)  return { text: "À l'instant", urgent: false };
    if (diff < 15) return { text: `${diff} min`, urgent: false };
    if (diff < 30) return { text: `${diff} min ⚠️`, urgent: true };
    const h = Math.floor(diff/60), m = diff%60;
    return { text: `${h}h${String(m).padStart(2,'0')} 🔴`, urgent: true };
  }

  // ── État ──────────────────────────────────────
  let livreurUsername = '';
  let commandes: Commande[] = [];
  let filtered: Commande[] = [];
  let filterMode = 'all';
  let filterSort = 'oldest';
  let currentId: string | null = null;
  let pendingAction: (() => Promise<void>) | null = null;
  let pollTimer: ReturnType<typeof setInterval> | null = null;
  let lastDispoCount = 0;

  // ── Init livreur info ─────────────────────────
  function initLivreurInfo() {
    try {
      const raw = document.getElementById('livreur-info')?.textContent?.trim();
      if (raw) livreurUsername = (JSON.parse(raw) as any).username ?? '';
    } catch {}
  }

  // ── Charger commandes ─────────────────────────
  async function load(silent = false) {
    if (!silent) q('refreshSpinner').classList.remove('hidden');
    try {
      const data = await apiFetch<{ commandes: Commande[] }>(
        '/commandes?per_page=200', { headers: authH() }
      );
      commandes = (data.commandes ?? []).filter(c =>
        c.type === 'livraison' && ['prete','en_livraison'].includes(c.statut)
      );

      // Son si nouvelle dispo
      const dispo = commandes.filter(c => !c.livreur_id).length;
      if (dispo > lastDispoCount && lastDispoCount > 0) playBeep();
      lastDispoCount = dispo;

      updateStats();
      applyFilters();
    } catch (err: unknown) {
      if (!silent) showToast(`Erreur : ${err instanceof Error ? err.message : ''}`, 'error');
    } finally {
      q('refreshSpinner').classList.add('hidden');
      q('loader').classList.add('hidden');
    }
  }

  // Son discret
  function playBeep() {
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!AC) return;
      const ctx = new AC();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.3, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(); osc.stop(ctx.currentTime + 0.3);
    } catch {}
  }

  // ── Stats ─────────────────────────────────────
  function updateStats() {
    const dispo = commandes.filter(c => !c.livreur_id).length;
    const mines = commandes.filter(c => c.livreur_id === livreurUsername).length;

    q('cntDispo').textContent  = String(dispo);
    q('cntMines').textContent  = String(mines);
    q('newBadge').textContent  = String(dispo);
    dispo > 0 ? q('newBadge').classList.remove('hidden') : q('newBadge').classList.add('hidden');

    // Livrées aujourd'hui — on appelle l'API archives pour avoir le vrai compte
    apiFetch<{ commandes: Commande[] }>(
      '/commandes/archives?period=today&statut=all', { headers: authH() }
    ).then(data => {
      const count = (data.commandes ?? []).filter(
        c => c.type === 'livraison' && c.statut === 'livree' && c.livreur_id === livreurUsername
      ).length;
      q('cntToday').textContent = String(count);
    }).catch(() => { q('cntToday').textContent = '—'; });
  }

  // ── Filtres ───────────────────────────────────
  function applyFilters() {
    filtered = commandes.filter(c => {
      if (filterMode === 'mine')      return c.livreur_id === livreurUsername;
      if (filterMode === 'available') return !c.livreur_id;
      return true;
    });
    filtered.sort((a, b) => {
      const diff = new Date(a.date_creation).getTime() - new Date(b.date_creation).getTime();
      return filterSort === 'oldest' ? diff : -diff;
    });
    render();
  }

  // ── Render liste ──────────────────────────────
  function render() {
    const list  = q('livraisonsList');
    const empty = q('emptyState');
    list.innerHTML = '';

    if (!filtered.length) {
      list.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    list.classList.remove('hidden');

    filtered.forEach(cmd => {
      const isMine     = cmd.livreur_id === livreurUsername;
      const isAssigned = !!cmd.livreur_id;
      const el_        = elapsed(cmd.date_creation);

      const card = document.createElement('div');
      card.className = `card bg-base-100 shadow cursor-pointer active:scale-[0.98] transition-transform`;
      card.innerHTML = `
        <div class="card-body p-4 gap-2">
          <div class="flex justify-between items-start">
            <h3 class="font-mono font-black text-xl">#${esc(cmd.numero)}</h3>
            <span class="text-xs ${el_.urgent ? 'text-error font-bold' : 'text-base-content/50'}">${esc(el_.text)}</span>
          </div>
          <div class="flex gap-1.5 flex-wrap">
            ${isMine
              ? '<span class="badge badge-info badge-sm">Ma livraison</span>'
              : isAssigned
                ? '<span class="badge badge-ghost badge-sm">Assignée</span>'
                : '<span class="badge badge-warning badge-sm">Disponible</span>'
            }
            <span class="badge badge-ghost badge-sm">${cmd.statut === 'en_livraison' ? 'En livraison' : 'Prête'}</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-base-content/60">${esc(cmd.client?.prenom ?? '')} ${esc(cmd.client?.nom ?? '')}</span>
            <span class="font-bold tabular-nums">${fmt(cmd.prix_total)}</span>
          </div>
        </div>
      `;
      card.addEventListener('click', () => openModal(cmd));
      list.appendChild(card);
    });
  }

  // ── Modal ─────────────────────────────────────
  function openModal(cmd: Commande) {
    currentId = cmd.id;
    const isMine     = cmd.livreur_id === livreurUsername;
    const isAssigned = !!cmd.livreur_id;
    const addr       = (cmd.client as any)?.adresse as Record<string,string>|undefined;
    const fullAddr   = addr ? `${addr.rue} ${addr.numero}, ${addr.code_postal} ${addr.ville}` : '';
    const tel        = (cmd.client as any)?.telephone ?? '';

    q('mNumero').textContent  = `#${cmd.numero}`;
    q('mDate').textContent    = fmtDate(cmd.date_creation);
    q('mClient').textContent  = `${cmd.client?.prenom ?? ''} ${cmd.client?.nom ?? ''}`.trim() || 'Client';
    q<HTMLAnchorElement>('mTelLink').textContent = tel;
    q<HTMLAnchorElement>('mTelLink').href = `tel:${tel}`;
    q('mTotal').textContent   = fmt(cmd.prix_total);

    const statut = cmd.statut === 'en_livraison' ? 'En livraison' : 'Prête';
    q('mStatut').textContent  = statut;
    q('mStatut').className    = `badge badge-lg ${cmd.statut === 'en_livraison' ? 'badge-info' : 'badge-warning'}`;

    // Assigné à (si pas moi)
    if (isAssigned && !isMine) {
      q('mAssignedTo').textContent = cmd.livreur_nom ?? 'Un autre livreur';
      q('mAssignedRow').classList.remove('hidden');
    } else {
      q('mAssignedRow').classList.add('hidden');
    }

    // Adresse (seulement si c'est ma livraison)
    if (isMine && fullAddr) {
      q('mAdresse').textContent = fullAddr;
      q<HTMLAnchorElement>('btnCall').href = `tel:${tel}`;
      q('btnGPS').onclick = () => window.open(`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddr)}`, '_blank');
      q('btnCopy').onclick = () => {
        navigator.clipboard.writeText(fullAddr).then(() => showToast('Adresse copiée', 'success')).catch(() => {});
      };
      q('mAdresseSection').classList.remove('hidden');
    } else {
      q('mAdresseSection').classList.add('hidden');
    }

    // Articles — DOM propre
    const artEl = q('mArticles');
    artEl.innerHTML = '';
    cmd.articles.forEach(a => {
      const row = document.createElement('div');
      row.className = 'flex justify-between gap-2';
      row.innerHTML = `
        <span class="text-sm">${a.quantite}× ${esc(a.nom)}</span>
        <span class="font-semibold tabular-nums text-sm shrink-0">${fmt(a.prix * a.quantite)}</span>
      `;
      artEl.appendChild(row);
    });

    // Boutons actions
    q('btnAssigner').classList.add('hidden');
    q('btnDesassigner').classList.add('hidden');
    q('btnLivree').classList.add('hidden');

    if (!isAssigned) {
      q('btnAssigner').classList.remove('hidden');
    } else if (isMine) {
      if (cmd.statut === 'prete') q('btnDesassigner').classList.remove('hidden');
      if (cmd.statut === 'en_livraison') q('btnLivree').classList.remove('hidden');
    }

    dialog('detailModal').showModal();
  }

  // ── Actions ───────────────────────────────────
  function confirmAction(title: string, msg: string, fn: () => Promise<void>) {
    pendingAction = fn;
    q('confirmTitle').textContent = title;
    q('confirmMsg').textContent   = msg;
    q<HTMLButtonElement>('confirmYes').className = 'btn btn-primary btn-sm';
    dialog('confirmModal').showModal();
  }

  q('confirmYes')?.addEventListener('click', async () => {
    dialog('confirmModal').close();
    if (pendingAction) { await pendingAction(); pendingAction = null; }
  });

  q('btnAssigner')?.addEventListener('click', () => {
    confirmAction(
      "S'assigner la livraison",
      "Voulez-vous prendre en charge cette livraison ?",
      async () => {
        try {
          await apiFetch(`/commandes/${encodeURIComponent(currentId!)}/status`, {
            method: 'PUT', headers: authH(),
            body: JSON.stringify({ statut: 'en_livraison' }),
          });
          // Mettre à jour le livreur_id sur la commande
          await apiFetch(`/commandes/${encodeURIComponent(currentId!)}`, {
            method: 'PUT', headers: authH(),
            body: JSON.stringify({ livreur_id: livreurUsername }),
          });
          dialog('detailModal').close();
          showToast('Livraison assignée', 'success');
          await load(true);
        } catch (err: unknown) {
          showToast(`Erreur : ${err instanceof Error ? err.message : ''}`, 'error');
        }
      }
    );
  });

  q('btnDesassigner')?.addEventListener('click', () => {
    confirmAction(
      "Se désassigner",
      "Voulez-vous vous retirer de cette livraison ?",
      async () => {
        try {
          await apiFetch(`/commandes/${encodeURIComponent(currentId!)}/status`, {
            method: 'PUT', headers: authH(),
            body: JSON.stringify({ statut: 'prete' }),
          });
          await apiFetch(`/commandes/${encodeURIComponent(currentId!)}`, {
            method: 'PUT', headers: authH(),
            body: JSON.stringify({ livreur_id: null, livreur_nom: null }),
          });
          dialog('detailModal').close();
          showToast('Désassigné', 'info');
          await load(true);
        } catch (err: unknown) {
          showToast(`Erreur : ${err instanceof Error ? err.message : ''}`, 'error');
        }
      }
    );
  });

  q('btnLivree')?.addEventListener('click', () => {
    confirmAction(
      "Confirmer la livraison",
      "Le client a bien reçu sa commande ?",
      async () => {
        try {
          await apiFetch(`/commandes/${encodeURIComponent(currentId!)}/status`, {
            method: 'PUT', headers: authH(),
            body: JSON.stringify({ statut: 'livree' }),
          });
          dialog('detailModal').close();
          showToast('Livraison confirmée 🎉', 'success');
          await load(true);
        } catch (err: unknown) {
          showToast(`Erreur : ${err instanceof Error ? err.message : ''}`, 'error');
        }
      }
    );
  });

  // ── Filtres UI ────────────────────────────────
  q<HTMLSelectElement>('filterAffichage').addEventListener('change', e => {
    filterMode = (e.target as HTMLSelectElement).value;
    applyFilters();
  });
  q<HTMLSelectElement>('filterTri').addEventListener('change', e => {
    filterSort = (e.target as HTMLSelectElement).value;
    applyFilters();
  });

  // ── Polling ───────────────────────────────────
  function startPolling() {
    pollTimer = setInterval(() => void load(true), 15_000);
  }

  // ── Init ──────────────────────────────────────
  function init() {
    initLivreurInfo();
    void load();
    startPolling();
  }

  document.addEventListener('astro:page-load', init);
  window.addEventListener('beforeunload', () => { if (pollTimer) clearInterval(pollTimer); });
  init();
</script>