---
// src/pages/cart.astro
// ============================================
// 🛒 CMDOLA - Page Panier
// ============================================

import Navbar from '../components/Navbar.astro';
import api from '../lib/api';
import '../assets/app.css';
import { formatInTimeZone } from 'date-fns-tz';

const RESTAURANT_ID = import.meta.env.PUBLIC_DEFAULT_RESTAURANT_ID || 'rare-burger';

// ✅ Charger config et vérifier si ouvert (côté serveur)
let config: any = {};
let theme = 'light';
let logoUrl = '/favicon.ico';
let isOpen = false;

try {
  config = await api.config.get();
  theme = config.theme?.daisy || 'light';
  logoUrl = config.theme?.logo ? api.images.getUrl(config.theme.logo) : '/favicon.ico';
  
  // ✅ Vérifier si restaurant ouvert
  const TIMEZONE = 'Europe/Brussels';
  const now = new Date();
  
  const currentDay = formatInTimeZone(now, TIMEZONE, 'EEEE').toLowerCase();
  const currentTime = formatInTimeZone(now, TIMEZONE, 'HH:mm');
  
  const dayMap: Record<string, string> = {
    'monday': 'lundi',
    'tuesday': 'mardi', 
    'wednesday': 'mercredi',
    'thursday': 'jeudi',
    'friday': 'vendredi',
    'saturday': 'samedi',
    'sunday': 'dimanche'
  };
  
  const currentDayFr = dayMap[currentDay] || currentDay;
  const currentSchedule = config.horaires?.[currentDayFr] || [];
  
  function timeToMinutes(time: string): number {
    const [hours, minutes] = time.split(':').map(Number);
    return hours * 60 + minutes;
  }
  
  const currentMinutes = timeToMinutes(currentTime);
  
  isOpen = currentSchedule.some((plage: any) => {
    const debutMinutes = timeToMinutes(plage.debut);
    const finMinutes = timeToMinutes(plage.fin);
    
    if (finMinutes < debutMinutes) {
      return currentMinutes >= debutMinutes || currentMinutes <= finMinutes;
    } else {
      return currentMinutes >= debutMinutes && currentMinutes <= finMinutes;
    }
  });
  
} catch (error) {
  console.error('❌ Erreur config:', error);
}
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow" />
  <title>Panier - CMDOLA</title>
  <link rel="icon" type="image/png" href={logoUrl}>
</head>

<body class="bg-base-200 min-h-screen">
  
  <!-- Navigation -->
  <Navbar />
  
  <!-- Alert si restaurant fermé -->
  {!isOpen && (
    <div class="container mx-auto px-4 mt-4">
      <div class="alert alert-warning shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h3 class="font-bold">Restaurant actuellement fermé</h3>
          <div class="text-sm">Vous pouvez préparer votre panier, mais la commande ne pourra être validée qu'à notre réouverture.</div>
        </div>
      </div>
    </div>
  )}
  
  <!-- Contenu panier -->
  <div class="container mx-auto px-4 py-8">
    
    <!-- Titre -->
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold">Mon Panier</h1>
      <button id="clear-cart-btn" class="btn btn-ghost btn-sm text-error">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Vider le panier
      </button>
    </div>

    <!-- Grid 2 colonnes : articles + résumé -->
    <div class="grid lg:grid-cols-3 gap-6">
      
      <!-- Articles (2/3) -->
      <div class="lg:col-span-2">
        <div id="cart-items" class="space-y-4">
          <!-- Rempli par JavaScript -->
          <div class="flex justify-center py-12">
            <span class="loading loading-spinner loading-lg"></span>
          </div>
        </div>
        
        <!-- Message panier vide -->
        <div id="empty-cart" class="card bg-base-100 shadow-sm" style="display: none;">
          <div class="card-body text-center py-12">
            <div class="text-6xl mb-4">🛒</div>
            <h2 class="text-2xl font-bold mb-2">Votre panier est vide</h2>
            <p class="text-base-content/60 mb-6">Ajoutez des produits pour commencer</p>
            <a href="/menu" class="btn btn-primary">
              Voir le menu
            </a>
          </div>
        </div>
      </div>

      <!-- Résumé commande (1/3) -->
      <div class="lg:col-span-1">
        <div class="card bg-base-100 shadow-sm sticky top-4">
          <div class="card-body">
            <h2 class="card-title">Résumé</h2>
            <div class="divider my-2"></div>
            
            <!-- Détails -->
            <div class="space-y-3">
              <div class="flex justify-between">
                <span>Sous-total</span>
                <span id="subtotal" class="font-semibold">0.00€</span>
              </div>
              
              <div class="divider my-2"></div>
              
              <div class="flex justify-between text-lg">
                <span class="font-bold">Total</span>
                <span id="total" class="font-bold text-primary">0.00€</span>
              </div>
              
              <div class="alert alert-info">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-sm">Les frais seront calculés au checkout</span>
              </div>
            </div>
            
            <div class="divider my-2"></div>
            
            <!-- Bouton commander -->
            <button id="checkout-btn" class="btn btn-primary btn-block" data-is-open={isOpen}>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Commander
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="toast toast-top toast-end z-50"></div>

</body>
</html>

<script define:vars={{ isOpen }}>
  // ============================================
  // 🛒 Gestion du panier - Script consolidé
  // ============================================
  
  let cart = [];

  // Formater le prix
  function formatPrice(price) {
    return new Intl.NumberFormat('fr-BE', {
      style: 'currency',
      currency: 'EUR',
    }).format(price);
  }

  // Charger le panier
  function loadCart() {
    cart = JSON.parse(localStorage.getItem('cart') || '[]');
    renderCart();
    updateSummary();
  }

  // Afficher les articles
  function renderCart() {
    const cartItems = document.getElementById('cart-items');
    const emptyCart = document.getElementById('empty-cart');
    
    if (cart.length === 0) {
      cartItems.style.display = 'none';
      emptyCart.style.display = 'block';
      return;
    }
    
    cartItems.style.display = 'block';
    emptyCart.style.display = 'none';
    
    cartItems.innerHTML = cart.map((item, index) => `
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4">
          <div class="flex gap-4">
            
            <!-- Infos produit -->
            <div class="flex-1">
              <h3 class="font-bold text-lg">${escapeHtml(item.nom)}</h3>
              
              <!-- Suppléments -->
              ${item.supplements && item.supplements.length > 0 ? `
                <div class="text-sm text-base-content/70 mt-1">
                  <span class="font-semibold">Avec:</span> ${item.supplements.map(s => escapeHtml(s.name)).join(', ')}
                </div>
              ` : ''}
              
              <!-- Ingrédients retirés -->
              ${item.removed_ingredients && item.removed_ingredients.length > 0 ? `
                <div class="text-sm text-base-content/70 mt-1">
                  <span class="font-semibold">Sans:</span> ${item.removed_ingredients.map(i => escapeHtml(i)).join(', ')}
                </div>
              ` : ''}
              
              <!-- Prix unitaire -->
              <div class="text-sm text-base-content/60 mt-2">
                ${formatPrice(item.prix)} / unité
              </div>
            </div>
            
            <!-- Quantité et actions -->
            <div class="flex flex-col items-end justify-between">
              <!-- Prix total -->
              <div class="text-lg font-bold text-primary">
                ${formatPrice(item.prix * item.quantite)}
              </div>
              
              <!-- Contrôles quantité -->
              <div class="flex items-center gap-2">
                <button class="btn btn-sm btn-circle btn-decrease" data-index="${index}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                  </svg>
                </button>
                <span class="font-semibold w-8 text-center">${item.quantite}</span>
                <button class="btn btn-sm btn-circle btn-increase" data-index="${index}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
                <button class="btn btn-sm btn-ghost btn-circle text-error btn-remove" data-index="${index}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    `).join('');
    
    // ✅ Event delegation - Attacher les événements après le rendu
    attachCartEvents();
  }

  // ✅ Échapper le HTML pour éviter les injections XSS
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ✅ Event delegation - Propre et performant
  function attachCartEvents() {
    // Boutons diminuer quantité
    document.querySelectorAll('.btn-decrease').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt(btn.dataset.index);
        changeQuantity(index, -1);
      });
    });
    
    // Boutons augmenter quantité
    document.querySelectorAll('.btn-increase').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt(btn.dataset.index);
        changeQuantity(index, 1);
      });
    });
    
    // Boutons supprimer
    document.querySelectorAll('.btn-remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt(btn.dataset.index);
        removeItem(index);
      });
    });
  }

  // Mettre à jour le résumé
  function updateSummary() {
    const subtotal = cart.reduce((sum, item) => sum + (item.prix * item.quantite), 0);
    
    document.getElementById('subtotal').textContent = formatPrice(subtotal);
    document.getElementById('total').textContent = formatPrice(subtotal);
  }

  // Changer quantité
  function changeQuantity(index, delta) {
    cart[index].quantite += delta;
    
    if (cart[index].quantite <= 0) {
      cart.splice(index, 1);
    }
    
    saveCart();
  }

  // Supprimer article
  function removeItem(index) {
    cart.splice(index, 1);
    saveCart();
  }

  // Vider le panier
  document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
    if (confirm('Êtes-vous sûr de vouloir vider le panier ?')) {
      cart = [];
      saveCart();
    }
  });

  // Sauvegarder et recharger
  function saveCart() {
    localStorage.setItem('cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-updated'));
    loadCart();
  }

  // ✅ Bouton commander avec vérification ouverture
  document.getElementById('checkout-btn')?.addEventListener('click', () => {
    // Vérifier qu'il y a des articles
    if (cart.length === 0) {
      showToast('Votre panier est vide', 'warning');
      return;
    }
    
    // ✅ Vérifier si le restaurant est ouvert
    if (!isOpen) {
      showToast('Le restaurant est actuellement fermé. Les commandes seront disponibles lors de notre prochaine ouverture.', 'error');
      return;
    }
    
    // Redirection vers checkout
    window.location.href = '/checkout';
  });

  // Fonction toast
  function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `alert alert-${type} shadow-lg`;
    toast.innerHTML = `
      <div>
        <span>${message}</span>
      </div>
    `;
    
    const container = document.getElementById('toast-container');
    container.appendChild(toast);
    
    setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  // Charger au démarrage
  document.addEventListener('astro:page-load', loadCart);
  loadCart();
</script>