---
// src/pages/menu.astro
// ============================================
// 🍽️ CMDOLA - Page Menu Complète
// ============================================

import Navbar from '../components/Navbar.astro';
import CategorySelector from '../components/CategorySelector.astro';
import ProductGrid from '../components/ProductGrid.astro';
import api from '../lib/api';
import "../assets/app.css";
import { formatInTimeZone } from 'date-fns-tz';

// Récupérer les suppléments et la config
let supplements = [];
let config: any = {};
let isOpen = false; // ✅ Par défaut fermé en cas d'erreur
let nextOpening = '';
let currentSchedule: any[] = [];
let theme = 'light';
let logoUrl = '/favicon.ico';

try {
  // ⚡ Charger menu ET config EN PARALLÈLE (au lieu de l'un après l'autre)
  const [menu, config] = await Promise.all([
    api.menu.get(),
    api.config.get()
  ]);
  
  // Extraire les suppléments et le thème
  supplements = menu.supplements || [];
  theme = config.theme?.daisy || 'light';
  logoUrl = config.theme?.logo ? api.images.getUrl(config.theme.logo) : '/favicon.ico';
  
  // ✅ Gestion du fuseau horaire
  const TIMEZONE = 'Europe/Brussels';
  const now = new Date();
  
  const currentDay = formatInTimeZone(now, TIMEZONE, 'EEEE').toLowerCase();
  const currentTime = formatInTimeZone(now, TIMEZONE, 'HH:mm');
  
  // Mapper les jours anglais vers français
  const dayMap: Record<string, string> = {
    'monday': 'lundi',
    'tuesday': 'mardi', 
    'wednesday': 'mercredi',
    'thursday': 'jeudi',
    'friday': 'vendredi',
    'saturday': 'samedi',
    'sunday': 'dimanche'
  };
  
  const currentDayFr = dayMap[currentDay] || currentDay;
  currentSchedule = config.horaires?.[currentDayFr] || [];
  
  console.log(`🕐 ${currentDayFr} ${currentTime} | Horaires:`, currentSchedule);
  
  // ✅ Fonction de comparaison d'heures
  function timeToMinutes(time: string): number {
    const [hours, minutes] = time.split(':').map(Number);
    return hours * 60 + minutes;
  }
  
  const currentMinutes = timeToMinutes(currentTime);
  
  // Vérifier si l'heure actuelle est dans une des plages
  isOpen = currentSchedule.some((plage: any) => {
    const debutMinutes = timeToMinutes(plage.debut);
    const finMinutes = timeToMinutes(plage.fin);
    
    if (finMinutes < debutMinutes) {
      return currentMinutes >= debutMinutes || currentMinutes <= finMinutes;
    } else {
      return currentMinutes >= debutMinutes && currentMinutes <= finMinutes;
    }
  });
  
  console.log(`✅ Restaurant ${isOpen ? 'OUVERT' : 'FERMÉ'}`);
  
  // Si fermé, trouver la prochaine ouverture
  if (!isOpen && currentSchedule.length > 0) {
    const nextSlot = currentSchedule.find((plage: any) => {
      const debutMinutes = timeToMinutes(plage.debut);
      return currentMinutes < debutMinutes;
    });
    
    if (nextSlot) {
      nextOpening = `Ouverture aujourd'hui à ${nextSlot.debut}`;
    } else {
      // Chercher le lendemain
      const dayNames = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
      const tomorrowDate = new Date(now);
      tomorrowDate.setDate(tomorrowDate.getDate() + 1);
      const tomorrowIndex = parseInt(formatInTimeZone(tomorrowDate, TIMEZONE, 'i')) % 7;
      const tomorrowDay = dayNames[tomorrowIndex];
      const tomorrowSchedule = config.horaires?.[tomorrowDay] || [];
      if (tomorrowSchedule.length > 0) {
        const dayNamesFr = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        nextOpening = `Ouverture ${dayNamesFr[tomorrowIndex]} à ${tomorrowSchedule[0].debut}`;
      }
    }
  }
  
} catch (error) {
  console.error('❌ Erreur chargement:', error);
  supplements = [];
  // isOpen reste false par défaut
}

const cartItems = 0;
const cartTotal = 0;
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#1f2937">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Menu - CMDOLA</title>
  <link rel="icon" type="image/png" href={logoUrl}>
  
  <!-- Charger les suppléments IMMÉDIATEMENT -->
  <script is:inline define:vars={{ supplements }}>
    if (typeof window !== 'undefined') {
      window.allSupplements = supplements || [];
    }
  </script>
</head>

<body class="bg-base-200 min-h-screen">
  
  <!-- 🚧 MODAL MAINTENANCE (visible par défaut) -->
  <dialog class="modal modal-open backdrop-blur-sm">
    <div class="modal-box max-w-md text-center">
      <!-- Logo ou icône -->
      <div class="mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      
      <!-- Message -->
      <h2 class="text-2xl font-bold mb-4">Site en développement</h2>
      <p class="text-base-content/70 mb-2">
        Notre site est actuellement en cours de développement.
      </p>
      <p class="text-base-content/70 mb-6">
        Nous serons bientôt de retour !
      </p>
      
      <!-- Badge développeur -->
      <div class="badge badge-primary badge-lg gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        Développé par NSMobile
      </div>
      
      <!-- Optionnel : lien de contact -->
      <div class="mt-6">
        <a href="mailto:info@nsmobile.be" class="link link-primary text-sm">
          Nous contacter
        </a>
      </div>
    </div>
    
    <!-- Backdrop (arrière-plan) -->
    <div class="modal-backdrop bg-black/60"></div>
  </dialog>
  
  <!-- Le reste de ton code... -->
  <div class="navbar-wrapper">
    <Navbar 
      cartItems={cartItems}
      cartTotal={cartTotal}
    />
  </div>
  <!-- etc... -->


  <!-- Navigation avec support safe-area -->
  <div class="navbar-wrapper">
    <Navbar 
      cartItems={cartItems}
      cartTotal={cartTotal}
    />
  </div>
  
  <!-- Container principal avec padding adaptatif -->
  <main class="main-content">
    
    <!-- Alert si restaurant fermé -->
    {!isOpen && (
      <div class="alert-container">
        <div class="alert alert-warning shadow-lg" id="closed-alert">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div class="alert-content">
            <h3 class="font-bold text-sm sm:text-base">Restaurant actuellement fermé</h3>
            <div class="text-xs sm:text-sm" id="next-opening-text">{nextOpening || 'Consultez nos horaires'}</div>
          </div>
        </div>
      </div>
    )}
    
    <!-- Sélecteur de catégories -->
    <div class="category-wrapper">
      <CategorySelector 
        selectedCategory="all"
      />
    </div>
    
    <!-- Grille de produits -->
    <div class="products-wrapper">
      <ProductGrid 
        category="all"
        isOpen={isOpen}
      />
    </div>
    
  </main>
  
  <!-- Toast Container avec safe-area -->
  <div id="toast-container" class="toast toast-top toast-end toast-safe"></div>

</body>
</html>

<style>
  /* ============================================
   * 🎨 RESPONSIVE & SAFE AREA
   * ============================================ */
  
  :root {
    /* Variables CSS pour les safe areas */
    --sat: env(safe-area-inset-top);
    --sar: env(safe-area-inset-right);
    --sab: env(safe-area-inset-bottom);
    --sal: env(safe-area-inset-left);
  }

  body {
    animation: fadeIn 0.3s ease-in;
    /* Éviter le bounce sur iOS */
    overscroll-behavior-y: none;
    /* Hauteur réelle de la fenêtre (compatible iOS) */
    min-height: 100vh;
    min-height: -webkit-fill-available;
  }

  html {
    scroll-behavior: smooth;
    /* Hauteur réelle de la fenêtre */
    height: -webkit-fill-available;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ============================================
   * 📱 NAVBAR avec Safe Area
   * ============================================ */
  
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 40;
    /* Support notch iPhone */
    padding-top: var(--sat);
    background: inherit;
  }

  /* ============================================
   * 📦 CONTENEUR PRINCIPAL
   * ============================================ */
  
  .main-content {
    /* Espacement adaptatif pour mobile */
    padding-left: max(1rem, var(--sal));
    padding-right: max(1rem, var(--sar));
    padding-bottom: max(2rem, var(--sab));
    padding-top: 1rem;
  }

  /* Sur très petits écrans */
  @media (max-width: 640px) {
    .main-content {
      padding-left: max(0.75rem, var(--sal));
      padding-right: max(0.75rem, var(--sar));
      padding-top: 0.75rem;
    }
  }

  /* ============================================
   * 🚨 ALERT RESPONSIVE
   * ============================================ */
  
  .alert-container {
    margin-bottom: 1rem;
  }

  .alert {
    /* Meilleure lisibilité sur mobile */
    padding: 0.75rem;
    gap: 0.75rem;
  }

  .alert-content {
    flex: 1;
    min-width: 0; /* Permet au texte de se tronquer si nécessaire */
  }

  @media (max-width: 640px) {
    .alert {
      padding: 0.5rem;
      gap: 0.5rem;
      font-size: 0.875rem;
    }
    
    .alert svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  /* ============================================
   * 🏷️ CATEGORIES RESPONSIVE
   * ============================================ */
  
  .category-wrapper {
    margin-bottom: 1rem;
    /* Éviter le débordement horizontal */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* Cacher la scrollbar mais garder le scroll */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-wrapper::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 640px) {
    .category-wrapper {
      margin-left: -0.75rem;
      margin-right: -0.75rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  /* ============================================
   * 🍽️ GRILLE PRODUITS RESPONSIVE
   * ============================================ */
  
  .products-wrapper {
    /* La grille est gérée par ProductGrid, on optimise juste le container */
    width: 100%;
  }

  /* ============================================
   * 🔔 TOAST avec Safe Area
   * ============================================ */
  
  .toast-safe {
    /* Positionner en tenant compte du notch */
    top: calc(1rem + var(--sat)) !important;
    right: max(1rem, var(--sar)) !important;
  }

  @media (max-width: 640px) {
    .toast-safe {
      /* Plus proche du bord sur mobile */
      right: max(0.5rem, var(--sar)) !important;
      top: calc(0.5rem + var(--sat)) !important;
      /* Largeur adaptative */
      max-width: calc(100vw - max(1rem, var(--sar)) - max(1rem, var(--sal)));
    }
  }

  /* ============================================
   * 🎯 TOUCH TARGETS (Accessibilité mobile)
   * ============================================ */
  
  /* Minimum 44x44px pour les zones tactiles (Apple HIG) */
  @media (max-width: 640px) {
    button, a, .btn {
      min-height: 44px;
      min-width: 44px;
    }
  }

  /* ============================================
   * 📐 ORIENTATION LANDSCAPE MOBILE
   * ============================================ */
  
  @media (max-width: 915px) and (orientation: landscape) {
    .main-content {
      /* Réduire les marges en paysage */
      padding-top: 0.5rem;
      padding-bottom: 1rem;
    }
    
    .alert-container {
      margin-bottom: 0.5rem;
    }
  }

  /* ============================================
   * 🔧 FIX iOS Safari
   * ============================================ */
  
  /* Éviter le zoom sur focus des inputs */
  @media (max-width: 640px) {
    input, select, textarea {
      font-size: 16px !important;
    }
  }

  /* Smooth scrolling pour iOS */
  * {
    -webkit-tap-highlight-color: transparent;
  }
</style>

<script define:vars={{ isOpen: isOpen, config }}>
  // ============================================
  // 🎯 Script consolidé - Panier + Auto-refresh
  // ============================================
  
  // Mise à jour du badge panier
  function updateCartBadge() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const totalItems = cart.reduce((sum, item) => sum + item.quantite, 0);
    const totalPrice = cart.reduce((sum, item) => sum + (item.prix * item.quantite), 0);
    
    const badge = document.querySelector('.indicator-item');
    if (badge) {
      badge.textContent = totalItems.toString();
      badge.style.display = totalItems > 0 ? 'inline-flex' : 'none';
    }
    
    const itemsText = document.querySelector('.card-body .text-lg');
    if (itemsText) {
      itemsText.textContent = `${totalItems} Article${totalItems > 1 ? 's' : ''}`;
    }
    
    const priceText = document.querySelector('.card-body .text-info');
    if (priceText) {
      const formatted = new Intl.NumberFormat('fr-BE', {
        style: 'currency',
        currency: 'EUR',
      }).format(totalPrice);
      priceText.textContent = `Sous-total: ${formatted}`;
    }
  }

  // ✅ Fonction de vérification du statut ouvert/fermé
  function checkOpenStatus() {
    const now = new Date();
    const belgianTime = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Brussels' }));
    
    const dayNames = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
    const currentDay = dayNames[belgianTime.getDay()];
    const currentTime = `${String(belgianTime.getHours()).padStart(2, '0')}:${String(belgianTime.getMinutes()).padStart(2, '0')}`;
    
    const currentSchedule = config.horaires?.[currentDay] || [];
    
    function timeToMinutes(time) {
      const [hours, minutes] = time.split(':').map(Number);
      return hours * 60 + minutes;
    }
    
    const currentMinutes = timeToMinutes(currentTime);
    
    const nowOpen = currentSchedule.some((plage) => {
      const debutMinutes = timeToMinutes(plage.debut);
      const finMinutes = timeToMinutes(plage.fin);
      
      if (finMinutes < debutMinutes) {
        return currentMinutes >= debutMinutes || currentMinutes <= finMinutes;
      } else {
        return currentMinutes >= debutMinutes && currentMinutes <= finMinutes;
      }
    });
    
    // Si le statut a changé, recharger la page
    if (nowOpen !== isOpen) {
      console.log('🔄 Statut changé, rechargement...');
      window.location.reload();
    }
  }

  // ✅ Bloquer les commandes si restaurant fermé
  function updateButtonsState() {
    if (!isOpen) {
      document.querySelectorAll('.btn-primary').forEach(btn => {
        if (btn.textContent.includes('Voir détails') || btn.textContent.includes('Ajouter')) {
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-disabled');
          btn.disabled = true;
          btn.textContent = 'Restaurant fermé';
        }
      });
      
      // Bloquer l'ouverture du modal
      const originalOpenModal = window.openProductModal;
      if (originalOpenModal) {
        window.openProductModal = function() {
          alert('Le restaurant est actuellement fermé. Les commandes seront disponibles lors de notre prochaine ouverture.');
        };
      }
    }
  }

  // ============================================
  // 📱 OPTIMISATIONS MOBILE
  // ============================================
  
  // Détecter et gérer la hauteur de la barre d'adresse mobile
  function setViewportHeight() {
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', `${vh}px`);
  }

  // Au chargement et au resize
  window.addEventListener('resize', setViewportHeight);
  window.addEventListener('orientationchange', setViewportHeight);

  // Au chargement de la page
  document.addEventListener('astro:page-load', () => {
    updateCartBadge();
    updateButtonsState();
    setViewportHeight();
  });

  // Écouter les mises à jour du panier
  window.addEventListener('cart-updated', updateCartBadge);

  // ✅ Auto-refresh toutes les minutes pour vérifier le statut
  setInterval(checkOpenStatus, 60000); // 60 secondes
</script>