---
// src/pages/menu.astro
import Navbar from '../components/Navbar.astro';
import CategorySelector from '../components/CategorySelector.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductModal from '../components/ProductModal.astro';
import api from '../lib/api';
import '../assets/app.css';

// ─────────────────────────────────────────
// Types locaux
// ─────────────────────────────────────────
interface Category {
  id: string;
  name: string;
  icon?: string;
}

interface TimeSlot {
  debut: string;
  fin: string;
}

// ─────────────────────────────────────────
// Thème SSR — cookie en priorité
// ─────────────────────────────────────────
const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];

const cookieTheme = Astro.cookies.get('theme')?.value;

// ─────────────────────────────────────────
// État initialisé avec types explicites
// ─────────────────────────────────────────
let supplements: Record<string, unknown>[] = [];
let products: Record<string, unknown>[]    = [];
let categories: Category[]                 = [];
let restaurantConfig: Record<string, unknown> = {};
let theme      = 'light';
let logoUrl    = '/favicon.ico';
let isOpen     = false;
let nextOpening = '';
let hasError   = false;

// ─────────────────────────────────────────
// Helpers horaires (SSR)
// ─────────────────────────────────────────
function timeToMinutes(t: string): number {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
}

const DAY_NAMES_FR: readonly string[]         = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
const DAY_NAMES_FR_DISPLAY: readonly string[] = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];

function computeOpenStatus(horaires: Record<string, TimeSlot[]>): { open: boolean; next: string } {
  const now      = new Date();
  const bruxDate = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Brussels' }));
  const dayFr    = DAY_NAMES_FR[bruxDate.getDay()] ?? 'lundi';
  const timeStr  = `${String(bruxDate.getHours()).padStart(2, '0')}:${String(bruxDate.getMinutes()).padStart(2, '0')}`;
  const nowMin   = timeToMinutes(timeStr);
  const schedule = horaires[dayFr] ?? [];

  const open = schedule.some(({ debut, fin }) => {
    const d = timeToMinutes(debut);
    const f = timeToMinutes(fin);
    return f < d ? nowMin >= d || nowMin <= f : nowMin >= d && nowMin <= f;
  });

  let next = '';
  if (!open) {
    const nextSlot = schedule.find(({ debut }) => timeToMinutes(debut) > nowMin);
    if (nextSlot) {
      next = `Ouverture aujourd'hui à ${nextSlot.debut}`;
    } else {
      for (let i = 1; i <= 6; i++) {
        const d = new Date(bruxDate);
        d.setDate(d.getDate() + i);
        const idx      = d.getDay();
        const daySlots = horaires[DAY_NAMES_FR[idx] ?? ''] ?? [];
        if (daySlots.length > 0) {
          next = `Ouverture ${DAY_NAMES_FR_DISPLAY[idx] ?? ''} à ${daySlots[0].debut}`;
          break;
        }
      }
    }
  }

  return { open, next };
}

// ─────────────────────────────────────────
// Chargement des données
// ─────────────────────────────────────────
try {
  const [menuData, configData] = await Promise.all([
    api.menu.get() as Promise<Record<string, unknown>>,
    api.config.get() as Promise<Record<string, unknown>>,
  ]);

  supplements      = (menuData.supplements as Record<string, unknown>[]) ?? [];
  products         = (menuData.produits    as Record<string, unknown>[]) ?? [];
  categories       = (menuData.categories  as Category[])                ?? [];
  restaurantConfig = configData;

  const configTheme = (configData.theme as Record<string, string> | undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme
    : (configTheme && VALID_THEMES.includes(configTheme) ? configTheme : 'light');

  const logoFilename = (configData.theme as Record<string, string> | undefined)?.logo;
  logoUrl = logoFilename ? api.images.getUrl(logoFilename) : '/favicon.ico';

  const horaires = (configData.horaires as Record<string, TimeSlot[]>) ?? {};
  const { open, next } = computeOpenStatus(horaires);
  isOpen      = open;
  nextOpening = next;

} catch (err: unknown) {
  console.error('Erreur chargement menu/config:', err);
  hasError = true;
}

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
const restaurantName: string = (restaurantConfig.nom as string | undefined) ?? 'CMDOLA';
const restaurantTel: string  = (restaurantConfig.telephone as string | undefined) ?? '';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#1f2937" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <!-- URL API exposée au client via meta — évite les globals window -->
  <meta name="api-url" content={apiBaseUrl} />
  <title>Menu — {restaurantName}</title>
  <link rel="icon" type="image/png" href={logoUrl} />

  <!--
    Anti-FOUC thème : script is:inline exécuté avant le rendu CSS.
    is:inline = pas de bundling Astro, pas de déduplication — intentionnel ici
    car on a besoin qu'il soit en tête de page, avant tout style.
  -->
  <script is:inline>
    (function () {
      var valid = [
        'light','dark','cupcake','bumblebee','emerald','corporate',
        'synthwave','retro','cyberpunk','valentine','halloween','garden',
        'forest','aqua','lofi','pastel','fantasy','wireframe','black',
        'luxury','dracula','cmyk','autumn','business','acid','lemonade',
        'night','coffee','winter','dim','nord','sunset',
      ];
      var cookie = document.cookie.split(';').find(function (c) {
        return c.trim().startsWith('theme=');
      });
      var t = cookie ? decodeURIComponent(cookie.split('=')[1].trim()) : null;
      if (t && valid.indexOf(t) !== -1) {
        document.documentElement.setAttribute('data-theme', t);
      }
    }());
  </script>

  <!--
    Suppléments en JSON brut via set:html — évite tout problème d'encodage
    d'attribut HTML (apostrophes, guillemets dans les noms de suppléments).
    Le second script is:inline lit et expose window.allSupplements.
  -->
  <script id="supplements-data" type="application/json" set:html={JSON.stringify(supplements)} />
  <script is:inline>
    (function () {
      var el = document.getElementById('supplements-data');
      try {
        window.allSupplements = el ? JSON.parse(el.textContent || '[]') : [];
      } catch (_) {
        window.allSupplements = [];
      }
    }());
  </script>
</head>

<body class="bg-base-200" style="min-height: 100dvh; min-height: 100vh;">

  <header class="sticky top-0 z-40" style="padding-top: env(safe-area-inset-top, 0px);">
    <Navbar
      restaurantName={restaurantName}
      logoUrl={logoUrl}
      activePage="menu"
    />
  </header>

  <main class="main-content">

    {!isOpen && (
      <div
        class="alert alert-warning shadow-md mb-4 rounded-2xl"
        role="alert"
        id="closed-alert"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
        <div class="min-w-0">
          <p class="font-bold text-sm sm:text-base">Restaurant actuellement fermé</p>
          <p class="text-xs sm:text-sm opacity-80">{nextOpening || 'Consultez nos horaires'}</p>
        </div>
      </div>
    )}

    <div class="category-scroll">
      <CategorySelector categories={categories} selectedCategory="all" />
    </div>

    <ProductGrid
      products={products}
      category="all"
      isOpen={isOpen}
      apiBaseUrl={apiBaseUrl}
      hasError={hasError}
      telephone={restaurantTel}
    />

  </main>

  <!-- Modal partagé — une seule instance pour toutes les cartes produit -->
  <ProductModal id="shared" />

  <div
    id="toast-container"
    class="toast toast-top toast-end z-50"
    aria-live="polite"
    aria-atomic="false"
  ></div>

</body>
</html>

<style>
  /* ── Safe areas ──────────────────────────────── */
  .main-content {
    padding-top: 1rem;
    padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    padding-inline: max(1rem, env(safe-area-inset-left, 0px));
  }

  @media (max-width: 640px) {
    .main-content {
      padding-inline: max(0.75rem, env(safe-area-inset-left, 0px));
      padding-top: 0.75rem;
    }
  }

  @media (max-width: 915px) and (orientation: landscape) {
    .main-content { padding-top: 0.5rem; }
  }

  /* ── Catégories scrollables ─────────────────── */
  .category-scroll {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-bottom: 1rem;
    /* Débord négatif pour toucher les bords sur mobile */
    margin-inline: calc(-1 * max(1rem, env(safe-area-inset-left, 0px)));
    padding-inline: max(1rem, env(safe-area-inset-left, 0px));
  }
  .category-scroll::-webkit-scrollbar { display: none; }

  /* ── Toast ──────────────────────────────────── */
  #toast-container {
    top: calc(1rem + env(safe-area-inset-top, 0px)) !important;
    right: max(1rem, env(safe-area-inset-right, 0px)) !important;
  }

  @media (max-width: 640px) {
    #toast-container {
      top: calc(0.5rem + env(safe-area-inset-top, 0px)) !important;
      right: max(0.5rem, env(safe-area-inset-right, 0px)) !important;
      max-width: calc(100vw - 1rem);
    }
  }

  /* ── Global ─────────────────────────────────── */
  html  { scroll-behavior: smooth; }
  body  {
    overscroll-behavior-y: none;
    -webkit-tap-highlight-color: transparent;
    animation: page-fade-in 0.2s ease-out;
  }

  @keyframes page-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Prévenir le zoom auto sur input iOS (<= 640px) */
  @media (max-width: 640px) {
    input, select, textarea { font-size: 16px !important; }
  }

  /* Touch targets Apple HIG (44px minimum) */
  @media (pointer: coarse) {
    button, a { min-height: 44px; }
  }
</style>

<!--
  Script client principal — bundlé par Astro (TypeScript natif, dédupliqué).
  PAS de is:inline ici → Astro le traite comme un module ES TypeScript.
-->
<script>
  // ── Types ─────────────────────────────────────
  interface CartItem {
    id: string;
    quantite: number;
    prix: number;
  }

  interface TimeSlot {
    debut: string;
    fin: string;
  }

  // ── Panier ────────────────────────────────────
  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('cart') ?? '[]') as CartItem[];
    } catch {
      return [];
    }
  }

  function updateCartUI(): void {
    const cart  = getCart();
    const total = cart.reduce((s, i) => s + i.quantite, 0);
    const price = cart.reduce((s, i) => s + i.prix * i.quantite, 0);

    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach(el => {
      el.textContent = String(total);
      el.style.display = total > 0 ? 'inline-flex' : 'none';
    });

    document.querySelectorAll<HTMLElement>('[data-cart-total]').forEach(el => {
      el.textContent = new Intl.NumberFormat('fr-BE', {
        style: 'currency',
        currency: 'EUR',
      }).format(price);
    });
  }

  // ── Helpers horaires (client) ─────────────────
  function timeToMin(t: string): number {
    const [h, m] = t.split(':').map(Number);
    return (h ?? 0) * 60 + (m ?? 0);
  }

  function isOpenNow(horaires: Record<string, TimeSlot[]>): boolean {
    const now  = new Date();
    const brux = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Brussels' }));
    const days: readonly string[] = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
    const day  = days[brux.getDay()] ?? 'lundi';
    const cur  = timeToMin(
      `${String(brux.getHours()).padStart(2, '0')}:${String(brux.getMinutes()).padStart(2, '0')}`
    );
    return (horaires[day] ?? []).some(({ debut, fin }) => {
      const d = timeToMin(debut);
      const f = timeToMin(fin);
      return f < d ? cur >= d || cur <= f : cur >= d && cur <= f;
    });
  }

  // ── Utilitaire API URL ────────────────────────
  function getApiBase(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }

  // ── Toast (DOM, pas de innerHTML) ────────────
  function showToast(
    message: string,
    type: 'info' | 'warning' | 'success' | 'error',
    duration = 6000
  ): HTMLElement | null {
    const container = document.getElementById('toast-container');
    if (!container) return null;

    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow-lg mb-2 max-w-xs sm:max-w-sm`;
    el.textContent = message;
    container.appendChild(el);
    setTimeout(() => el.remove(), duration);
    return el;
  }

  function showStatusToast(isNowOpen: boolean): HTMLElement | null {
    const container = document.getElementById('toast-container');
    if (!container) return null;

    const el    = document.createElement('div');
    el.className = `alert ${isNowOpen ? 'alert-success' : 'alert-warning'} shadow-lg mb-2 flex items-center gap-2`;

    const text  = document.createElement('div');
    text.className = 'flex-1';

    const title = document.createElement('p');
    title.className   = 'font-bold text-sm';
    title.textContent = isNowOpen ? 'Restaurant ouvert !' : 'Restaurant fermé';

    const sub   = document.createElement('p');
    sub.className   = 'text-xs opacity-80';
    sub.textContent = 'Le statut a changé';

    const btn   = document.createElement('button');
    btn.className   = 'btn btn-xs btn-primary ml-2';
    btn.textContent = 'Actualiser';
    btn.addEventListener('click', () => window.location.reload());

    text.appendChild(title);
    text.appendChild(sub);
    el.appendChild(text);
    el.appendChild(btn);
    container.appendChild(el);

    setTimeout(() => el.remove(), 30000);
    return el;
  }

  // ── Polling statut ouverture ──────────────────
  // Variables de module — réinitialisées à chaque init()
  let lastKnownOpen: boolean | null = null;
  let hasUpdateToast                = false;
  let pollIntervals: ReturnType<typeof setInterval>[] = [];

  async function pollOpenStatus(): Promise<void> {
    try {
      const res = await fetch(`${getApiBase()}/config`);
      if (!res.ok) return;

      const cfg  = await res.json() as { horaires?: Record<string, TimeSlot[]> };
      const open = isOpenNow(cfg.horaires ?? {});

      if (lastKnownOpen === null) { lastKnownOpen = open; return; }
      if (open === lastKnownOpen) return;

      lastKnownOpen = open;

      const modalOpen = !!document.querySelector('dialog[open]');
      const cartEmpty = getCart().length === 0;

      if (!modalOpen && cartEmpty) {
        window.location.reload();
        return;
      }

      if (hasUpdateToast) return;
      hasUpdateToast = true;

      const toast = showStatusToast(open);
      if (toast) {
        // MutationObserver pour détecter la suppression du toast et réarmer le flag
        const observer = new MutationObserver(() => {
          if (!document.contains(toast)) {
            hasUpdateToast = false;
            observer.disconnect();
          }
        });
        observer.observe(
          document.getElementById('toast-container') ?? document.body,
          { childList: true, subtree: true }
        );
      }
    } catch {
      // Silencieux — réseau indisponible
    }
  }

  // ── Polling disponibilité produits ───────────
  async function pollProductAvailability(): Promise<void> {
    try {
      const res = await fetch(`${getApiBase()}/menu`);
      if (!res.ok) return;

      const menu    = await res.json() as { produits?: { id: string; disponible: boolean }[] };
      let   changed = false;

      for (const product of (menu.produits ?? [])) {
        const card = document.querySelector<HTMLElement>(`[data-product-id="${product.id}"]`);
        if (!card) continue;

        const wasAvailable = card.dataset.available === 'true';
        if (product.disponible === wasAvailable) continue;

        card.dataset.available = String(product.disponible);
        changed = true;

        // Mettre à jour le bouton CTA
        const btn = card.querySelector<HTMLButtonElement>('.btn-open-modal, .btn-disabled');
        if (btn) {
          btn.disabled = !product.disponible;
          btn.classList.toggle('btn-primary',    product.disponible);
          btn.classList.toggle('btn-open-modal', product.disponible);
          btn.classList.toggle('btn-disabled',   !product.disponible);
          btn.textContent = product.disponible ? 'Commander' : 'Victime de son succès';
        }

        // Overlay épuisé
        const figure = card.querySelector('figure');
        const badge  = card.querySelector<HTMLElement>('[data-unavailable-badge]');

        if (!product.disponible && figure && !badge) {
          const overlay = document.createElement('div');
          overlay.dataset.unavailableBadge = '';
          overlay.className = 'absolute inset-0 bg-base-300/60 flex items-center justify-center';
          const span = document.createElement('span');
          span.className   = 'badge badge-error badge-lg';
          span.textContent = 'Épuisé';
          overlay.appendChild(span);
          figure.appendChild(overlay);
        } else if (product.disponible && badge) {
          badge.remove();
        }
      }

      if (changed) {
        showToast('Le menu a été mis à jour', 'info', 6000);
      }
    } catch {
      // Silencieux
    }
  }

  // ── Init / cleanup ────────────────────────────
  function init(): void {
    updateCartUI();

    // Nettoyer les intervalles précédents (View Transitions)
    pollIntervals.forEach(clearInterval);
    pollIntervals = [];

    lastKnownOpen  = null;
    hasUpdateToast = false;

    // Délai initial pour ne pas surcharger le chargement de page
    const timeout = setTimeout(() => {
      void pollOpenStatus();
      pollIntervals.push(
        setInterval(() => void pollOpenStatus(),          2 * 60 * 1000),
        setInterval(() => void pollProductAvailability(), 3 * 60 * 1000)
      );
    }, 5000);

    // Nettoyer aussi le timeout si une navigation intervient avant 5s
    document.addEventListener('astro:before-preparation', () => {
      clearTimeout(timeout);
    }, { once: true });
  }

  // Compatible Astro View Transitions
  document.addEventListener('astro:page-load', init);
  window.addEventListener('cart-updated', updateCartUI);
</script>

<!--
  setTheme — is:inline pour qu'il soit accessible depuis n'importe quel composant
  sans dépendre du bundling Astro. Doit correspondre à la liste dans env.d.ts.
-->
<script is:inline>
  window.setTheme = function (name) {
    var valid = [
      'light','dark','cupcake','bumblebee','emerald','corporate',
      'synthwave','retro','cyberpunk','valentine','halloween','garden',
      'forest','aqua','lofi','pastel','fantasy','wireframe','black',
      'luxury','dracula','cmyk','autumn','business','acid','lemonade',
      'night','coffee','winter','dim','nord','sunset',
    ];
    if (valid.indexOf(name) === -1) return;
    document.documentElement.setAttribute('data-theme', name);
    var maxAge = 60 * 60 * 24 * 365;
    document.cookie = 'theme=' + name + '; max-age=' + maxAge + '; path=/; SameSite=Lax';
    try { localStorage.setItem('theme', name); } catch (_) {}
  };
</script>