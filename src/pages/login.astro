---
// src/pages/login.astro
export const prerender = false;

import api from '../lib/api';
import '../assets/app.css';

// Thème SSR
const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];
const cookieTheme = Astro.cookies.get('theme')?.value;

let theme          = 'light';
let logoUrl        = '/favicon.ico';
let restaurantName = 'CMDOLA';

try {
  const cfg = await api.config.get() as Record<string,any>;
  const t   = (cfg.theme as Record<string,string>|undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme
    : (t && VALID_THEMES.includes(t) ? t : 'light');
  const logoFile = (cfg.theme as Record<string,string>|undefined)?.logo;
  logoUrl        = logoFile ? api.images.getUrl(logoFile) : '/favicon.ico';
  restaurantName = (cfg.nom as string|undefined) ?? 'CMDOLA';
} catch {}

// Lire les paramètres URL
const redirectParam = Astro.url.searchParams.get('redirect') ?? '';
const expired       = Astro.url.searchParams.get('expired') === '1';

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'https://api.rareburger.be/api';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="api-url" content={apiBaseUrl} />
  <title>Connexion — {restaurantName}</title>
  <link rel="icon" type="image/png" href={logoUrl} />

  <script is:inline>
    (function(){
      var v=['light','dark','cupcake','bumblebee','emerald','corporate','synthwave','retro',
        'cyberpunk','valentine','halloween','garden','forest','aqua','lofi','pastel','fantasy',
        'wireframe','black','luxury','dracula','cmyk','autumn','business','acid','lemonade',
        'night','coffee','winter','dim','nord','sunset'];
      var c=document.cookie.split(';').find(function(x){return x.trim().startsWith('theme=');});
      var t=c?decodeURIComponent(c.split('=')[1].trim()):null;
      if(t&&v.indexOf(t)!==-1) document.documentElement.setAttribute('data-theme',t);
    }());
  </script>

  <!-- Redirect destination + expired passés au script sans define:vars -->
  <meta name="login-redirect" content={redirectParam} />
  {expired && <meta name="login-expired" content="1" />}
</head>

<body class="min-h-screen bg-base-200 flex items-center justify-center p-4"
  style="min-height:100dvh;min-height:100vh;">

  <div class="w-full max-w-md">

    <!-- Logo + titre -->
    <div class="text-center mb-8">
      <img src={logoUrl} alt="Logo" id="logoImg"
        class="w-20 h-20 rounded-2xl shadow-xl object-contain mx-auto mb-4"
        onerror="this.src='/favicon.ico'" />
      <h1 class="text-3xl font-black text-primary">{restaurantName}</h1>
      <p class="text-base-content/60 text-sm mt-1">Espace professionnel</p>
    </div>

    <!-- Bannière session expirée -->
    {expired && (
      <div class="alert alert-warning mb-4 text-sm" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        Votre session a expiré. Reconnectez-vous.
      </div>
    )}

    <!-- Formulaire -->
    <div class="card bg-base-100 shadow-xl" id="loginCard">
      <div class="card-body gap-5">
        <h2 class="card-title text-xl justify-center">Connexion</h2>

        <div id="errorAlert" class="alert alert-error text-sm hidden" role="alert">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span id="errorMsg">Identifiants incorrects</span>
        </div>

        <form id="loginForm" class="space-y-4" novalidate>
          <div class="form-control">
            <label class="label" for="username"><span class="label-text font-semibold">Identifiant</span></label>
            <input id="username" type="text" name="username"
              class="input input-bordered input-lg" placeholder="Votre identifiant"
              required autocomplete="username" autofocus />
          </div>
          <div class="form-control">
            <label class="label" for="password"><span class="label-text font-semibold">Mot de passe</span></label>
            <input id="password" type="password" name="password"
              class="input input-bordered input-lg" placeholder="••••••••"
              required autocomplete="current-password" />
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg mt-2" id="submitBtn">
            <span id="btnText">Se connecter</span>
            <span id="btnLoader" class="loading loading-spinner loading-sm hidden"></span>
          </button>
        </form>

      </div>
    </div>

    <!-- Choix interface (si multi-rôles) -->
    <div id="roleCard" class="card bg-base-100 shadow-xl hidden">
      <div class="card-body gap-4">
        <h2 class="card-title justify-center">Bonjour, <span id="userName"></span> 👋</h2>
        <p class="text-center text-sm text-base-content/60">Choisissez votre interface</p>
        <div id="rolesGrid" class="grid gap-3"></div>
        <button id="backBtn" class="btn btn-ghost btn-sm mt-1">← Retour</button>
      </div>
    </div>

    <!-- Lien retour site public -->
    <div class="text-center mt-5">
      <a href="/" class="btn btn-ghost btn-sm gap-1 text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Retour au site
      </a>
    </div>

  </div>
</body>
</html>

<script>
  // ── Config rôles ──────────────────────────────
  const ROLE_CONFIG: Record<string, { icon: string; label: string; desc: string; url: string }> = {
    admin:    { icon: '🏢', label: 'Administration', desc: 'Gestion complète',       url: '/admin'    },
    chef:     { icon: '👨‍🍳', label: 'Cuisine',        desc: 'Préparation commandes', url: '/cuisine'  },
    livreur:  { icon: '🚗', label: 'Livraison',       desc: 'Gestion des livraisons', url: '/livraison'},
    caissier: { icon: '🧾', label: 'Caisse',          desc: 'Point de vente (POS)',   url: '/pos'      },
  };

  // ── Helpers ───────────────────────────────────
  function getApiBase() {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'https://api.rareburger.be/api';
  }

  function getRedirect(): string {
    // Lire depuis le meta injecté SSR
    return document.querySelector<HTMLMetaElement>('meta[name="login-redirect"]')?.content ?? '';
  }

  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }

  function q<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }

  function showError(msg: string) {
    q('errorMsg').textContent = msg;
    q('errorAlert').classList.remove('hidden');
    setTimeout(() => q('errorAlert').classList.add('hidden'), 5000);
  }

  // ── Redirection intelligente ───────────────────
  // Priorité :
  // 1. ?redirect=/chemin  — page demandée avant l'expiration
  // 2. Rôle unique → destination par défaut du rôle
  // 3. Multi-rôles → afficher le choix
  function redirectForRole(roles: string[], token: string) {
    const redirectTo = getRedirect();

    // ?redirect présent — vérifier qu'au moins un rôle y a accès
    // Admin a accès à TOUT, les autres rôles ont accès à leur URL + /pos
    if (redirectTo) {
      const PROTECTED: Record<string, string[]> = {
        '/admin':    ['admin'],
        '/cuisine':  ['admin', 'chef'],
        '/livraison':['admin', 'livreur'],
        '/pos':      ['admin', 'chef', 'caissier'],
      };
      // Trouver quelle route protégée correspond au redirect
      const matchedRoute = Object.keys(PROTECTED)
        .sort((a, b) => b.length - a.length)
        .find(route => redirectTo === route || redirectTo.startsWith(route + '/') || redirectTo.startsWith(route + '?'));

      const allowed = matchedRoute
        ? roles.some(r => PROTECTED[matchedRoute].includes(r))
        : roles.includes('admin'); // route inconnue → admin seulement

      if (allowed) {
        saveCookieAndGo(token, redirectTo);
        return;
      }
    }

    // Pas de redirect valide → destination par défaut du premier rôle
    // Ordre de priorité : admin > chef > caissier > livreur
    const priority = ['admin', 'chef', 'caissier', 'livreur'];
    const topRole  = priority.find(r => roles.includes(r)) ?? roles[0];
    const cfg      = ROLE_CONFIG[topRole];
    if (cfg) { saveCookieAndGo(token, cfg.url); return; }

    // Fallback : sélecteur multi-rôles
    showRoleSelection(roles, token);
  }

  function saveCookieAndGo(token: string, url: string) {
    document.cookie = `admin_token=${token}; path=/; max-age=86400; SameSite=Strict`;
    window.location.href = url;
  }

  // ── Sélection multi-rôles ─────────────────────
  let pendingToken = '';

  function showRoleSelection(roles: string[], token: string) {
    pendingToken = token;
    q('loginCard').classList.add('hidden');
    q('roleCard').classList.remove('hidden');

    const grid = q('rolesGrid');
    grid.innerHTML = '';

    roles.forEach(role => {
      const cfg = ROLE_CONFIG[role];
      if (!cfg) return;
      const btn = document.createElement('button');
      btn.className = 'btn btn-outline btn-lg h-auto py-4 flex justify-start gap-4';
      btn.innerHTML = `
        <span class="text-3xl">${cfg.icon}</span>
        <div class="text-left flex-1">
          <p class="font-bold">${esc(cfg.label)}</p>
          <p class="text-xs opacity-70 font-normal">${esc(cfg.desc)}</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      `;
      btn.addEventListener('click', () => saveCookieAndGo(pendingToken, cfg.url));
      grid.appendChild(btn);
    });
  }

  q('backBtn')?.addEventListener('click', () => {
    q('roleCard').classList.add('hidden');
    q('loginCard').classList.remove('hidden');
    pendingToken = '';
    const btn = q<HTMLButtonElement>('submitBtn');
    btn.disabled = false;
    q('btnText').classList.remove('hidden');
    q('btnLoader').classList.add('hidden');
  });

  // ── Formulaire de connexion ───────────────────
  q('loginForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btn     = q<HTMLButtonElement>('submitBtn');
    const username = (q<HTMLInputElement>('username')).value.trim();
    const password = (q<HTMLInputElement>('password')).value;

    if (!username || !password) { showError('Identifiant et mot de passe requis'); return; }

    btn.disabled = true;
    q('btnText').classList.add('hidden');
    q('btnLoader').classList.remove('hidden');
    q('errorAlert').classList.add('hidden');

    try {
      const res = await fetch(`${getApiBase()}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });

      const data = await res.json() as {
        success?: boolean; token?: string; roles?: string[];
        name?: string; username?: string; message?: string;
      };

      if (!res.ok || !data.success || !data.token) {
        throw new Error(data.message ?? 'Identifiants incorrects');
      }

      // Afficher le nom dans le sélecteur multi-rôles
      q('userName').textContent = data.name ?? data.username ?? username;

      redirectForRole(data.roles ?? [], data.token);

    } catch (err: unknown) {
      showError(err instanceof Error ? err.message : 'Erreur de connexion');
      btn.disabled = false;
      q('btnText').classList.remove('hidden');
      q('btnLoader').classList.add('hidden');
    }
  });

  // ── Vérifier session existante ────────────────
  // Si déjà connecté avec un token valide → rediriger directement
  async function checkExistingSession() {
    const tokenCookie = document.cookie.split(';').find(c => c.trim().startsWith('admin_token='));
    if (!tokenCookie) return;

    try {
      const token = decodeURIComponent(tokenCookie.split('=')[1].trim());
      const res   = await fetch(`${getApiBase()}/auth/verify`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) return;
      const data = await res.json() as { valid?: boolean; roles?: string[] };
      if (data.valid && data.roles?.length) {
        redirectForRole(data.roles, token);
      }
    } catch { /* session invalide, on reste sur login */ }
  }

  checkExistingSession();
</script>