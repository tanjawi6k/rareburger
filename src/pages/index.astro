---
// src/pages/index.astro
// ============================================
// 🏠 CMDOLA - Page d'accueil optimisée SEO/AEO
// ============================================

import '../assets/app.css';
import api from '../lib/api';

// ✅ Charger la config côté serveur
let config: any = {};
let theme = 'light';
let logoUrl = '/favicon.ico';
let restaurantName = 'Rare Burger';
let description = 'Envie de commander à manger ? Nous suivre sur Instagram ? Les deux ! 🥰';
let instagramUrl = '';
let horaires: any = {};

try {
  config = await api.config.get();
  theme = config.theme?.daisy || 'light';
  logoUrl = config.theme?.logo ? api.images.getUrl(config.theme.logo) : '/favicon.ico';
  restaurantName = config.nom || 'Rare Burger';
  description = config.description || description;
  instagramUrl = config.reseaux_sociaux?.instagram || '';
  horaires = config.horaires || {};
} catch (error) {
  console.error('❌ Erreur chargement config:', error);
}

// ✅ Générer les horaires pour Schema.org dynamiquement
const dayMap: Record<string, string> = {
  'lundi': 'Monday',
  'mardi': 'Tuesday',
  'mercredi': 'Wednesday',
  'jeudi': 'Thursday',
  'vendredi': 'Friday',
  'samedi': 'Saturday',
  'dimanche': 'Sunday'
};

const openingHours = Object.entries(horaires).map(([day, slots]: [string, any]) => {
  const englishDay = dayMap[day.toLowerCase()];
  return (slots as any[]).map((slot: any) => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": englishDay,
    "opens": slot.debut,
    "closes": slot.fin
  }));
}).flat();

// ✅ Schema.org enrichi pour SEO/AEO
const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": restaurantName,
  "image": `https://rareburger.be${logoUrl}`,
  "logo": `https://rareburger.be${logoUrl}`,
  "description": `${restaurantName} - Restaurant de smash burgers halal à Charleroi. Burgers artisanaux avec viande halal fraîche, pain brioché frais, frites maison. Livraison 30 min et à emporter disponibles Place de la Digue.`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "19, Place de la Digue",
    "addressLocality": "Charleroi",
    "postalCode": "6000",
    "addressRegion": "Hainaut",
    "addressCountry": "BE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.4094,
    "longitude": 4.4441
  },
  "telephone": "+32470184242",
  "servesCuisine": ["Burgers", "Fast Food", "American", "Halal", "Belgian"],
  "priceRange": "€€",
  "openingHoursSpecification": openingHours.length > 0 ? openingHours : [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday"],
      "opens": "11:30",
      "closes": "22:00"
    }
  ],
  "menu": "https://rareburger.be/menu",
  "acceptsReservations": false,
  "hasDeliveryMethod": {
    "@type": "DeliveryMethod",
    "name": "Livraison à domicile et Click & Collect"
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Charleroi"
    },
    {
      "@type": "City", 
      "name": "Gilly"
    },
    {
      "@type": "City",
      "name": "Lodelinsart"
    },
    {
      "@type": "City",
      "name": "Marchienne-au-Pont"
    },
    {
      "@type": "City",
      "name": "Montignies-sur-Sambre"
    }
  ],
  "paymentAccepted": ["Cash", "Credit Card", "Bancontact", "Visa", "Mastercard"],
  "currenciesAccepted": "EUR",
  "sameAs": [
    "https://www.instagram.com/rare_burger_be/",
    "https://www.facebook.com/p/Rare-burgers-61573758465023/",
    "https://www.tiktok.com/@rarefoodtv"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "150"
  }
};

// ✅ FAQ Schema pour AEO (Answer Engine Optimization)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Est-ce que vous livrez à domicile ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, ${restaurantName} livre à domicile à Charleroi, Gilly, Lodelinsart, Marchienne-au-Pont, Montignies-sur-Sambre et les communes environnantes. Délai moyen de livraison : 30 minutes. Commandez facilement en ligne sur notre site.`
      }
    },
    {
      "@type": "Question",
      "name": "Est-ce que c'est halal ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, 100% de notre viande est halal certifiée et fraîche. Nous utilisons uniquement de la viande halal de qualité pour tous nos burgers chez ${restaurantName}.`
      }
    },
    {
      "@type": "Question",
      "name": "Peut-on commander et venir chercher ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Oui, nous proposons le Click & Collect. Commandez en ligne et venez retirer votre commande directement au restaurant au 19 Place de la Digue à Charleroi. Pas d'attente, votre commande est prête à votre arrivée.`
      }
    },
    {
      "@type": "Question",
      "name": "Quels modes de paiement acceptez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nous acceptons les paiements en espèces, carte bancaire (Visa, Mastercard), Bancontact, et paiement en ligne sécurisé pour les commandes web."
      }
    },
    {
      "@type": "Question",
      "name": "Y a-t-il un parking près du restaurant ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, de nombreux parkings gratuits et payants sont disponibles autour de la Place de la Digue à Charleroi centre-ville. Accès facile en voiture ou transports en commun depuis Charleroi-Sud."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="fr-BE" data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags (optimisés pour SEO local et AEO) -->
  <title>{restaurantName} Charleroi | Smash Burgers Halal Place de la Digue | Livraison 30min</title>
  <meta name="description" content={`🍔 ${restaurantName} : Les meilleurs smash burgers halal de Charleroi ! Viande fraîche jamais congelée, pain brioché frais, livraison rapide en 30 min à Charleroi, Gilly, Lodelinsart. Place de la Digue. Commander maintenant !`} />
  <meta name="keywords" content={`${restaurantName.toLowerCase()}, burger charleroi, smash burger halal, burger halal charleroi centre, restaurant halal place de la digue, livraison burger 30 min charleroi, burger artisanal charleroi, fast food halal belgique, meilleur burger charleroi, burger gilly, burger lodelinsart, burger marchienne, click and collect charleroi, burger charleroi sud, burger ville basse charleroi, pain brioché burger, viande fraiche halal`} />
  
  <!-- Geo Tags pour SEO local -->
  <meta name="geo.region" content="BE-WHT" />
  <meta name="geo.placename" content="Charleroi" />
  <meta name="geo.position" content="50.4094;4.4441" />
  <meta name="ICBM" content="50.4094, 4.4441" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="restaurant" />
  <meta property="og:url" content="https://rareburger.be/" />
  <meta property="og:title" content={`${restaurantName} Charleroi - Smash Burgers Halal 🍔`} />
  <meta property="og:description" content={`Les meilleurs smash burgers halal de Charleroi ! Viande fraîche, pain brioché, frites maison. Livraison 30 min à Charleroi, Gilly, Lodelinsart. Place de la Digue.`} />
  <meta property="og:image" content={`https://rareburger.be${logoUrl}`} />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:site_name" content={restaurantName} />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://rareburger.be/" />
  <meta name="twitter:title" content={`${restaurantName} Charleroi - Smash Burgers Halal`} />
  <meta name="twitter:description" content="Les meilleurs smash burgers halal de Charleroi ! Livraison 30 min. Commandez maintenant." />
  <meta name="twitter:image" content={`https://rareburger.be${logoUrl}`} />
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://rareburger.be/" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href={logoUrl}>
  <link rel="apple-touch-icon" href={logoUrl}>
  
  <!-- Schema.org JSON-LD (données structurées pour Google) -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  <!-- Hreflang -->
  <link rel="alternate" hreflang="fr-be" href="https://rareburger.be/" />
  <link rel="alternate" hreflang="fr" href="https://rareburger.be/" />
  <link rel="alternate" hreflang="x-default" href="https://rareburger.be/" />
  
  <!-- Preconnect pour performances -->
  <link rel="preconnect" href="https://api.cmdola.be" />
  <link rel="dns-prefetch" href="https://api.cmdola.be" />
  
  <!-- Author & Copyright -->
  <meta name="author" content={`${restaurantName} Charleroi`} />
  <meta name="copyright" content={`© 2024 ${restaurantName}. Tous droits réservés.`} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  
  <!-- Mobile App -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={restaurantName} />
  
  <!-- Theme Color -->
  <meta name="theme-color" content="#1e3a8a" />
</head>

<body class="min-h-screen bg-base-200">
  
  <!-- Hero Section - Affichage sobre et classe -->
  <div class="hero min-h-screen">
    <div class="hero-content text-center">
      <div class="max-w-xl">
        
        <!-- Logo -->
        <div class="mb-8 flex justify-center">
          <img 
            src={logoUrl}
            alt={`${restaurantName} Charleroi - Logo restaurant smash burger halal Place de la Digue`}
            class="w-32 h-32 rounded-3xl shadow-2xl"
            width="128"
            height="128"
            loading="eager"
          />
        </div>

        <!-- Titre simple et classe -->
        <h1 class="text-5xl font-bold mb-4">
          Bienvenue chez {restaurantName} !
        </h1>

        <!-- Description -->
        <p class="text-lg mb-8 text-base-content/70">
          {description}
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button class="btn btn-primary btn-lg btn-disabled" aria-disabled="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            Commander (Soon)
          </button>

          {instagramUrl && (
            <a 
              href={instagramUrl}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline btn-lg"
              aria-label={`Suivez ${restaurantName} sur Instagram pour nos nouveautés`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              Suivre sur Instagram
            </a>
          )}
        </div>

        <!-- ✅ Contenu SEO/AEO enrichi et caché visuellement (sr-only) -->
        <div class="sr-only" aria-hidden="false">
          <h2>Restaurant {restaurantName} à Charleroi - Meilleurs Smash Burgers Halal</h2>
          <p>
            {restaurantName} est LE restaurant de référence pour les amateurs de smash burgers halal à Charleroi et ses environs. 
            Situé au cœur du centre-ville de Charleroi, au 19 Place de la Digue (6000), à proximité de Charleroi-Sud et de la Ville Basse, 
            nous proposons des burgers artisanaux authentiques préparés avec de la viande halal fraîche jamais congelée, 
            du pain brioché frais tous les jours, et des ingrédients de qualité supérieure.
          </p>
          
          <h3>Notre Carte de Smash Burgers Halal Artisanaux</h3>
          <p>
            Découvrez nos burgers signatures à partir de 10€ :
          </p>
          <ul>
            <li>Rare Burger - Notre création phare : Big Patty juteux, double cheddar fondu, oignons rouges croquants, laitue fraîche, tomate, bacon de bœuf fumé halal et notre sauce rare maison secrète</li>
            <li>Truffle Burger - Pour les gourmets : Double patties smashés, double cheddar, oignons frits croustillants, roquette et sauce truffe artisanale</li>
            <li>Double Cheese - Le classique réinventé : Double patties & cheddar fondant, oignons caramélisés, cornichons croquants, ketchup et moutarde</li>
            <li>BB-Choux - L'original : Double patties & cheddar, tomate fraîche, chou rouge croquant, sauce BBQ fumée et mayonnaise maison</li>
            <li>Frites fraîches maison coupées et préparées tous les jours</li>
            <li>Wings épicées (BBQ miel, Pili-pili, Habanero)</li>
