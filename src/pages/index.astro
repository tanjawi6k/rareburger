---
// src/pages/index.astro
// Page d'accueil — DaisyUI theme-aware (SSR cookie)

import '../assets/app.css';
import api from '../lib/api';

// ─────────────────────────────────────────
// Thème : lu depuis le cookie côté serveur
// → pas de flash au chargement (FOUC)
// ─────────────────────────────────────────
const VALID_THEMES = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];

const cookieTheme = Astro.cookies.get('theme')?.value;
let theme = VALID_THEMES.includes(cookieTheme ?? '') ? cookieTheme! : 'light';

// ─────────────────────────────────────────
// Config restaurant (SSR)
// ─────────────────────────────────────────
let config: any       = {};
let logoUrl           = '/favicon.ico';
let restaurantName    = 'Rare Burger';
let description       = 'Envie de commander à manger ? Nous suivre sur Instagram ? Les deux ! 🥰';
let instagramUrl      = '';
let horaires: any     = {};

try {
  config         = await api.config.get();
  // Le thème de la config est le thème par défaut si aucun cookie
  if (!cookieTheme && config.theme?.daisy && VALID_THEMES.includes(config.theme.daisy)) {
    theme = config.theme.daisy;
  }
  logoUrl        = config.theme?.logo ? api.images.getUrl(config.theme.logo) : '/favicon.ico';
  restaurantName = config.nom         || restaurantName;
  description    = config.description || description;
  instagramUrl   = config.reseaux_sociaux?.instagram || '';
  horaires       = config.horaires    || {};
} catch (e) {
  console.error('Erreur config:', e);
}

// ─────────────────────────────────────────
// Schema.org — horaires dynamiques
// ─────────────────────────────────────────
const dayMap: Record<string, string> = {
  lundi:'Monday', mardi:'Tuesday', mercredi:'Wednesday',
  jeudi:'Thursday', vendredi:'Friday', samedi:'Saturday', dimanche:'Sunday',
};

const openingHours = Object.entries(horaires).flatMap(([day, slots]: [string, any]) =>
  (slots as any[]).map((slot: any) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: dayMap[day.toLowerCase()],
    opens: slot.debut,
    closes: slot.fin,
  }))
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurantName,
  image: `https://rareburger.be${logoUrl}`,
  logo: `https://rareburger.be${logoUrl}`,
  description: `${restaurantName} — Smash burgers halal artisanaux à Charleroi. Viande fraîche, pain brioché, frites maison. Livraison 30 min et à emporter, Place de la Digue.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '19, Place de la Digue',
    addressLocality: 'Charleroi',
    postalCode: '6000',
    addressRegion: 'Hainaut',
    addressCountry: 'BE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 50.4094, longitude: 4.4441 },
  telephone: '+32470184242',
  servesCuisine: ['Burgers', 'Fast Food', 'American', 'Halal', 'Belgian'],
  priceRange: '€€',
  openingHoursSpecification: openingHours.length > 0 ? openingHours : [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday'], opens: '11:30', closes: '22:00' },
  ],
  menu: 'https://rareburger.be/menu',
  acceptsReservations: false,
  areaServed: ['Charleroi','Gilly','Lodelinsart','Marchienne-au-Pont','Montignies-sur-Sambre'].map(name => ({ '@type': 'City', name })),
  paymentAccepted: ['Cash','Credit Card','Bancontact','Visa','Mastercard'],
  currenciesAccepted: 'EUR',
  sameAs: [
    'https://www.instagram.com/rare_burger_be/',
    'https://www.facebook.com/p/Rare-burgers-61573758465023/',
    'https://www.tiktok.com/@rarefoodtv',
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', reviewCount: '150' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Est-ce que vous livrez à domicile ?',
      acceptedAnswer: { '@type': 'Answer', text: `Oui, ${restaurantName} livre à Charleroi, Gilly, Lodelinsart, Marchienne-au-Pont et environs. Délai moyen : 30 minutes.` },
    },
    {
      '@type': 'Question',
      name: 'Est-ce que c\'est halal ?',
      acceptedAnswer: { '@type': 'Answer', text: `Oui, 100 % de notre viande est halal certifiée et fraîche chez ${restaurantName}.` },
    },
    {
      '@type': 'Question',
      name: 'Peut-on commander et venir chercher ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Oui, Click & Collect disponible. Commandez en ligne et venez retirer au 19 Place de la Digue, Charleroi.' },
    },
    {
      '@type': 'Question',
      name: 'Quels modes de paiement acceptez-vous ?',
      acceptedAnswer: { '@type': 'Answer', text: 'Espèces, carte bancaire (Visa, Mastercard), Bancontact et paiement en ligne sécurisé.' },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="fr-BE" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO -->
  <title>{restaurantName} Charleroi | Smash Burgers Halal Place de la Digue | Livraison 30min</title>
  <meta name="description" content={`🍔 ${restaurantName} : les meilleurs smash burgers halal de Charleroi ! Viande fraîche, pain brioché, livraison en 30 min à Charleroi, Gilly, Lodelinsart. Place de la Digue.`} />
  <meta name="keywords" content={`${restaurantName.toLowerCase()}, burger charleroi, smash burger halal, burger halal charleroi, livraison burger charleroi, click and collect charleroi, fast food halal belgique`} />
  <link rel="canonical" href="https://rareburger.be/" />

  <!-- Geo -->
  <meta name="geo.region" content="BE-WHT" />
  <meta name="geo.placename" content="Charleroi" />
  <meta name="geo.position" content="50.4094;4.4441" />
  <meta name="ICBM" content="50.4094, 4.4441" />

  <!-- Open Graph -->
  <meta property="og:type" content="restaurant" />
  <meta property="og:url" content="https://rareburger.be/" />
  <meta property="og:title" content={`${restaurantName} Charleroi — Smash Burgers Halal 🍔`} />
  <meta property="og:description" content="Les meilleurs smash burgers halal de Charleroi ! Livraison 30 min à Charleroi, Gilly, Lodelinsart." />
  <meta property="og:image" content={`https://rareburger.be${logoUrl}`} />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:site_name" content={restaurantName} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${restaurantName} — Smash Burgers Halal Charleroi`} />
  <meta name="twitter:description" content="Les meilleurs smash burgers halal de Charleroi ! Livraison 30 min." />
  <meta name="twitter:image" content={`https://rareburger.be${logoUrl}`} />

  <!-- Hreflang -->
  <link rel="alternate" hreflang="fr-be" href="https://rareburger.be/" />
  <link rel="alternate" hreflang="x-default" href="https://rareburger.be/" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href={logoUrl} />
  <link rel="apple-touch-icon" href={logoUrl} />

  <!-- Robots -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content={`${restaurantName} Charleroi`} />

  <!-- PWA -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={restaurantName} />
  <meta name="theme-color" content="#1e3a8a" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://api.cmdola.be" />
  <link rel="dns-prefetch" href="https://api.cmdola.be" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!--
    Thème DaisyUI : déjà appliqué via data-theme SSR (cookie).
    Ce script inline évite tout flash résiduel si JS charge avant CSS.
  -->
  <script is:inline>
    (function () {
      const valid = ['light','dark','cupcake','bumblebee','emerald','corporate',
        'synthwave','retro','cyberpunk','valentine','halloween','garden','forest',
        'aqua','lofi','pastel','fantasy','wireframe','black','luxury','dracula',
        'cmyk','autumn','business','acid','lemonade','night','coffee','winter',
        'dim','nord','sunset'];
      const cookie = document.cookie.split(';').find(c => c.trim().startsWith('theme='));
      const saved  = cookie ? decodeURIComponent(cookie.split('=')[1].trim()) : null;
      if (saved && valid.includes(saved)) {
        document.documentElement.setAttribute('data-theme', saved);
      }
    })();
  </script>
</head>

<body class="min-h-screen bg-base-200">

  <div class="hero min-h-screen">
    <div class="hero-content text-center">
      <div class="max-w-xl">

        <!-- Logo -->
        <div class="mb-8 flex justify-center">
          <img
            src={logoUrl}
            alt={`${restaurantName} — Logo restaurant smash burger halal Charleroi`}
            class="w-32 h-32 rounded-3xl shadow-2xl object-contain bg-base-100"
            width="128"
            height="128"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Titre -->
        <h1 class="text-5xl font-bold mb-4 text-base-content">
          Bienvenue chez {restaurantName} !
        </h1>

        <!-- Description -->
        <p class="text-lg mb-8 text-base-content/70">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/menu" class="btn btn-primary btn-lg gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            Commander
          </a>

          {instagramUrl && (
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-lg gap-2"
              aria-label={`Suivez ${restaurantName} sur Instagram`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              Instagram
            </a>
          )}
        </div>

      </div>
    </div>
  </div>

  <!--
    Script de changement de thème côté client.
    Appelable depuis n'importe quelle page avec : setTheme('dark')
    Sauvegarde dans cookie (SSR-compatible) ET localStorage (fallback).
  -->
  <script is:inline>
    window.setTheme = function(name) {
      const valid = ['light','dark','cupcake','bumblebee','emerald','corporate',
        'synthwave','retro','cyberpunk','valentine','halloween','garden','forest',
        'aqua','lofi','pastel','fantasy','wireframe','black','luxury','dracula',
        'cmyk','autumn','business','acid','lemonade','night','coffee','winter',
        'dim','nord','sunset'];
      if (!valid.includes(name)) return;
      document.documentElement.setAttribute('data-theme', name);
      const maxAge = 60 * 60 * 24 * 365;
      document.cookie = `theme=${name}; max-age=${maxAge}; path=/; SameSite=Lax`;
      try { localStorage.setItem('theme', name); } catch (_) {}
    };
  </script>

</body>
</html>