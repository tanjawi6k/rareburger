---
// src/pages/checkout.astro
export const prerender = false;

import Navbar from '../components/Navbar.astro';
import api from '../lib/api';
import '../assets/app.css';

// ─────────────────────────────────────────
// Thème SSR
// ─────────────────────────────────────────
const VALID_THEMES: readonly string[] = [
  'light','dark','cupcake','bumblebee','emerald','corporate',
  'synthwave','retro','cyberpunk','valentine','halloween','garden',
  'forest','aqua','lofi','pastel','fantasy','wireframe','black',
  'luxury','dracula','cmyk','autumn','business','acid','lemonade',
  'night','coffee','winter','dim','nord','sunset',
];
const cookieTheme = Astro.cookies.get('theme')?.value;

// ─────────────────────────────────────────
// Types
// ─────────────────────────────────────────
interface TimeSlot { debut: string; fin: string; }
interface ZoneLivraison {
  id: string;
  nom: string;
  codes_postaux: string[];
  frais: number;
  minimum?: number;
  temps_estime?: string;
}
interface ModeConfig {
  active: boolean;
  label: string;
  description: string;
  icon: string;
  delai_preparation?: string;
}
interface PaymentConfig {
  active: boolean;
  label: string;
  description: string;
  icon: string;
}

// ─────────────────────────────────────────
// Données SSR
// ─────────────────────────────────────────
let theme          = 'light';
let logoUrl        = '/favicon.ico';
let restaurantName = 'CMDOLA';
let restaurantTel  = '';
let isOpen         = false;

// Config sérialisée pour le client (évite un second fetch)
let configJson = '{}';

function timeToMin(t: string): number {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
}
const DAY_NAMES_FR: readonly string[] = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];

try {
  const configData = await api.config.get() as Record<string, any>;

  const configTheme = (configData.theme as Record<string,string>|undefined)?.daisy;
  theme = (cookieTheme && VALID_THEMES.includes(cookieTheme))
    ? cookieTheme
    : (configTheme && VALID_THEMES.includes(configTheme) ? configTheme : 'light');

  const logoFile = (configData.theme as Record<string,string>|undefined)?.logo;
  logoUrl        = logoFile ? api.images.getUrl(logoFile) : '/favicon.ico';
  restaurantName = (configData.nom       as string|undefined) ?? 'CMDOLA';
  restaurantTel  = (configData.telephone as string|undefined) ?? '';

  // Statut ouverture
  const now   = new Date();
  const brux  = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Brussels' }));
  const dayFr = DAY_NAMES_FR[brux.getDay()] ?? 'lundi';
  const tStr  = `${String(brux.getHours()).padStart(2,'0')}:${String(brux.getMinutes()).padStart(2,'0')}`;
  const nowMin = timeToMin(tStr);
  const sched  = ((configData.horaires as Record<string,TimeSlot[]>|undefined)?.[dayFr]) ?? [];
  isOpen = sched.some(({ debut, fin }) => {
    const d = timeToMin(debut), f = timeToMin(fin);
    return f < d ? nowMin >= d || nowMin <= f : nowMin >= d && nowMin <= f;
  });

  // Passer config au client (modes_service, zones_livraison, methodes_paiement seulement)
  configJson = JSON.stringify({
    modes_service:     configData.modes_service     ?? {},
    zones_livraison:   configData.zones_livraison   ?? [],
    methodes_paiement: configData.methodes_paiement ?? {},
  });

} catch (err) {
  console.error('Erreur config checkout:', err);
}

const apiBaseUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:5000/api';
---

<!DOCTYPE html>
<html lang="fr" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="api-url" content={apiBaseUrl} />
  <title>Commander — {restaurantName}</title>
  <link rel="icon" type="image/png" href={logoUrl} id="favicon" />

  <!-- Anti-FOUC thème -->
  <script is:inline>
    (function(){
      var v=['light','dark','cupcake','bumblebee','emerald','corporate',
        'synthwave','retro','cyberpunk','valentine','halloween','garden','forest',
        'aqua','lofi','pastel','fantasy','wireframe','black','luxury','dracula',
        'cmyk','autumn','business','acid','lemonade','night','coffee','winter',
        'dim','nord','sunset'];
      var c=document.cookie.split(';').find(function(x){return x.trim().startsWith('theme=');});
      var t=c?decodeURIComponent(c.split('=')[1].trim()):null;
      if(t&&v.indexOf(t)!==-1) document.documentElement.setAttribute('data-theme',t);
    }());
  </script>

  <!-- Config sérialisée SSR → client (évite un fetch côté client) -->
  <script id="checkout-config" type="application/json" set:html={configJson} />
</head>

<body class="bg-base-200" style="min-height:100dvh;min-height:100vh;">

  <header class="sticky top-0 z-40">
    <Navbar restaurantName={restaurantName} logoUrl={logoUrl} activePage="" />
  </header>

  {!isOpen && (
    <div class="container mx-auto px-4 pt-4 max-w-5xl">
      <div class="alert alert-warning rounded-2xl" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <p class="text-sm">Restaurant fermé — vous pouvez préparer votre commande, elle sera traitée à la réouverture.</p>
      </div>
    </div>
  )}

  <!-- Loading -->
  <div id="loading-screen" class="container mx-auto px-4 py-16 max-w-5xl flex flex-col items-center gap-3">
    <span class="loading loading-spinner loading-lg text-primary"></span>
    <p class="text-base-content/60 text-sm">Chargement…</p>
  </div>

  <!-- Contenu principal (caché jusqu'au JS) -->
  <div id="main-content" class="container mx-auto px-4 py-6 max-w-5xl hidden">

    <h1 class="text-2xl sm:text-3xl font-bold mb-5 text-base-content">Finaliser la commande</h1>

    <!-- Steps DaisyUI -->
    <ul class="steps w-full mb-6 text-xs sm:text-sm">
      <li class="step step-primary" id="step-ind-1">Mode</li>
      <li class="step" id="step-ind-2">Informations</li>
      <li class="step" id="step-ind-3">Paiement</li>
    </ul>

    <div class="grid lg:grid-cols-3 gap-5">

      <!-- Formulaire 2/3 -->
      <div class="lg:col-span-2">
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-5">

            <!-- ÉTAPE 1 — Mode de service -->
            <section id="step-1" aria-label="Mode de service">
              <h2 class="text-lg font-bold mb-4">Comment souhaitez-vous recevoir votre commande ?</h2>
              <div id="service-modes-container" class="grid gap-3"></div>
              <div class="flex justify-end mt-5">
                <button id="btn-next-1" class="btn btn-primary gap-2" disabled>
                  Continuer
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </section>

            <!-- ÉTAPE 2 — Informations client -->
            <section id="step-2" class="hidden" aria-label="Vos informations">
              <h2 class="text-lg font-bold mb-4">Vos informations</h2>
              <form id="form-client" class="space-y-4" novalidate>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="form-control">
                    <label class="label" for="inp-prenom"><span class="label-text">Prénom *</span></label>
                    <input id="inp-prenom" type="text" name="prenom" class="input input-bordered" placeholder="Jean" required autocomplete="given-name" />
                  </div>
                  <div class="form-control">
                    <label class="label" for="inp-nom"><span class="label-text">Nom *</span></label>
                    <input id="inp-nom" type="text" name="nom" class="input input-bordered" placeholder="Dupont" required autocomplete="family-name" />
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                  <div class="form-control">
                    <label class="label" for="inp-tel"><span class="label-text">Téléphone *</span></label>
                    <input id="inp-tel" type="tel" name="telephone" class="input input-bordered" placeholder="0470 12 34 56" required autocomplete="tel" />
                  </div>
                  <div class="form-control">
                    <label class="label" for="inp-email"><span class="label-text">Email *</span></label>
                    <input id="inp-email" type="email" name="email" class="input input-bordered" placeholder="jean@example.com" required autocomplete="email" />
                  </div>
                </div>

                <!-- Heure de retrait (emporter) -->
                <div id="field-heure" class="form-control hidden">
                  <label class="label" for="inp-heure"><span class="label-text">Heure de retrait souhaitée *</span></label>
                  <input id="inp-heure" type="time" name="heure_souhaitee" class="input input-bordered" />
                  <label class="label"><span id="heure-help" class="label-text-alt"></span></label>
                </div>

                <!-- Numéro de table (sur place) -->
                <div id="field-table" class="form-control hidden">
                  <label class="label" for="inp-table"><span class="label-text">Numéro de table</span></label>
                  <input id="inp-table" type="text" name="numero_table" class="input input-bordered" placeholder="Ex : 12" autocomplete="off" />
                </div>

                <!-- Adresse (livraison) -->
                <div id="field-adresse" class="hidden">
                  <div class="divider text-sm">Adresse de livraison</div>
                  <div class="grid sm:grid-cols-3 gap-4">
                    <div class="form-control sm:col-span-2">
                      <label class="label" for="inp-rue"><span class="label-text">Rue *</span></label>
                      <input id="inp-rue" type="text" name="rue" class="input input-bordered" placeholder="Rue de la Paix" autocomplete="street-address" />
                    </div>
                    <div class="form-control">
                      <label class="label" for="inp-num"><span class="label-text">N° *</span></label>
                      <input id="inp-num" type="text" name="numero" class="input input-bordered" placeholder="42" />
                    </div>
                  </div>
                  <div class="grid sm:grid-cols-2 gap-4 mt-4">
                    <div class="form-control">
                      <label class="label" for="inp-cp"><span class="label-text">Code postal *</span></label>
                      <input id="inp-cp" type="text" name="code_postal" class="input input-bordered" placeholder="6000" pattern="[0-9]{4}" inputmode="numeric" autocomplete="postal-code" />
                      <label class="label"><span id="zone-info" class="label-text-alt"></span></label>
                    </div>
                    <div class="form-control">
                      <label class="label" for="inp-ville"><span class="label-text">Ville *</span></label>
                      <input id="inp-ville" type="text" name="ville" class="input input-bordered" placeholder="Charleroi" autocomplete="address-level2" />
                    </div>
                  </div>
                </div>

                <!-- Notes -->
                <div class="form-control">
                  <label class="label" for="inp-notes"><span class="label-text">Commentaires (optionnel)</span></label>
                  <textarea id="inp-notes" name="notes" class="textarea textarea-bordered" rows="2" placeholder="Instructions, allergies, demandes spéciales…"></textarea>
                </div>

              </form>

              <div class="flex justify-between mt-5">
                <button id="btn-back-2" class="btn btn-ghost gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Retour
                </button>
                <button id="btn-next-2" class="btn btn-primary gap-2">
                  Continuer
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </section>

            <!-- ÉTAPE 3 — Paiement -->
            <section id="step-3" class="hidden" aria-label="Mode de paiement">
              <h2 class="text-lg font-bold mb-4">Mode de paiement</h2>
              <div id="payment-methods" class="grid gap-3"></div>
              <div class="flex justify-between mt-5">
                <button id="btn-back-3" class="btn btn-ghost gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Retour
                </button>
                <button id="btn-confirm" class="btn btn-primary gap-2" disabled>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Confirmer la commande
                </button>
              </div>
            </section>

          </div>
        </div>
      </div>

      <!-- Résumé 1/3 -->
      <div class="lg:col-span-1">
        <div class="card bg-base-100 shadow-sm sticky top-20">
          <div class="card-body gap-3">
            <h2 class="card-title text-base">Récapitulatif</h2>
            <div class="divider my-0"></div>
            <div id="summary-items" class="space-y-2 max-h-60 overflow-y-auto text-sm"></div>
            <div class="divider my-0"></div>
            <div class="flex justify-between text-sm">
              <span class="text-base-content/70">Sous-total</span>
              <span id="summary-subtotal" class="font-semibold tabular-nums">0,00 €</span>
            </div>
            <div id="summary-delivery-row" class="hidden flex justify-between text-sm">
              <span id="summary-delivery-label" class="text-base-content/70">Livraison</span>
              <span id="summary-delivery-fees" class="font-semibold tabular-nums">0,00 €</span>
            </div>
            <div class="flex justify-between">
              <span class="font-bold">Total</span>
              <span id="summary-total" class="font-bold text-primary text-lg tabular-nums">0,00 €</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div id="toast-container" class="toast toast-top toast-end z-50" aria-live="polite"></div>

</body>
</html>

<style>
  @media (pointer: coarse) { button, a { min-height: 44px; } }
  @media (max-width: 640px) { input, select, textarea { font-size: 16px !important; } }

  /* Carte mode de service / paiement sélectionnée */
  .mode-card:has(input:checked) {
    border-color: oklch(var(--p));
    background: oklch(var(--p) / 0.06);
  }
</style>

<script>
  // ════════════════════════════════════════════
  //  Checkout — script bundlé TypeScript
  //  Config lue depuis <script type="application/json">
  //  API calls via fetch direct (pas d'import relatif)
  // ════════════════════════════════════════════

  // ── Types ─────────────────────────────────────
  interface CartItem {
    id: string; nom: string; prix: number; quantite: number;
    supplements?: { id: string; name: string; price: number }[];
    removed_ingredients?: string[];
    choices_selected?: { option_name: string; price_modifier: number }[];
  }
  interface ZoneLivraison {
    id: string; nom: string; codes_postaux: string[];
    frais: number; minimum?: number; temps_estime?: string;
  }
  interface ModeConfig  { active: boolean; label: string; description: string; icon: string; delai_preparation?: string; }
  interface PaymentConfig { active: boolean; label: string; description: string; icon: string; }
  interface CheckoutConfig {
    modes_service:     Record<string, ModeConfig>;
    zones_livraison:   ZoneLivraison[];
    methodes_paiement: Record<string, PaymentConfig>;
  }

  // ── État ──────────────────────────────────────
  let cfg: CheckoutConfig = { modes_service: {}, zones_livraison: [], methodes_paiement: {} };
  let cart: CartItem[]    = [];
  let selectedMode        = '';
  let selectedZone: ZoneLivraison | null = null;
  let selectedPayment     = '';
  let heureMinStr         = '';

  // ── Helpers ───────────────────────────────────
  const fmt = (n: number) =>
    new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(n);

  function esc(v: unknown): string {
    const d = document.createElement('div');
    d.textContent = String(v ?? '');
    return d.innerHTML;
  }

  function getApiBase(): string {
    return document.querySelector<HTMLMetaElement>('meta[name="api-url"]')?.content
      ?? 'http://127.0.0.1:5000/api';
  }

  function showToast(msg: string, type: 'info'|'success'|'warning'|'error' = 'info') {
    const c = document.getElementById('toast-container');
    if (!c) return;
    const el = document.createElement('div');
    el.className = `alert alert-${type} shadow-md text-sm py-2 px-4 rounded-xl`;
    el.textContent = msg;
    c.appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }

  function q<T extends HTMLElement>(sel: string) {
    return document.querySelector<T>(sel);
  }

  // ── Steps ─────────────────────────────────────
  function showStep(n: 1|2|3) {
    [1,2,3].forEach(i => {
      const sec = document.getElementById(`step-${i}`);
      const ind = document.getElementById(`step-ind-${i}`);
      sec?.classList.toggle('hidden', i !== n);
      if (ind) {
        ind.classList.toggle('step-primary', i <= n);
      }
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Résumé ────────────────────────────────────
  function updateSummary() {
    const itemsEl = document.getElementById('summary-items')!;
    itemsEl.innerHTML = '';

    cart.forEach(item => {
      const details: string[] = [];
      item.choices_selected?.forEach(c => details.push(`• ${esc(c.option_name)}`));
      item.supplements?.forEach(s => details.push(`+ ${esc(s.name)}`));
      if (item.removed_ingredients?.length) {
        details.push(`Sans : ${item.removed_ingredients.map(esc).join(', ')}`);
      }

      const row = document.createElement('div');
      row.className = 'pb-2 mb-2 border-b border-base-300 last:border-0';
      row.innerHTML = `
        <div class="flex justify-between gap-2">
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate">${item.quantite}× ${esc(item.nom)}</p>
            ${details.length ? `<p class="text-xs text-base-content/50 mt-0.5">${details.join(' ')}</p>` : ''}
          </div>
          <span class="font-semibold tabular-nums shrink-0">${fmt(item.prix * item.quantite)}</span>
        </div>
      `;
      itemsEl.appendChild(row);
    });

    const subtotal = cart.reduce((s, i) => s + i.prix * i.quantite, 0);
    const frais    = selectedMode === 'livraison' && selectedZone ? selectedZone.frais : 0;

    q('#summary-subtotal')!.textContent = fmt(subtotal);
    q('#summary-total')!.textContent    = fmt(subtotal + frais);

    const delivRow = document.getElementById('summary-delivery-row')!;
    if (frais > 0 && selectedZone) {
      delivRow.classList.remove('hidden');
      q('#summary-delivery-label')!.textContent = `Livraison (${selectedZone.nom})`;
      q('#summary-delivery-fees')!.textContent  = fmt(frais);
    } else {
      delivRow.classList.add('hidden');
    }
  }

  // ── Étape 1 : Modes de service ────────────────
  function renderModes() {
    const container = document.getElementById('service-modes-container')!;
    container.innerHTML = '';

    const modeKeys: (keyof typeof cfg.modes_service)[] = ['sur_place', 'emporter', 'livraison'];
    modeKeys.forEach(key => {
      const m = cfg.modes_service[key];
      if (!m?.active) return;

      const label = document.createElement('label');
      label.className = 'mode-card card card-compact bg-base-100 border-2 border-base-300 cursor-pointer transition-colors';

      const extra = key === 'emporter' && m.delai_preparation
        ? `<p class="text-xs text-info mt-1">⏱ ${esc(m.delai_preparation)}</p>`
        : '';

      label.innerHTML = `
        <div class="card-body">
          <div class="flex items-center gap-4">
            <input type="radio" name="mode_service" value="${key}" class="radio radio-primary shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-2xl" aria-hidden="true">${esc(m.icon)}</span>
                <h3 class="font-bold text-sm">${esc(m.label)}</h3>
              </div>
              <p class="text-xs text-base-content/60 mt-0.5">${esc(m.description)}</p>
              ${extra}
            </div>
          </div>
        </div>
      `;
      container.appendChild(label);
    });

    container.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'mode_service') {
        selectedMode = target.value;
        q<HTMLButtonElement>('#btn-next-1')!.disabled = false;
      }
    });
  }

  // ── Étape 2 : Champs dynamiques ──────────────
  function setupStep2Fields() {
    const fieldAdresse = document.getElementById('field-adresse')!;
    const fieldHeure   = document.getElementById('field-heure')!;
    const fieldTable   = document.getElementById('field-table')!;
    const inpHeure     = q<HTMLInputElement>('#inp-heure')!;
    const inpRue       = q<HTMLInputElement>('#inp-rue')!;
    const inpNum       = q<HTMLInputElement>('#inp-num')!;
    const inpCp        = q<HTMLInputElement>('#inp-cp')!;
    const inpVille     = q<HTMLInputElement>('#inp-ville')!;

    // Reset
    fieldAdresse.classList.add('hidden');
    fieldHeure.classList.add('hidden');
    fieldTable.classList.add('hidden');
    [inpRue, inpNum, inpCp, inpVille].forEach(el => el.required = false);
    inpHeure.required = false;

    if (selectedMode === 'livraison') {
      fieldAdresse.classList.remove('hidden');
      [inpRue, inpNum, inpCp, inpVille].forEach(el => el.required = true);
    } else if (selectedMode === 'emporter') {
      fieldHeure.classList.remove('hidden');
      inpHeure.required = true;
      setupHeureMin();
    } else if (selectedMode === 'sur_place') {
      fieldTable.classList.remove('hidden');
    }
  }

  // ── Heure minimum (+30 min) ───────────────────
  function setupHeureMin() {
    const inpHeure = q<HTMLInputElement>('#inp-heure')!;
    const helpEl   = document.getElementById('heure-help')!;

    const now = new Date();
    const min = new Date(now.getTime() + 30 * 60000);
    heureMinStr = `${String(min.getHours()).padStart(2,'0')}:${String(min.getMinutes()).padStart(2,'0')}`;

    inpHeure.min = heureMinStr;
    helpEl.textContent = `Heure minimum : ${heureMinStr} (dans 30 minutes)`;
    helpEl.className = 'label-text-alt text-info';
  }

  function validateHeure(val: string): { ok: boolean; msg: string } {
    if (!val) return { ok: false, msg: 'Veuillez sélectionner une heure' };
    const now  = new Date();
    const min  = new Date(now.getTime() + 30 * 60000);
    const [h, m] = val.split(':').map(Number);
    const sel  = new Date(); sel.setHours(h, m, 0, 0);
    if (sel >= min) return { ok: true, msg: '' };
    // Cas passage minuit
    const tomorrow = new Date(now); tomorrow.setDate(now.getDate() + 1); tomorrow.setHours(h, m, 0, 0);
    if (tomorrow >= min) return { ok: true, msg: `Retrait demain à ${val}` };
    return { ok: false, msg: `Heure minimum : ${heureMinStr}` };
  }

  // ── Code postal → zone livraison ──────────────
  function setupCodePostal() {
    const inpCp = q<HTMLInputElement>('#inp-cp');
    if (!inpCp) return;

    inpCp.addEventListener('input', () => {
      const cp      = inpCp.value.trim();
      const zoneEl  = document.getElementById('zone-info')!;
      const zone    = cfg.zones_livraison.find(z => z.codes_postaux.includes(cp));

      if (zone) {
        selectedZone = zone;
        zoneEl.textContent = `✓ ${zone.nom} — Livraison ${fmt(zone.frais)}${zone.temps_estime ? ` · ${zone.temps_estime}` : ''}`;
        zoneEl.className   = 'label-text-alt text-success';
        updateSummary();
      } else if (cp.length >= 4) {
        selectedZone = null;
        zoneEl.textContent = '✗ Hors zone de livraison';
        zoneEl.className   = 'label-text-alt text-error';
        updateSummary();
      } else {
        selectedZone = null;
        zoneEl.textContent = '';
        updateSummary();
      }
    });
  }

  // ── Étape 3 : Méthodes de paiement ───────────
  function renderPaymentMethods() {
    const container = document.getElementById('payment-methods')!;
    container.innerHTML = '';

    const available: string[] =
      selectedMode === 'sur_place'
        ? ['comptoir', 'en_ligne']
        : ['reception', 'en_ligne'];

    let hasAny = false;
    available.forEach(key => {
      const m = cfg.methodes_paiement[key];
      if (!m?.active) return;
      hasAny = true;

      const label = document.createElement('label');
      label.className = 'mode-card card card-compact bg-base-100 border-2 border-base-300 cursor-pointer transition-colors';
      label.innerHTML = `
        <div class="card-body">
          <div class="flex items-center gap-4">
            <input type="radio" name="payment_method" value="${key}" class="radio radio-primary shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-2xl" aria-hidden="true">${esc(m.icon)}</span>
                <h3 class="font-bold text-sm">${esc(m.label)}</h3>
              </div>
              <p class="text-xs text-base-content/60 mt-0.5">${esc(m.description)}</p>
            </div>
          </div>
        </div>
      `;
      container.appendChild(label);
    });

    if (!hasAny) {
      const warn = document.createElement('div');
      warn.className   = 'alert alert-warning text-sm';
      warn.textContent = 'Aucune méthode de paiement disponible.';
      container.appendChild(warn);
    }

    container.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'payment_method') {
        selectedPayment = t.value;
        q<HTMLButtonElement>('#btn-confirm')!.disabled = false;
      }
    });
  }

  // ── Envoi commande ────────────────────────────
  async function submitOrder() {
    const btn = q<HTMLButtonElement>('#btn-confirm')!;
    btn.disabled = true;
    btn.innerHTML = '<span class="loading loading-spinner loading-sm"></span> Envoi…';

    try {
      const form     = q<HTMLFormElement>('#form-client')!;
      const data     = Object.fromEntries(new FormData(form));
      const subtotal = cart.reduce((s, i) => s + i.prix * i.quantite, 0);

      const order: Record<string, unknown> = {
        type: selectedMode,
        client: {
          nom:       data.nom,
          prenom:    data.prenom,
          email:     data.email,
          telephone: data.telephone,
        },
        articles:    cart,
        sous_total:  subtotal,
        notes:       data.notes ?? '',
        source:      'web',
      };

      if (selectedMode === 'livraison') {
        (order.client as Record<string,unknown>).adresse = {
          rue: data.rue, numero: data.numero,
          code_postal: data.code_postal, ville: data.ville,
        };
        order.frais_livraison = selectedZone?.frais ?? 0;
        order.zone_livraison  = selectedZone?.id;
        order.temps_estime    = selectedZone?.temps_estime;
      } else {
        order.frais_livraison = 0;
        if (selectedMode === 'emporter') order.heure_souhaitee = data.heure_souhaitee ?? null;
        if (selectedMode === 'sur_place') order.numero_table   = data.numero_table ?? null;
      }

      order.prix_total = subtotal + ((order.frais_livraison as number) ?? 0);
      order.paiement   = selectedPayment === 'en_ligne'
        ? { mode: 'en_ligne',      statut: 'en_attente_paiement' }
        : { mode: selectedPayment, statut: 'a_reception' };

      const res = await fetch(`${getApiBase()}/commandes`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(order),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error((err as any).error ?? `Erreur ${res.status}`);
      }

      const result = await res.json() as { id: string };
      localStorage.setItem('last_order', JSON.stringify(result));

      if (selectedPayment === 'en_ligne') {
        window.location.href = `/stripe-checkout?order=${result.id}`;
      } else {
        localStorage.removeItem('cart');
        window.dispatchEvent(new CustomEvent('cart-updated'));
        window.location.href = `/confirmation?order=${result.id}`;
      }

    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Erreur inconnue';
      showToast(`Erreur : ${msg}`, 'error');
      btn.disabled = false;
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Confirmer la commande';
    }
  }

  // ── Init ──────────────────────────────────────
  function init() {
    // Lire la config depuis le tag JSON injecté SSR
    const cfgEl = document.getElementById('checkout-config');
    try {
      cfg = JSON.parse(cfgEl?.textContent ?? '{}') as CheckoutConfig;
    } catch {
      cfg = { modes_service: {}, zones_livraison: [], methodes_paiement: {} };
    }

    // Charger le panier
    try { cart = JSON.parse(localStorage.getItem('cart') ?? '[]'); } catch { cart = []; }

    if (cart.length === 0) {
      showToast('Votre panier est vide', 'warning');
      setTimeout(() => { window.location.href = '/cart'; }, 1500);
      return;
    }

    updateSummary();
    renderModes();
    setupCodePostal();

    // Afficher le contenu
    document.getElementById('loading-screen')?.classList.add('hidden');
    document.getElementById('main-content')?.classList.remove('hidden');

    // ── Boutons navigation ──────────────────────
    q('#btn-next-1')?.addEventListener('click', () => {
      if (!selectedMode) { showToast('Veuillez choisir un mode de service', 'warning'); return; }
      setupStep2Fields();
      showStep(2);
    });

    q('#btn-back-2')?.addEventListener('click', () => showStep(1));

    q('#btn-next-2')?.addEventListener('click', () => {
      const form = q<HTMLFormElement>('#form-client')!;

      // Validation HTML5
      if (!form.checkValidity()) { form.reportValidity(); return; }

      // Validation heure
      if (selectedMode === 'emporter') {
        const val    = q<HTMLInputElement>('#inp-heure')!.value;
        const result = validateHeure(val);
        const helpEl = document.getElementById('heure-help')!;
        if (!result.ok) {
          helpEl.textContent = result.msg;
          helpEl.className   = 'label-text-alt text-error';
          q('#inp-heure')?.focus();
          return;
        }
        if (result.msg) {
          helpEl.textContent = result.msg;
          helpEl.className   = 'label-text-alt text-success';
        }
      }

      // Validation zone livraison
      if (selectedMode === 'livraison' && !selectedZone) {
        showToast('Code postal hors zone de livraison', 'error');
        q('#inp-cp')?.focus();
        return;
      }

      renderPaymentMethods();
      showStep(3);
    });

    q('#btn-back-3')?.addEventListener('click', () => showStep(2));
    q('#btn-confirm')?.addEventListener('click', () => void submitOrder());
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>