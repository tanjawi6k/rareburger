---
// src/components/CategorySelector.astro
// Reçoit les catégories en prop — zéro fetch autonome

import '../assets/app.css';

interface Category {
  id: string;
  name: string;
  icon?: string;
}

interface Props {
  categories?: Category[];
  selectedCategory?: string;
}

const {
  categories    = [],
  selectedCategory = 'all',
} = Astro.props;

const allCategories: Category[] = [
  { id: 'all', name: 'Tout', icon: '🍴' },
  ...categories,
];
---

<div class="w-full bg-base-100 border-b border-base-300">
  <div
    class="flex gap-2 overflow-x-auto py-3 px-4 scrollbar-hide snap-x snap-mandatory"
    id="category-scroll"
    role="tablist"
    aria-label="Catégories du menu"
  >
    {allCategories.map((cat) => (
      <button
        role="tab"
        data-category={cat.id}
        aria-selected={selectedCategory === cat.id ? 'true' : 'false'}
        class:list={[
          'category-btn btn btn-sm flex-shrink-0 snap-start',
          'flex flex-col items-center justify-center gap-1',
          'min-w-[80px] sm:min-w-[100px] lg:min-w-[120px]',
          'h-auto py-2 px-3',
          selectedCategory === cat.id ? 'btn-primary' : 'btn-ghost',
        ]}
      >
        {cat.icon && (
          <span class="text-2xl sm:text-3xl leading-none" aria-hidden="true">
            {cat.icon}
          </span>
        )}
        <span class="text-xs font-medium whitespace-nowrap leading-none">
          {cat.name}
        </span>
      </button>
    ))}
  </div>
</div>

<style>
  /* Scrollbar cachée */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  /* Bouton catégorie */
  .category-btn {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .category-btn:hover {
    transform: translateY(-2px);
  }

  /* Active : ombre DaisyUI-aware */
  .category-btn.btn-primary {
    box-shadow: 0 4px 12px oklch(var(--p) / 0.3);
  }

  /* Touch : pas de translateY, feedback scale */
  @media (hover: none) {
    .category-btn:hover { transform: none; }
    .category-btn:active { transform: scale(0.95); }
  }

  /* Drag-to-scroll curseur */
  #category-scroll.is-dragging { cursor: grabbing; }
</style>

<script>
  // ════════════════════════════════════════════
  //  CategorySelector
  //  - Sélection de catégorie → CustomEvent
  //  - Drag-to-scroll souris
  //  - PAS de restauration localStorage au load
  //    (le filtre initial est géré par le SSR)
  // ════════════════════════════════════════════

  function init() {
    const scroll  = document.getElementById('category-scroll');
    if (!scroll) return;

    const buttons = scroll.querySelectorAll<HTMLButtonElement>('.category-btn');

    // ── Sélection ──────────────────────────────
    buttons.forEach(btn => {
      // Éviter le double-bind (View Transitions)
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', () => {
        const categoryId = btn.dataset.category;
        if (!categoryId) return;

        // Mettre à jour les états visuels + aria
        buttons.forEach(b => {
          b.classList.replace('btn-primary', 'btn-ghost');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.replace('btn-ghost', 'btn-primary');
        btn.setAttribute('aria-selected', 'true');

        // Sauvegarder la sélection
        try { localStorage.setItem('selectedCategory', categoryId); } catch(_) {}

        // Émettre l'événement pour ProductGrid
        document.dispatchEvent(
          new CustomEvent('category-changed', {
            detail: { categoryId },
            bubbles: true,
          })
        );

        // Scroll pour centrer le bouton actif (mobile)
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
    });

    // ── Drag-to-scroll (souris uniquement) ─────
    let isDragging  = false;
    let startX      = 0;
    let scrollStart = 0;
    let didDrag     = false;

    scroll.addEventListener('mousedown', e => {
      isDragging  = true;
      didDrag     = false;
      startX      = e.pageX - scroll.offsetLeft;
      scrollStart = scroll.scrollLeft;
      scroll.classList.add('is-dragging');
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
      scroll.classList.remove('is-dragging');
    });

    scroll.addEventListener('mousemove', e => {
      if (!isDragging) return;
      e.preventDefault();
      const x    = e.pageX - scroll.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 4) didDrag = true;
      scroll.scrollLeft = scrollStart - walk;
    });

    // Annuler le click si c'était un drag
    scroll.addEventListener('click', e => {
      if (didDrag) {
        e.stopPropagation();
        didDrag = false;
      }
    }, true);
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>