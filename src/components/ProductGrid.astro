---
// src/components/ProductGrid.astro
import ProductCard from './ProductCard.astro';
import '../assets/app.css';

interface Produit {
  id: string;
  nom: string;
  description?: string;
  prix: number;
  category?: string;
  images?: string[];
  disponible: boolean;
  supplements?: string[];
  removable_ingredients?: string[];
  allergenes?: string[];
  choices?: any[];
}

interface Props {
  products: Produit[];
  category?: string;
  limit?: number;
  isOpen?: boolean;
  apiBaseUrl?: string;
  hasError?: boolean;
  telephone?: string;
}

const {
  products: allProducts = [],
  category   = 'all',
  limit,
  isOpen     = true,
  apiBaseUrl = 'http://127.0.0.1:5000/api',
  hasError   = false,
  telephone  = '',
} = Astro.props;

function resolveImageUrl(img: string, base: string): string {
  if (!img) return '';
  if (/^https?:\/\//.test(img) || img.startsWith('//')) return img;
  const baseRoot = base.replace(/\/api\/?$/, '').replace(/\/$/, '');
  const path     = img.startsWith('/') ? img : `/api/images/${img}`;
  return `${baseRoot}${path}`;
}

let products = [...allProducts];

if (category !== 'all') {
  products = products.filter(p =>
    p.category?.toLowerCase() === category.toLowerCase()
  );
}

if (limit) products = products.slice(0, limit);

products.sort((a, b) => {
  if (a.disponible === b.disponible) return 0;
  return a.disponible ? -1 : 1;
});
---

<section aria-label="Produits du menu">

  {hasError && (
    <div class="alert alert-warning mb-4 rounded-2xl" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <div class="min-w-0">
        <p class="font-bold text-sm">Commande en ligne temporairement indisponible</p>
        {telephone && (
          <p class="text-xs opacity-80">
            Appelez-nous au&nbsp;
            <a href={`tel:${telephone.replace(/\s/g, '')}`} class="link link-hover font-semibold">
              {telephone}
            </a>
          </p>
        )}
      </div>
    </div>
  )}

  {products.length > 0 ? (
    <div
      id="product-grid"
      class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5"
      data-category={category}
    >
      {products.map((product, idx) => {
        const resolvedImages = (product.images || []).map(img =>
          resolveImageUrl(img, apiBaseUrl)
        );
        return (
          <div
            class="product-grid-item"
            data-product-id={product.id}
            data-category={product.category || ''}
            data-available={String(product.disponible)}
            style={`animation-delay: ${Math.min(idx * 40, 400)}ms`}
          >
            <ProductCard
              id={product.id}
              nom={product.nom}
              description={product.description}
              prix={product.prix}
              category={product.category}
              image={resolvedImages[0]}
              images={resolvedImages}
              disponible={product.disponible}
              isOpen={isOpen}
              supplements={product.supplements || []}
              removable_ingredients={product.removable_ingredients || []}
              allergenes={product.allergenes || []}
              choices={product.choices || []}
            />
          </div>
        );
      })}
    </div>
  ) : (
    <div class="empty-state" id="empty-initial" role="status">
      <span class="text-5xl" aria-hidden="true">🍽️</span>
      <p class="font-bold text-lg mt-3">Aucun produit disponible</p>
      <p class="text-base-content/60 text-sm mt-1">
        {category !== 'all'
          ? 'Aucun produit dans cette catégorie'
          : 'Le menu est en cours de préparation'}
      </p>
    </div>
  )}

  <div class="empty-state hidden" id="empty-filtered" role="status" aria-live="polite">
    <span class="text-5xl" aria-hidden="true">🔍</span>
    <p class="font-bold text-lg mt-3">Aucun produit dans cette catégorie</p>
    <p class="text-base-content/60 text-sm mt-1">Essayez une autre catégorie</p>
  </div>

</section>

<style>
  .product-grid-item {
    opacity: 0;
    transform: translateY(12px);
    animation: grid-item-in 0.3s ease-out forwards;
  }
  @keyframes grid-item-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .product-grid-item[data-hidden] { display: none; }
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    text-align: center;
  }
  .empty-state.hidden { display: none; }
  @media (max-width: 640px)  { #product-grid { gap: 0.75rem; } }
  @media (min-width: 1024px) { #product-grid { gap: 1.5rem; } }
</style>

<script>
  function filterProducts(categoryId: string) {
    const grid   = document.getElementById('product-grid');
    const emptyF = document.getElementById('empty-filtered');
    const emptyI = document.getElementById('empty-initial');
    if (!grid) return;

    const items = grid.querySelectorAll<HTMLElement>('.product-grid-item');
    let visible = 0;

    items.forEach(item => {
      const match =
        categoryId === 'all' ||
        item.dataset.category?.toLowerCase() === categoryId.toLowerCase();

      if (match) {
        item.removeAttribute('data-hidden');
        visible++;
      } else {
        // Délai 100ms avant masquage pour éviter NS_BINDING_ABORTED sur les images
        setTimeout(() => item.setAttribute('data-hidden', ''), 100);
      }
    });

    const noProducts = items.length === 0;
    emptyI?.classList.toggle('hidden', !noProducts);
    emptyF?.classList.toggle('hidden', noProducts || visible > 0);
  }

  let controller: AbortController | null = null;

  function setup() {
    controller?.abort();
    controller = new AbortController();
    document.addEventListener(
      'category-changed',
      (e: Event) => filterProducts((e as CustomEvent).detail.categoryId),
      { signal: controller.signal }
    );
  }

  document.addEventListener('astro:page-load', setup);
  setup();
</script>