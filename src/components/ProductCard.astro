---
// src/components/ProductCard.astro
import '../assets/app.css';

interface Choice {
  id: string;
  label: string;
  required: boolean;
  options: { id: string; name: string; price_modifier: number }[];
}

interface Props {
  id: string;
  nom: string;
  description?: string;
  prix: number;
  category?: string;
  image?: string;
  images?: string[];
  disponible?: boolean;
  isOpen?: boolean;
  supplements?: string[];
  allergenes?: string[];
  removable_ingredients?: string[];
  choices?: Choice[];
}

const {
  id,
  nom,
  description           = '',
  prix,
  category              = '',
  image,
  images                = [],
  disponible            = true,
  isOpen                = true,
  supplements           = [],
  allergenes            = [],
  removable_ingredients = [],
  choices               = [],
} = Astro.props;

const allImages = images.length > 0 ? images : (image ? [image] : []);
const mainImage = allImages[0] || null;

const ctaDisabled = !disponible || !isOpen;
const ctaLabel    = !disponible ? 'Victime de son succès' : !isOpen ? 'Restaurant fermé' : 'Commander';

const formatPrice = (p: number) =>
  new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(p);

// Données produit — sérialisées dans un <script type="application/json">
// pour éviter tout problème d'encodage dans les attributs HTML
const productData = JSON.stringify({
  id, nom, description, prix, category,
  images: allImages, disponible,
  supplements, removable_ingredients, allergenes, choices,
});
---

<article
  class="card bg-base-100 shadow-sm card-product"
  data-product-id={id}
  data-category={category}
  data-available={String(disponible)}
  aria-label={nom}
>
  <!-- Données produit en JSON pur — pas d'attribut HTML = zéro encodage -->
  <script type="application/json" class="product-data" set:html={productData} />

  <!-- Image -->
  <figure class="relative overflow-hidden rounded-t-2xl bg-base-200 aspect-[4/3]">
    {mainImage ? (
      <img
        src={mainImage}
        alt={nom}
        class="w-full h-full object-cover transition-transform duration-300 card-img"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div
        class="w-full h-full flex items-center justify-center text-5xl text-base-content/20"
        aria-hidden="true"
      >
        🍽️
      </div>
    )}

    {!disponible && (
      <div
        class="absolute inset-0 bg-base-300/60 flex items-center justify-center"
        aria-hidden="true"
      >
        <span class="badge badge-error badge-lg font-semibold">Épuisé</span>
      </div>
    )}
  </figure>

  <!-- Corps -->
  <div class="card-body p-4 gap-2">

    <div class="flex items-start justify-between gap-2">
      <h2 class="card-title text-base leading-snug flex-1 line-clamp-2">{nom}</h2>
      <span class="text-base font-bold text-primary shrink-0 tabular-nums">
        {formatPrice(prix)}
      </span>
    </div>

    {description && (
      <p class="text-sm text-base-content/60 line-clamp-2 leading-relaxed">
        {description}
      </p>
    )}

    {allergenes.length > 0 && (
      <div class="flex flex-wrap gap-1">
        {allergenes.map(a => (
          <span class="badge badge-warning badge-xs">⚠️ {a}</span>
        ))}
      </div>
    )}

    <div class="card-actions mt-auto pt-1">
      {ctaDisabled ? (
        <button
          class="btn btn-sm btn-block btn-disabled"
          disabled
          aria-disabled="true"
        >
          {ctaLabel}
        </button>
      ) : (
        <button
          class="btn btn-sm btn-block btn-primary btn-open-modal"
          aria-label={`Voir les détails de ${nom}`}
        >
          {ctaLabel}
        </button>
      )}
    </div>

  </div>
</article>

<style>
  .card-product {
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    border-radius: 1rem;
  }
  .card-product:hover {
    box-shadow: 0 8px 24px oklch(var(--bc) / 0.12);
    transform: translateY(-2px);
  }
  .card-product:hover .card-img {
    transform: scale(1.04);
  }
  .card-product:has([data-available="false"]) .card-body {
    opacity: 0.7;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (hover: none) {
    .card-product:hover { transform: none; box-shadow: none; }
    .card-product:hover .card-img { transform: none; }
    .card-product:active { transform: scale(0.98); transition-duration: 0.1s; }
  }
</style>

<script>
  function bindCards() {
    document.querySelectorAll<HTMLElement>('.btn-open-modal').forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', () => {
        // Lire le JSON depuis le <script type="application/json"> voisin
        const card       = btn.closest('article');
        const scriptTag  = card?.querySelector<HTMLScriptElement>('script.product-data');
        if (!scriptTag) return;

        let product: any;
        try {
          product = JSON.parse(scriptTag.textContent || '{}');
        } catch (e) {
          console.error('ProductCard: JSON invalide', e, scriptTag.textContent?.slice(0, 100));
          return;
        }

        document.dispatchEvent(
          new CustomEvent('open-product-modal', { detail: product, bubbles: true })
        );
      });
    });
  }

  document.addEventListener('astro:page-load', bindCards);
  bindCards();
</script>