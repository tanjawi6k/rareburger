---
// src/components/ProductModal.astro
// Modal produit — DaisyUI-native, thème-compatible, zéro define:vars
import '../assets/app.css';

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<dialog
  id={`modal-${id}`}
  class="modal modal-bottom sm:modal-middle"
  aria-modal="true"
  data-modal-id={id}
>
  <div class="modal-box p-0 overflow-hidden max-w-lg w-full">

    <!-- Bouton fermer -->
    <form method="dialog">
      <button
        class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 z-20 bg-base-100/80 backdrop-blur-sm"
        aria-label="Fermer"
      >✕</button>
    </form>

    <!-- Zone image (hauteur fixe, image en cover) -->
    <div
      id={`modal-img-${id}`}
      class="modal-img-zone w-full bg-base-200 relative overflow-hidden"
      style="height: 220px;"
    >
      <!-- Placeholder affiché avant le chargement -->
      <div class="absolute inset-0 flex items-center justify-center text-6xl text-base-content/10 select-none">
        🍽️
      </div>
    </div>

    <!-- Corps scrollable -->
    <div
      id={`modal-body-${id}`}
      class="modal-body-scroll p-5 overflow-y-auto"
      style="max-height: calc(100dvh - 280px); max-height: calc(100vh - 280px);"
    >
      <!-- Spinner initial -->
      <div class="flex justify-center py-10">
        <span class="loading loading-spinner loading-lg text-primary"></span>
      </div>
    </div>

  </div>

  <!-- Backdrop cliquable pour fermer -->
  <form method="dialog" class="modal-backdrop">
    <button>fermer</button>
  </form>
</dialog>

<!-- Toast de validation (positionné en haut de l'écran) -->
<div id={`modal-toast-${id}`} class="modal-toast-zone" aria-live="assertive"></div>

<style>
  /* ── Animation d'entrée ────────────────────── */
  .modal[open] .modal-box {
    animation: modal-pop 0.22s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  @keyframes modal-pop {
    from { opacity: 0; transform: scale(0.96) translateY(6px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
  }

  /* ── Image zone ─────────────────────────────── */
  .modal-img-zone img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Dots carousel ──────────────────────────── */
  .carousel-dots {
    position: absolute;
    bottom: 8px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    z-index: 10;
  }
  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    border: none;
    background: oklch(var(--bc) / 0.3);
    cursor: pointer;
    padding: 0;
    transition: width 0.2s, background 0.2s;
  }
  .carousel-dot.active {
    width: 18px;
    background: oklch(var(--p));
  }

  /* ── Corps scrollable ───────────────────────── */
  .modal-body-scroll {
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: oklch(var(--bc) / 0.15) transparent;
  }
  .modal-body-scroll::-webkit-scrollbar { width: 4px; }
  .modal-body-scroll::-webkit-scrollbar-thumb {
    background: oklch(var(--bc) / 0.15);
    border-radius: 99px;
  }

  /* ── Lignes option ──────────────────────────── */
  .opt-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.5rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.1s;
  }
  .opt-row:hover  { background: oklch(var(--b2)); }
  .opt-row:active { background: oklch(var(--b3)); }

  /* ── Toast zone ─────────────────────────────── */
  .modal-toast-zone {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 260px;
  }

  /* ── Touch targets ──────────────────────────── */
  @media (pointer: coarse) {
    .opt-row { min-height: 44px; }
    .modal-body-scroll button { min-height: 44px; }
  }

  /* ── Mobile bottom sheet ────────────────────── */
  @media (max-width: 640px) {
    .modal-box { border-radius: 1rem 1rem 0 0 !important; }
  }
</style>

<!--
  Script standard (PAS define:vars, PAS is:inline)
  → Astro le bundle en TypeScript, dédupliqué.
  L'ID du modal est lu depuis data-modal-id sur le <dialog>.
-->
<script>
  // Récupère tous les modaux de la page et les initialise
  function initModals() {
    document.querySelectorAll<HTMLDialogElement>('dialog[data-modal-id]').forEach(modal => {
      // Éviter le double-init
      if (modal.dataset.initialized) return;
      modal.dataset.initialized = '1';

      const MODAL_ID  = modal.dataset.modalId!;
      const imgZone   = document.getElementById(`modal-img-${MODAL_ID}`)!;
      const body      = document.getElementById(`modal-body-${MODAL_ID}`)!;
      const toastZone = document.getElementById(`modal-toast-${MODAL_ID}`)!;

      let currentProduct: Record<string, any> | null = null;
      let currentImages: string[] = [];
      let currentImgIdx = 0;

      // ── Toast ───────────────────────────────────
      function toast(msg: string, type: 'warning' | 'error' | 'success' = 'warning') {
        if (!toastZone) return;
        const el = document.createElement('div');
        el.className = `alert alert-${type} shadow-lg pointer-events-auto text-sm py-2 px-4 rounded-xl`;
        el.textContent = msg;
        toastZone.appendChild(el);
        setTimeout(() => el.remove(), 3500);
      }

      // ── Image zone ──────────────────────────────
      function renderImages(images: string[], nom: string) {
        imgZone.innerHTML = '';

        if (!images.length) {
          imgZone.innerHTML = '<div class="absolute inset-0 flex items-center justify-center text-6xl text-base-content/10">🍽️</div>';
          return;
        }

        currentImages = images;
        currentImgIdx = 0;

        // Image principale
        const img = document.createElement('img');
        img.src     = images[0];
        img.alt     = nom;
        img.loading = 'lazy';
        img.decoding = 'async';
        imgZone.appendChild(img);

        if (images.length > 1) {
          // Dots
          const dots = document.createElement('div');
          dots.className = 'carousel-dots';

          images.forEach((src, i) => {
            const dot = document.createElement('button');
            dot.className = `carousel-dot${i === 0 ? ' active' : ''}`;
            dot.setAttribute('aria-label', `Image ${i + 1}`);
            dot.addEventListener('click', () => {
              img.src = images[i];
              currentImgIdx = i;
              dots.querySelectorAll('.carousel-dot').forEach((d, j) => {
                d.classList.toggle('active', j === i);
              });
            });
            dots.appendChild(dot);
          });

          imgZone.appendChild(dots);
        }
      }

      // ── Calcul prix ─────────────────────────────
      function unitPrice(): number {
        if (!currentProduct) return 0;
        let p = currentProduct.prix as number;
        body.querySelectorAll<HTMLInputElement>('.choice-radio:checked').forEach(r => {
          p += parseFloat(r.dataset.priceModifier ?? '0');
        });
        body.querySelectorAll<HTMLInputElement>('.supp-cb:checked').forEach(c => {
          p += parseFloat(c.dataset.price ?? '0');
        });
        return p;
      }

      function refreshPrice() {
        const qty   = parseInt(body.querySelector<HTMLInputElement>('.qty-input')?.value ?? '1');
        const total = unitPrice() * qty;
        const el    = body.querySelector<HTMLElement>('.price-display');
        if (el) {
          el.textContent = new Intl.NumberFormat('fr-BE', {
            style: 'currency', currency: 'EUR',
          }).format(total);
        }
      }

      // ── Rendu corps ─────────────────────────────
      function renderBody(p: Record<string, any>) {
        const prix = new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR' }).format(p.prix as number);

        // Construire le DOM proprement — pas de innerHTML avec template literals complexes
        body.innerHTML = '';

        // Titre + prix
        const header = document.createElement('div');
        header.className = 'flex items-start justify-between gap-3 mb-3';
        header.innerHTML = `
          <div class="flex-1 min-w-0">
            <h3 class="text-xl font-bold leading-tight text-base-content">${escHtml(p.nom)}</h3>
            ${p.description ? `<p class="text-sm text-base-content/60 mt-1 leading-relaxed">${escHtml(p.description)}</p>` : ''}
          </div>
          <span class="text-lg font-bold text-primary shrink-0 tabular-nums">${prix}</span>
        `;
        body.appendChild(header);

        // Allergènes
        const allergenes = (p.allergenes as string[]) ?? [];
        if (allergenes.length) {
          const row = document.createElement('div');
          row.className = 'flex flex-wrap gap-1 mb-3';
          allergenes.forEach(a => {
            const badge = document.createElement('span');
            badge.className = 'badge badge-warning badge-sm';
            badge.textContent = `⚠️ ${a}`;
            row.appendChild(badge);
          });
          body.appendChild(row);
        }

        // Séparateur
        const divider = () => { const d = document.createElement('div'); d.className = 'divider my-2'; body.appendChild(d); };

        // Choix obligatoires
        const choices = (p.choices as any[]) ?? [];
        if (choices.length) {
          divider();
          choices.forEach(choice => {
            const wrap = document.createElement('div');
            wrap.className = 'mb-3';

            const label = document.createElement('p');
            label.className = 'font-semibold text-sm mb-2';
            label.innerHTML = `${escHtml(choice.label)}${choice.required ? ' <span class="text-error">*</span>' : ''}`;
            wrap.appendChild(label);

            const group = document.createElement('div');
            group.className = 'space-y-1';
            group.dataset.choiceGroup = choice.id;
            group.dataset.required    = String(choice.required);

            choice.options.forEach((opt: any) => {
              const lbl = document.createElement('label');
              lbl.className = 'opt-row';
              const left = document.createElement('div');
              left.className = 'flex items-center gap-2 min-w-0';

              const radio = document.createElement('input');
              radio.type      = 'radio';
              radio.name      = `choice-${MODAL_ID}-${choice.id}`;
              radio.className = 'radio radio-primary radio-sm choice-radio shrink-0';
              radio.dataset.choiceId      = choice.id;
              radio.dataset.optionId      = opt.id;
              radio.dataset.optionName    = opt.name;
              radio.dataset.priceModifier = String(opt.price_modifier);
              radio.addEventListener('change', refreshPrice);

              const span = document.createElement('span');
              span.className   = 'text-sm truncate';
              span.textContent = opt.name;

              left.appendChild(radio);
              left.appendChild(span);
              lbl.appendChild(left);

              if (opt.price_modifier !== 0) {
                const badge = document.createElement('span');
                badge.className   = 'badge badge-ghost badge-sm shrink-0';
                badge.textContent = `${opt.price_modifier > 0 ? '+' : ''}${opt.price_modifier.toFixed(2)}€`;
                lbl.appendChild(badge);
              }

              group.appendChild(lbl);
            });

            wrap.appendChild(group);
            body.appendChild(wrap);
          });
        }

        // Ingrédients retirables
        const removable = (p.removable_ingredients as string[]) ?? [];
        if (removable.length) {
          divider();
          const title = document.createElement('p');
          title.className = 'font-semibold text-sm mb-2';
          title.innerHTML = 'Retirer des ingrédients <span class="font-normal text-base-content/50">(gratuit)</span>';
          body.appendChild(title);
          const list = document.createElement('div');
          list.className = 'space-y-1';
          removable.forEach(ing => {
            const lbl = document.createElement('label');
            lbl.className = 'opt-row';
            const left = document.createElement('div');
            left.className = 'flex items-center gap-2';
            const cb = document.createElement('input');
            cb.type      = 'checkbox';
            cb.className = 'checkbox checkbox-sm removable-cb';
            cb.dataset.ingredient = ing;
            const span = document.createElement('span');
            span.className   = 'text-sm line-through decoration-error/70 decoration-2';
            span.textContent = ing;
            left.appendChild(cb);
            left.appendChild(span);
            lbl.appendChild(left);
            list.appendChild(lbl);
          });
          body.appendChild(list);
        }

        // Suppléments
        const allSupps: any[] = (window as any).allSupplements ?? [];
        const suppIds = (p.supplements as string[]) ?? [];
        const resolved = suppIds.map(sid => allSupps.find(s => s.id === sid)).filter(Boolean);
        if (resolved.length) {
          divider();
          const title = document.createElement('p');
          title.className   = 'font-semibold text-sm mb-2';
          title.textContent = 'Suppléments';
          body.appendChild(title);
          const list = document.createElement('div');
          list.className = 'space-y-1';
          resolved.forEach(supp => {
            const lbl = document.createElement('label');
            lbl.className = 'opt-row';
            const left = document.createElement('div');
            left.className = 'flex items-center gap-2';
            const cb = document.createElement('input');
            cb.type      = 'checkbox';
            cb.className = 'checkbox checkbox-primary checkbox-sm supp-cb';
            cb.dataset.suppId = supp.id;
            cb.dataset.name   = supp.name;
            cb.dataset.price  = String(supp.price);
            cb.addEventListener('change', refreshPrice);
            const span = document.createElement('span');
            span.className   = 'text-sm';
            span.textContent = supp.name;
            left.appendChild(cb);
            left.appendChild(span);
            lbl.appendChild(left);
            const badge = document.createElement('span');
            badge.className   = 'badge badge-ghost badge-sm shrink-0';
            badge.textContent = `+${supp.price.toFixed(2)}€`;
            lbl.appendChild(badge);
            list.appendChild(lbl);
          });
          body.appendChild(list);
        }

        divider();

        // Quantité + prix total
        const qtyRow = document.createElement('div');
        qtyRow.className = 'flex items-center justify-between gap-4 mb-4';
        qtyRow.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="font-semibold text-sm text-base-content">Quantité</span>
            <div class="join">
              <button type="button" class="btn btn-sm join-item btn-qty" data-delta="-1" aria-label="Diminuer">−</button>
              <input
                type="number"
                class="input input-sm input-bordered join-item w-14 text-center qty-input"
                value="1" min="1" max="99"
                aria-label="Quantité"
              />
              <button type="button" class="btn btn-sm join-item btn-qty" data-delta="1" aria-label="Augmenter">+</button>
            </div>
          </div>
          <div class="text-right">
            <p class="text-xs text-base-content/50 mb-0.5">Total</p>
            <p class="text-2xl font-bold text-primary price-display">${prix}</p>
          </div>
        `;
        body.appendChild(qtyRow);

        // Bouton CTA
        const cta = document.createElement('button');
        cta.type      = 'button';
        cta.className = 'btn btn-primary btn-block gap-2';
        cta.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          Ajouter au panier
        `;
        cta.addEventListener('click', handleAddToCart);
        body.appendChild(cta);

        // Events quantité
        body.querySelectorAll<HTMLButtonElement>('.btn-qty').forEach(btn => {
          btn.addEventListener('click', () => {
            const input = body.querySelector<HTMLInputElement>('.qty-input')!;
            input.value = String(Math.max(1, (parseInt(input.value) || 1) + parseInt(btn.dataset.delta ?? '0')));
            refreshPrice();
          });
        });
        body.querySelector('.qty-input')?.addEventListener('input', refreshPrice);

        body.scrollTop = 0;
      }

      // ── Ajout panier ────────────────────────────
      function handleAddToCart() {
        if (!currentProduct) return;

        // Valider choix obligatoires
        const groups = body.querySelectorAll<HTMLElement>('[data-choice-group][data-required="true"]');
        for (const group of groups) {
          const cid     = group.dataset.choiceGroup!;
          const checked = group.querySelector(`input[name="choice-${MODAL_ID}-${cid}"]:checked`);
          if (!checked) {
            const labelText = group.closest('div')?.querySelector('p')?.textContent?.replace('*','').trim() ?? 'un choix';
            toast(`Veuillez choisir : ${labelText}`, 'warning');
            group.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }
        }

        const qty = Math.max(1, parseInt(body.querySelector<HTMLInputElement>('.qty-input')?.value ?? '1'));

        const selectedChoices: any[] = [];
        body.querySelectorAll<HTMLInputElement>('.choice-radio:checked').forEach(r => {
          selectedChoices.push({
            choice_id:      r.dataset.choiceId,
            option_id:      r.dataset.optionId,
            option_name:    r.dataset.optionName,
            price_modifier: parseFloat(r.dataset.priceModifier ?? '0'),
          });
        });

        const selectedSupps: any[] = [];
        body.querySelectorAll<HTMLInputElement>('.supp-cb:checked').forEach(c => {
          selectedSupps.push({ id: c.dataset.suppId, name: c.dataset.name, price: parseFloat(c.dataset.price ?? '0') });
        });

        const removedIngr: string[] = [];
        body.querySelectorAll<HTMLInputElement>('.removable-cb:checked').forEach(c => {
          if (c.dataset.ingredient) removedIngr.push(c.dataset.ingredient);
        });

        const article = {
          id:                  currentProduct.id,
          nom:                 currentProduct.nom,
          prix:                unitPrice(),
          quantite:            qty,
          choices_selected:    selectedChoices,
          supplements:         selectedSupps,
          removed_ingredients: removedIngr,
        };

        let cart: any[] = [];
        try { cart = JSON.parse(localStorage.getItem('cart') ?? '[]'); } catch {}

        const sig = (i: any) => JSON.stringify([i.id, i.choices_selected, i.supplements.map((s: any) => s.id), i.removed_ingredients]);
        const idx = cart.findIndex(i => sig(i) === sig(article));
        if (idx >= 0) { cart[idx].quantite += qty; } else { cart.push(article); }

        localStorage.setItem('cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cart-updated'));
        modal.close();
      }

      // ── Helpers ──────────────────────────────────
      function escHtml(str: string): string {
        return String(str ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // ── Écoute événement d'ouverture ─────────────
      document.addEventListener('open-product-modal', (e) => {
        const product = (e as CustomEvent).detail as Record<string, any>;
        currentProduct = product;
        renderImages((product.images as string[]) ?? [], product.nom as string);
        renderBody(product);
        modal.showModal();
      });

      // Reset à la fermeture
      modal.addEventListener('close', () => {
        currentProduct = null;
        currentImages  = [];
        currentImgIdx  = 0;
        imgZone.innerHTML = '<div class="absolute inset-0 flex items-center justify-center text-6xl text-base-content/10 select-none">🍽️</div>';
        body.innerHTML    = '<div class="flex justify-center py-10"><span class="loading loading-spinner loading-lg text-primary"></span></div>';
      });
    });
  }

  document.addEventListener('astro:page-load', initModals);
  initModals();
</script>